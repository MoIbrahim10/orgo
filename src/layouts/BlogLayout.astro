---
import Layout from "./Layout.astro";
import type { Language } from "../types/translations";
import type { LocalePathMap } from "../utils/routing";

interface Props {
	lang: Language;
	metaTitle: string;
	metaDescription: string;
	ogImage?: string;
	canonicalUrl?: string;
	localeAlternates?: LocalePathMap;
	localeSwitcherPaths?: LocalePathMap;
	rssFeedTitle?: string;
	rssFeedUrl?: string;
	structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
	lang,
	metaTitle,
	metaDescription,
	ogImage,
	canonicalUrl,
	localeAlternates,
	localeSwitcherPaths,
	rssFeedTitle,
	rssFeedUrl,
	structuredData,
} = Astro.props as Props;
const defaultStructuredData = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: metaTitle,
	description: metaDescription,
	...(ogImage ? { image: [ogImage] } : {}),
};
---

<Layout
	canonicalUrl={canonicalUrl}
	lang={lang}
	localeAlternates={localeAlternates}
	localeSwitcherPaths={localeSwitcherPaths}
	ogImage={ogImage}
	pageDescription={metaDescription}
	pageTitle={metaTitle}
	rssFeedTitle={rssFeedTitle}
	rssFeedUrl={rssFeedUrl}
	structuredData={structuredData ?? defaultStructuredData}
>
	<slot />
</Layout>
