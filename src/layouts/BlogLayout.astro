---
import type { LayoutMetadataProps } from "../utils/metadata";
import Layout from "./Layout.astro";

interface Props extends LayoutMetadataProps {
	hideFooter?: boolean;
	hideHeader?: boolean;
}

const props = Astro.props as Props;
---

<Layout {...props} bodyClass="blog-layout-body" mainClass="blog-layout-main">
	<slot />
</Layout>

<style is:global>
	body.blog-layout-body {
		--blog-page-inline: clamp(1rem, 5vw, 3.25rem);
		--blog-page-max: var(--layout-width-navbar);
		--blog-page-max-shell: calc(var(--layout-width-navbar) + 6.5rem);

		padding-block: var(--page-shell-padding);
		padding-inline: 0;
	}

	body.blog-layout-body .site-header,
	body.blog-layout-body .site-footer {
		padding-inline: var(--page-shell-padding);
	}

	body.blog-layout-body [data-orgo-locale-suggestion] {
		margin-inline: var(--page-shell-padding);
	}

	.blog-layout-main {
		background: var(--page-bg);
		overflow: clip;
	}

	@media (max-width: 640px) {
		body.blog-layout-body .site-header,
		body.blog-layout-body .site-footer {
			padding-inline: clamp(0.75rem, 4vw, var(--page-shell-padding));
		}
	}
</style>
