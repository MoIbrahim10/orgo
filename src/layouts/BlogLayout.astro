---
import Layout from "./Layout.astro";
import type { Language } from "../types/translations";

interface Props {
	lang: Language;
	metaTitle: string;
	metaDescription: string;
	ogImage?: string;
	canonicalUrl?: string;
}

const { lang, metaTitle, metaDescription, ogImage, canonicalUrl } = Astro.props as Props;
const structuredData = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: metaTitle,
	description: metaDescription,
	image: ogImage,
};
---

<Layout
	canonicalUrl={canonicalUrl}
	lang={lang}
	ogImage={ogImage}
	pageDescription={metaDescription}
	pageTitle={metaTitle}
	structuredData={structuredData}
>
	<slot />
</Layout>
