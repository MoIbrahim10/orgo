---
import "../styles/global.css";

import AnalyticsScripts from "../components/common/AnalyticsScripts.astro";
import HomeRevealSectionsScript from "../components/common/HomeRevealSectionsScript.astro";
import LayoutHead from "../components/common/LayoutHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/header.astro";
import MobileStickyNav from "../components/MobileStickyNav.astro";
import LocaleSuggestionBanner from "../components/LocaleSuggestionBanner.astro";
import { getHtmlLanguage, getLocaleConfig } from "../data/site";
import { themeMetaColors, themeStorageKey } from "../data/theme";
import type { LayoutMetadataProps } from "../utils/metadata";
import { resolveLayoutChrome } from "../utils/layout";

interface Props extends LayoutMetadataProps {
	hideHeader?: boolean;
	hideFooter?: boolean;
}

const {
	lang,
	pageTitle,
	pageDescription,
	canonicalUrl,
	ogImage,
	rssFeedTitle,
	rssFeedUrl,
	noIndex = false,
	openGraphType,
	localeAlternates,
	localeSwitcherPaths,
	showLocaleSuggestion,
	structuredData,
	paginationPrevUrl,
	paginationNextUrl,
	hideHeader = false,
	hideFooter = false,
} = Astro.props as Props;

const localeConfig = getLocaleConfig(lang);
const { resolvedLocaleAlternates, resolvedLocaleSwitcherPaths, showLocaleSuggestion: shouldShowLocaleSuggestion } =
	resolveLayoutChrome({
		lang,
		localeAlternates,
		localeSwitcherPaths,
		pathname: Astro.url.pathname,
		showLocaleSuggestion,
	});
const headProps = {
	canonicalUrl,
	lang,
	localeAlternates,
	noIndex,
	ogImage,
	openGraphType,
	pageDescription,
	pageTitle,
	paginationNextUrl,
	paginationPrevUrl,
	rssFeedTitle,
	rssFeedUrl,
	structuredData,
};
---

<!doctype html>
<html
	data-theme-color-dark={themeMetaColors.dark}
	data-theme-color-light={themeMetaColors.light}
	data-theme-storage-key={themeStorageKey}
	dir={localeConfig.dir}
	lang={getHtmlLanguage(lang)}
>
	<LayoutHead {...headProps} localeBodyClass={localeConfig.bodyClass} />
	<body class={`min-h-screen antialiased ${localeConfig.bodyClass}`}>
		<a
			class="sr-only absolute left-4 top-4 z-50 rounded-full bg-slate-950 px-4 py-2 text-sm font-medium text-white focus:not-sr-only"
			href="#main-content"
		>
			Skip to content
		</a>
		{shouldShowLocaleSuggestion && !hideHeader && (
			<LocaleSuggestionBanner lang={lang} paths={resolvedLocaleAlternates} />
		)}
		{!hideHeader && <Header lang={lang} localeSwitcherPaths={resolvedLocaleSwitcherPaths} />}
		{!hideHeader && <MobileStickyNav lang={lang} localeSwitcherPaths={resolvedLocaleSwitcherPaths} />}
		<main class="min-h-[calc(100vh-137px)]" id="main-content">
			<slot />
		</main>
		{!hideFooter && <Footer lang={lang} />}
		<AnalyticsScripts />
		<HomeRevealSectionsScript />
	</body>
</html>
