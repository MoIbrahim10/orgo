---
import { getCollection } from "astro:content";
import FaqAccordion from "../../components/faq/FaqAccordion.astro";
import ActionLink from "../../components/ui/ActionLink.astro";
import PageSection from "../../components/ui/PageSection.astro";
import SectionIntro from "../../components/ui/SectionIntro.astro";
import { getResourcePagesContent } from "../../data/translations/resources";
import Layout from "../../layouts/Layout.astro";
import { createMarketingMetadata } from "../../utils/metadata";
import { getFaqCategorySummaries, getLocalizedFaqEntries } from "../../utils/marketingContent";
import { getLanguageFromParams, getLocaleStaticPaths } from "../../utils/routing";

export function getStaticPaths() {
	return getLocaleStaticPaths();
}

const lang = getLanguageFromParams(Astro.params.lang);
const pageContent = getResourcePagesContent(lang).faq;
const allFaqEntries = await getCollection("faq");
const faqEntries = getLocalizedFaqEntries(allFaqEntries, lang);
const categorySummaries = getFaqCategorySummaries(allFaqEntries, lang);
const faqStructuredData = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: faqEntries.map((entry) => ({
		"@type": "Question",
		name: entry.data.question,
		acceptedAnswer: {
			"@type": "Answer",
			text: entry.data.answer,
		},
	})),
};
const metadata = createMarketingMetadata(lang, {
	description: pageContent.description,
	structuredData: faqStructuredData,
	title: pageContent.metaTitle,
});
---

<Layout {...metadata}>
	<PageSection backdrop="glow" tone="warm">
		<SectionIntro
			description={pageContent.intro}
			title={pageContent.title}
			titleTag="h1"
		/>
	</PageSection>

	<PageSection layout="split" surface="panel">
		<div>
			<FaqAccordion items={faqEntries} />
		</div>
		<div slot="aside" class="space-y-5">
			<div class="rounded-[1.75rem] border border-slate-200 bg-slate-50 p-6">
				<h2 class="font-display text-2xl font-semibold tracking-tight text-slate-950">
					{pageContent.sidebarTitle}
				</h2>
				<p class="mt-4 text-base leading-7 text-slate-600">{pageContent.sidebarDescription}</p>
				<div class="mt-6 flex flex-wrap gap-3">
					<ActionLink href={pageContent.primaryHref} size="sm" variant="primary">
						{pageContent.primaryLabel}
					</ActionLink>
					<ActionLink href={pageContent.secondaryHref} size="sm" variant="secondary">
						{pageContent.secondaryLabel}
					</ActionLink>
				</div>
			</div>
			<div class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-[0_18px_50px_rgba(15,23,42,0.05)]">
				<p class="text-xs font-medium uppercase tracking-[0.18em] text-slate-500">
					{lang === "ar" ? "الموضوعات" : "Categories"}
				</p>
				<ul class="mt-4 grid gap-3">
					{categorySummaries.map((category) => (
						<li class="flex items-center justify-between rounded-2xl bg-slate-50 px-4 py-3 text-sm text-slate-700">
							<span>{category.label}</span>
							<span class="rounded-full bg-white px-2 py-0.5 text-xs text-slate-500">
								{category.count}
							</span>
						</li>
					))}
				</ul>
			</div>
		</div>
	</PageSection>
</Layout>
