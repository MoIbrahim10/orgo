---
import Layout from "../../layouts/Layout.astro";
import { getSiteTranslations } from "../../data/translations/site";
import { t } from "../../utils/i18n";
import { getLanguageFromParams, getLocaleStaticPaths } from "../../utils/routing";

const lang = getLanguageFromParams(Astro.params.lang);
const siteTranslations = getSiteTranslations(lang);

export function getStaticPaths() {
	return getLocaleStaticPaths();
}
---

<Layout
	lang={lang}
	pageDescription={t(lang, "pages.about.description")}
	pageTitle={`${t(lang, "pages.about.meta_title")} | ${siteTranslations.title}`}
>
	<section class="mx-auto max-w-4xl space-y-6 px-6 py-16">
		<h1 class="text-4xl font-bold tracking-tight text-slate-950">{t(lang, "pages.about.title")}</h1>
		<p class="text-lg leading-8 text-slate-600">{t(lang, "pages.about.intro")}</p>
		<p class="leading-7 text-slate-600">{t(lang, "pages.about.body")}</p>
	</section>
</Layout>
