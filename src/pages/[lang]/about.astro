---
import ActionLink from "../../components/ui/ActionLink.astro";
import Container from "../../components/ui/Container.astro";
import SectionIntro from "../../components/ui/SectionIntro.astro";
import Layout from "../../layouts/Layout.astro";
import { t } from "../../utils/i18n";
import { createMarketingMetadata } from "../../utils/metadata";
import {
	getLanguageFromParams,
	getLocalizedPath,
	getLocaleStaticPaths,
} from "../../utils/routing";

const lang = getLanguageFromParams(Astro.params.lang);
const contactHref = getLocalizedPath(lang, "/contact");
const blogHref = getLocalizedPath(lang, "/blog");
const metadata = createMarketingMetadata(lang, {
	description: t(lang, "pages.about.description"),
	title: t(lang, "pages.about.meta_title"),
});

export function getStaticPaths() {
	return getLocaleStaticPaths();
}
---

<Layout {...metadata}>
	<section class="py-16">
			<Container size="narrow">
				<SectionIntro
					description={t(lang, "pages.about.intro")}
					title={t(lang, "pages.about.title")}
					titleTag="h1"
				/>
				<p class="leading-7 text-slate-600">{t(lang, "pages.about.body")}</p>
				<div class="flex flex-wrap gap-4 pt-4">
					<ActionLink href={contactHref} variant="primary">{t(lang, "header.links.contact")}</ActionLink>
				<ActionLink href={blogHref} variant="secondary">{t(lang, "header.links.blog")}</ActionLink>
			</div>
		</Container>
	</section>
</Layout>
