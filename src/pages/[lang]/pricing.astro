---
import Layout from "../../layouts/Layout.astro";
import { getSiteTranslations } from "../../data/translations/site";
import { t } from "../../utils/i18n";
import { getLanguageFromParams, getLocaleStaticPaths } from "../../utils/routing";

export function getStaticPaths() {
	return getLocaleStaticPaths();
}

const lang = getLanguageFromParams(Astro.params.lang);
const siteTranslations = getSiteTranslations(lang);
---

<Layout
	lang={lang}
	pageDescription={t(lang, "pages.pricing.description")}
	pageTitle={`${t(lang, "pages.pricing.meta_title")} | ${siteTranslations.title}`}
>
	<section class="mx-auto max-w-5xl px-6 py-16">
		<div class="max-w-2xl space-y-4">
			<h1 class="text-4xl font-bold tracking-tight text-slate-950">
				{t(lang, "pages.pricing.title")}
			</h1>
			<p class="text-lg leading-8 text-slate-600">{t(lang, "pages.pricing.intro")}</p>
		</div>
		<div class="mt-10 grid gap-6 md:grid-cols-2">
			<div class="rounded-3xl border border-slate-200 p-8">
				<h2 class="text-2xl font-semibold text-slate-950">
					{t(lang, "pages.pricing.plans.starter.title")}
				</h2>
				<p class="mt-3 text-slate-600">
					{t(lang, "pages.pricing.plans.starter.description")}
				</p>
			</div>
			<div class="rounded-3xl border border-slate-900 bg-slate-900 p-8 text-white">
				<h2 class="text-2xl font-semibold">{t(lang, "pages.pricing.plans.pro.title")}</h2>
				<p class="mt-3 text-slate-300">{t(lang, "pages.pricing.plans.pro.description")}</p>
			</div>
		</div>
	</section>
</Layout>
