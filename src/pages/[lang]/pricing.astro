---
import ActionLink from "../../components/ui/ActionLink.astro";
import Container from "../../components/ui/Container.astro";
import SectionIntro from "../../components/ui/SectionIntro.astro";
import Layout from "../../layouts/Layout.astro";
import { t } from "../../utils/i18n";
import { createMarketingMetadata } from "../../utils/metadata";
import {
	getLanguageFromParams,
	getLocalizedPath,
	getLocaleStaticPaths,
} from "../../utils/routing";

export function getStaticPaths() {
	return getLocaleStaticPaths();
}

const lang = getLanguageFromParams(Astro.params.lang);
const contactHref = getLocalizedPath(lang, "/contact");
const blogHref = getLocalizedPath(lang, "/blog");
const metadata = createMarketingMetadata(lang, {
	description: t(lang, "pages.pricing.description"),
	title: t(lang, "pages.pricing.meta_title"),
});
---

<Layout {...metadata}>
	<section class="py-16">
		<Container size="page">
			<SectionIntro
				description={t(lang, "pages.pricing.intro")}
				title={t(lang, "pages.pricing.title")}
				titleTag="h1"
			/>
			<div class="mt-10 grid gap-6 md:grid-cols-2">
				<div class="rounded-3xl border border-slate-200 p-8">
					<h2 class="text-2xl font-semibold text-slate-950">
						{t(lang, "pages.pricing.plans.starter.title")}
				</h2>
				<p class="mt-3 text-slate-600">
					{t(lang, "pages.pricing.plans.starter.description")}
				</p>
			</div>
				<div class="rounded-3xl border border-slate-900 bg-slate-900 p-8 text-white">
					<h2 class="text-2xl font-semibold">{t(lang, "pages.pricing.plans.pro.title")}</h2>
					<p class="mt-3 text-slate-300">{t(lang, "pages.pricing.plans.pro.description")}</p>
				</div>
			</div>
			<div class="mt-8 flex flex-wrap gap-4">
				<ActionLink href={contactHref} variant="primary">{t(lang, "header.links.contact")}</ActionLink>
				<ActionLink href={blogHref} variant="secondary">{t(lang, "blog.index_title")}</ActionLink>
			</div>
		</Container>
	</section>
</Layout>
