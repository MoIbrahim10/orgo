---
import ActionLink from "../../components/ui/ActionLink.astro";
import ResponsiveMedia from "../../components/common/ResponsiveMedia.astro";
import PageSection from "../../components/ui/PageSection.astro";
import SectionIntro from "../../components/ui/SectionIntro.astro";
import { contactSceneImage } from "../../data/media";
import { getContactPageContent } from "../../data/translations/contact";
import Layout from "../../layouts/Layout.astro";
import { createMarketingMetadata } from "../../utils/metadata";
import { getLanguageFromParams, getLocaleStaticPaths } from "../../utils/routing";

export function getStaticPaths() {
	return getLocaleStaticPaths();
}

const lang = getLanguageFromParams(Astro.params.lang);
const content = getContactPageContent(lang);
const metadata = createMarketingMetadata(lang, {
	description: content.description,
	title: content.metaTitle,
});
---

<Layout {...metadata}>
	<PageSection backdrop="glow" layout="split" tone="warm">
		<div slot="intro">
			<SectionIntro description={content.intro} title={content.title} titleTag="h1" />
		</div>
		<div class="grid gap-6">
			<div class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-[0_20px_60px_rgba(15,23,42,0.06)]">
				<ResponsiveMedia
					alt=""
					ariaHidden={true}
					imgClass="h-full w-full object-cover"
					loading="eager"
					sizes="(max-width: 1024px) 100vw, 720px"
					src={contactSceneImage}
					widths={[520, 760, 980]}
				/>
			</div>
			<div class="grid gap-5 lg:grid-cols-3">
				{content.conversations.map((conversation) => (
					<article class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-[0_18px_50px_rgba(15,23,42,0.05)]">
						<h2 class="font-display text-2xl font-semibold tracking-tight text-slate-950">
							{conversation.title}
						</h2>
						<p class="mt-4 text-base leading-7 text-slate-600">{conversation.body}</p>
						<div class="mt-6">
							<ActionLink href={conversation.href} size="sm" variant="secondary">
								{conversation.ctaLabel}
							</ActionLink>
						</div>
					</article>
				))}
			</div>
		</div>
		<div slot="aside" class="space-y-5">
			<div class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-[0_18px_50px_rgba(15,23,42,0.05)]">
				<p class="text-xs uppercase tracking-[0.2em] text-slate-500">{content.emailLabel}</p>
				<a class="mt-3 block text-lg font-medium text-slate-900" href={`mailto:${content.emailValue}`}>
					{content.emailValue}
				</a>
			</div>
			<div class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-[0_18px_50px_rgba(15,23,42,0.05)]">
				<p class="text-xs uppercase tracking-[0.2em] text-slate-500">{content.githubLabel}</p>
				<a
					class="mt-3 block text-lg font-medium text-slate-900"
					href={content.githubValue}
					rel="noreferrer"
					target="_blank"
				>
					{content.githubValue.replace(/^https?:\/\//, "")}
				</a>
			</div>
		</div>
	</PageSection>

	<PageSection layout="split" surface="panel">
		<div slot="intro">
			<SectionIntro
				description={content.process.description}
				eyebrow={content.process.eyebrow}
				title={content.process.title}
			/>
		</div>
		<div class="grid gap-6 lg:grid-cols-3">
			{content.process.steps.map((step, index) => (
				<article class="rounded-[1.5rem] border border-slate-200 bg-slate-50 p-5">
					<p class="text-sm font-medium uppercase tracking-[0.18em] text-slate-500">
						0{index + 1}
					</p>
					<h2 class="font-display mt-4 text-2xl font-semibold tracking-tight text-slate-950">
						{step.title}
					</h2>
					<p class="mt-4 text-base leading-7 text-slate-600">{step.body}</p>
				</article>
			))}
		</div>
		<div slot="aside" class="space-y-4">
			{content.availability.map((item) => (
				<div class="rounded-[1.5rem] border border-slate-200 bg-slate-950 p-6 text-white">
					<p class="text-xs uppercase tracking-[0.18em] text-white/60">{item.label}</p>
					<p class="mt-4 text-base leading-7 text-white/90">{item.value}</p>
				</div>
			))}
		</div>
	</PageSection>

	<PageSection class="pt-0">
		<div class="rounded-[2rem] border border-slate-200 bg-linear-to-br from-amber-50 via-white to-sky-50 px-6 py-8 shadow-[0_24px_70px_rgba(15,23,42,0.08)] sm:px-8 sm:py-10">
			<div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
				<div class="max-w-3xl">
					<h2 class="font-display text-4xl font-semibold tracking-tight text-slate-950 sm:text-[2.7rem] sm:leading-[1.08]">
						{content.closing.title}
					</h2>
					<p class="mt-5 text-lg leading-8 text-slate-600">{content.closing.description}</p>
				</div>
				<div class="flex flex-wrap gap-4">
					<ActionLink href={content.closing.primaryHref} variant="primary">
						{content.closing.primaryLabel}
					</ActionLink>
					<ActionLink href={content.closing.secondaryHref} variant="secondary">
						{content.closing.secondaryLabel}
					</ActionLink>
				</div>
			</div>
		</div>
	</PageSection>
</Layout>
