---
import { Picture } from "astro:assets";
import ActionLink from "../../components/ui/ActionLink.astro";
import Container from "../../components/ui/Container.astro";
import SectionIntro from "../../components/ui/SectionIntro.astro";
import { contactSceneImage } from "../../data/media";
import Layout from "../../layouts/Layout.astro";
import { getSiteTranslations } from "../../data/translations/site";
import { t } from "../../utils/i18n";
import {
	getLanguageFromParams,
	getLocalizedPath,
	getLocaleStaticPaths,
} from "../../utils/routing";

export function getStaticPaths() {
	return getLocaleStaticPaths();
}

const lang = getLanguageFromParams(Astro.params.lang);
const siteTranslations = getSiteTranslations(lang);
const pricingHref = getLocalizedPath(lang, "/pricing");
const blogHref = getLocalizedPath(lang, "/blog");
const contactEmail = t(lang, "pages.contact.email_value");
const githubUrl = t(lang, "pages.contact.github_value");
---

<Layout
	lang={lang}
	pageDescription={t(lang, "pages.contact.description")}
	pageTitle={`${t(lang, "pages.contact.meta_title")} | ${siteTranslations.title}`}
>
	<section class="py-16">
		<Container size="page">
			<SectionIntro
				description={t(lang, "pages.contact.intro")}
				title={t(lang, "pages.contact.title")}
				titleTag="h1"
			/>
			<div class="mt-10 grid gap-6 lg:grid-cols-[1.15fr_0.85fr]">
				<div class="rounded-[2rem] border border-slate-200 bg-white p-8 shadow-[0_20px_60px_rgba(15,23,42,0.06)]">
					<h2 class="font-display text-2xl font-semibold text-slate-950">
						{t(lang, "pages.contact.card_title")}
					</h2>
					<div class="mt-6 grid gap-5">
						<div class="rounded-3xl bg-slate-50 p-5">
							<p class="text-xs uppercase tracking-[0.2em] text-slate-500">
								{t(lang, "pages.contact.email_label")}
							</p>
							<a class="mt-3 block text-lg font-medium text-slate-900" href={`mailto:${contactEmail}`}>
								{contactEmail}
							</a>
						</div>
						<div class="rounded-3xl bg-slate-50 p-5">
							<p class="text-xs uppercase tracking-[0.2em] text-slate-500">
								{t(lang, "pages.contact.github_label")}
							</p>
							<a
								class="mt-3 block text-lg font-medium text-slate-900"
								href={githubUrl}
								rel="noreferrer"
								target="_blank"
							>
								{githubUrl.replace(/^https?:\/\//, "")}
							</a>
						</div>
					</div>
				</div>
				<div class="space-y-6">
					<div class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-[0_20px_60px_rgba(15,23,42,0.06)]">
						<Picture
							alt=""
							aria-hidden="true"
							class="h-full w-full object-cover"
							loading="eager"
							sizes="(max-width: 1024px) 100vw, 420px"
							src={contactSceneImage}
							widths={[480, 720, 960]}
						/>
					</div>
					<div class="rounded-[2rem] border border-slate-200 bg-slate-950 p-8 text-white shadow-[0_24px_70px_rgba(15,23,42,0.12)]">
						<p class="text-xs uppercase tracking-[0.2em] text-white/60">
							{t(lang, "pages.contact.availability_label")}
						</p>
						<p class="mt-3 text-lg leading-8 text-white/90">
							{t(lang, "pages.contact.availability_value")}
						</p>
						<p class="mt-6 text-xs uppercase tracking-[0.2em] text-white/60">
							{t(lang, "pages.contact.response_label")}
						</p>
						<p class="mt-3 text-lg leading-8 text-white/90">
							{t(lang, "pages.contact.response_value")}
						</p>
					</div>
					<div class="rounded-[2rem] border border-slate-200 bg-linear-to-br from-amber-50 via-white to-sky-50 p-8">
						<p class="text-lg leading-8 text-slate-600">{t(lang, "pages.contact.description")}</p>
						<div class="mt-6 flex flex-wrap gap-4">
							<ActionLink href={pricingHref} variant="primary">
								{t(lang, "pages.contact.primary_cta")}
							</ActionLink>
							<ActionLink href={blogHref} variant="secondary">
								{t(lang, "pages.contact.secondary_cta")}
							</ActionLink>
						</div>
					</div>
				</div>
			</div>
		</Container>
	</section>
</Layout>
