---
import { getCollection } from "astro:content";
import ReleaseFeed from "../../components/changelog/ReleaseFeed.astro";
import ActionLink from "../../components/ui/ActionLink.astro";
import PageSection from "../../components/ui/PageSection.astro";
import SectionIntro from "../../components/ui/SectionIntro.astro";
import { getResourcePagesContent } from "../../data/translations/resources";
import Layout from "../../layouts/Layout.astro";
import { createMarketingMetadata } from "../../utils/metadata";
import { getLocalizedChangelogEntries } from "../../utils/marketingContent";
import { getLanguageFromParams, getLocaleStaticPaths } from "../../utils/routing";

export function getStaticPaths() {
	return getLocaleStaticPaths();
}

const lang = getLanguageFromParams(Astro.params.lang);
const pageContent = getResourcePagesContent(lang).changelog;
const allEntries = await getCollection("changelog");
const changelogEntries = getLocalizedChangelogEntries(allEntries, lang);
const counts = changelogEntries.reduce(
	(summary, entry) => ({
		...summary,
		[entry.data.type]: summary[entry.data.type] + 1,
	}),
	{
		improvement: 0,
		launch: 0,
		note: 0,
	},
);
const metadata = createMarketingMetadata(lang, {
	description: pageContent.description,
	title: pageContent.metaTitle,
});
---

<Layout {...metadata}>
	<PageSection backdrop="glow" tone="warm">
		<SectionIntro
			description={pageContent.intro}
			title={pageContent.title}
			titleTag="h1"
		/>
	</PageSection>

	<PageSection layout="split" surface="panel">
		<div>
			<ReleaseFeed entries={changelogEntries} lang={lang} />
		</div>
		<div slot="aside" class="space-y-5">
			<div class="rounded-[1.75rem] border border-slate-200 bg-slate-950 p-6 text-white">
				<h2 class="font-display text-2xl font-semibold tracking-tight text-white">
					{pageContent.sidebarTitle}
				</h2>
				<p class="mt-4 text-base leading-7 text-white/80">{pageContent.sidebarDescription}</p>
				<div class="mt-6 grid gap-3">
					<div class="rounded-2xl bg-white/10 px-4 py-3 text-sm">
						{lang === "ar" ? "إصدارات تأسيسية" : "Foundation releases"}: {counts.launch}
					</div>
					<div class="rounded-2xl bg-white/10 px-4 py-3 text-sm">
						{lang === "ar" ? "تحسينات" : "Improvements"}: {counts.improvement}
					</div>
					<div class="rounded-2xl bg-white/10 px-4 py-3 text-sm">
						{lang === "ar" ? "ملاحظات" : "Notes"}: {counts.note}
					</div>
				</div>
			</div>
			<div class="flex flex-wrap gap-3">
				<ActionLink href={pageContent.primaryHref} size="sm" variant="primary">
					{pageContent.primaryLabel}
				</ActionLink>
				<ActionLink href={pageContent.secondaryHref} size="sm" variant="secondary">
					{pageContent.secondaryLabel}
				</ActionLink>
			</div>
		</div>
	</PageSection>
</Layout>
