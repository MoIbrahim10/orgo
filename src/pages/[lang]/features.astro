---
import { getCollection, render } from "astro:content";
import ActionLink from "../../components/ui/ActionLink.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import { getResourcePagesContent } from "../../data/translations/resources";
import Layout from "../../layouts/Layout.astro";
import { createMarketingMetadata } from "../../utils/metadata";
import { getLocalizedFeatureEntries } from "../../utils/marketingContent";
import { getLanguageFromParams, getLocaleStaticPaths, getLocalizedPath } from "../../utils/routing";

export function getStaticPaths() {
	return getLocaleStaticPaths();
}

const lang = getLanguageFromParams(Astro.params.lang);
const pageContent = getResourcePagesContent(lang).features;
const allFeatures = await getCollection("features");
const features = getLocalizedFeatureEntries(allFeatures, lang);
const featureSections = await Promise.all(
	features.map(async (feature) => ({
		feature,
		Content: (await render(feature)).Content,
	})),
);
const metadata = createMarketingMetadata(lang, {
	description: pageContent.description,
	title: pageContent.metaTitle,
});
---

<Layout {...metadata}>
	<div class="features-page py-10">
		<section aria-labelledby="features-hero-heading" class="features-page__hero" data-home-reveal-section>
			<div class="features-page__hero-inner">
				<h1 id="features-hero-heading" class="features-page__title home-reveal" style="--reveal-index: 0">
					{pageContent.title}
				</h1>
				<p class="features-page__lead home-reveal" style="--reveal-index: 1">
					{pageContent.intro}
				</p>
			</div>
		</section>

		<div class="home-main-stack mx-auto flex w-full max-w-[914px] flex-col gap-36 pb-12">
			{
				featureSections.map(({ feature, Content }, index) => (
					<section
						class="features-page__block"
						aria-labelledby={`feature-section-${index}-heading`}
						data-home-reveal-section
					>
						<div class="features-page__split">
							<div class="features-page__main home-reveal" style={`--reveal-index: ${index % 3}`}>
								<p class="features-page__eyebrow">{feature.data.eyebrow}</p>
								<h2 id={`feature-section-${index}-heading`} class="features-page__feature-title">
									{feature.data.title}
								</h2>
								<p class="features-page__summary">{feature.data.summary}</p>
								<div class="features-page__prose blog-prose">
									<Content />
								</div>
							</div>
							<aside class="features-page__aside home-reveal" style={`--reveal-index: ${(index % 3) + 1}`}>
								<div class="features-page__glance">
									<p class="features-page__glance-label">{pageContent.benefitsAsideTitle}</p>
									<ul class="features-page__benefit-list">
										{feature.data.benefits.map((benefit) => (
											<li class="features-page__benefit">
												<h3 class="spotlight-surface-card-title features-page__benefit-title">{benefit.title}</h3>
												<p class="spotlight-surface-card-desc features-page__benefit-body">{benefit.body}</p>
											</li>
										))}
									</ul>
								</div>
								{feature.data.relatedPath && feature.data.relatedLabel && (
									<div class="features-page__related">
										<ActionLink href={getLocalizedPath(lang, feature.data.relatedPath)} variant="secondary">
											{feature.data.relatedLabel}
										</ActionLink>
									</div>
								)}
							</aside>
						</div>
					</section>
				))
			}

			<section class="features-page__cta" aria-labelledby="features-cta-heading" data-home-reveal-section>
				<div class="features-page__cta-inner">
					<SectionHeader
						align="center"
						class="features-page__cta-header"
						description={pageContent.cta.description}
						headline={pageContent.cta.headline}
						headlineId="features-cta-heading"
						headlineTag="h2"
						revealStagger={true}
						sectionName={pageContent.cta.sectionName}
					/>
					<div class="features-page__cta-panel home-reveal" style="--reveal-index: 3">
						<div class="features-page__cta-actions">
							<ActionLink href={pageContent.cta.primaryHref} variant="primary">
								{pageContent.cta.primaryLabel}
							</ActionLink>
							<ActionLink href={pageContent.cta.secondaryHref} variant="secondary">
								{pageContent.cta.secondaryLabel}
							</ActionLink>
						</div>
					</div>
				</div>
			</section>
		</div>
	</div>
</Layout>

<style>
	.features-page {
		display: flex;
		flex-direction: column;
		gap: 6rem;
	}

	.features-page__hero {
		overflow: hidden;
		padding-inline: 6px;
		padding-top: 12px;
		position: relative;
	}

	.features-page__hero-inner {
		align-items: center;
		display: flex;
		flex-direction: column;
		text-align: center;
	}

	.features-page__title {
		color: var(--foreground-primary);
		font-size: 48px;
		font-weight: 600;
		margin-bottom: 8px;
		margin-top: 0;
		max-width: 46rem;
		text-wrap: balance;
	}

	.features-page__lead {
		color: var(--foreground-secondary);
		font-family: var(--font-ui);
		font-size: 16px;
		font-weight: 400;
		line-height: 19px;
		max-width: 41rem;
		text-wrap: pretty;
	}

	@media (max-width: 640px) {
		.features-page__title {
			font-size: 40px;
		}
	}

	.features-page__block {
		width: 100%;
	}

	.features-page__split {
		align-items: start;
		display: grid;
		gap: clamp(1.75rem, 4vw, 2.5rem);
		grid-template-columns: 1fr;
	}

	@media (width >= 960px) {
		.features-page__split {
			grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.42fr);
			gap: 2.5rem;
		}
	}

	.features-page__eyebrow {
		color: var(--foreground-tertiary);
		font-family: var(--font-ui);
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.14em;
		margin: 0 0 0.75rem;
		text-transform: uppercase;
	}

	.features-page__feature-title {
		color: var(--foreground-primary);
		font-family: var(--font-display-latin);
		font-size: clamp(1.75rem, 2.5vw, 2.25rem);
		font-weight: 600;
		line-height: 1.2;
		margin: 0;
	}

	:global(body.locale-arabic) .features-page__feature-title {
		font-family: var(--font-display-arabic);
	}

	.features-page__summary {
		color: var(--foreground-secondary);
		font-family: var(--font-ui);
		font-size: 16px;
		line-height: 1.45;
		margin: 1rem 0 0;
	}

	.features-page__prose {
		margin-top: 1.5rem;
	}

	.features-page__glance {
		background: var(--feature-spotlight-card-surface);
		border: 1px solid var(--page-border);
		border-radius: var(--feature-spotlight-card-radius);
		box-shadow: var(--theme-shadow-soft);
		padding: 1.375rem 1.25rem 1.5rem;
	}

	html[data-theme="dark"] .features-page__glance {
		box-shadow:
			var(--theme-shadow-soft),
			inset 0 1px 0 rgb(255 255 255 / 6%);
	}

	.features-page__glance-label {
		color: var(--foreground-tertiary);
		font-family: var(--font-ui);
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.14em;
		margin: 0;
		text-transform: uppercase;
	}

	.features-page__benefit-list {
		list-style: none;
		margin: 1rem 0 0;
		padding: 0;
	}

	.features-page__benefit {
		background: var(--page-surface-muted);
		border: 1px solid var(--page-border);
		border-radius: var(--feature-spotlight-card-radius);
		margin: 0;
		padding: 0.85rem 0.75rem 1rem;
	}

	.features-page__benefit + .features-page__benefit {
		margin-top: 0.65rem;
	}

	.features-page__benefit-title {
		font-size: 15px;
	}

	.features-page__benefit-body {
		font-size: 14px;
		line-height: 1.45;
		margin-top: 0.35rem;
	}

	.features-page__related {
		margin-top: 1rem;
	}

	.features-page__cta {
		background: transparent;
		isolation: isolate;
		margin-inline: calc(50% - 50vw);
		overflow: hidden;
		width: 100vw;
	}

	.features-page__cta-inner {
		margin-inline: auto;
		max-width: var(--layout-width-navbar);
		padding-inline: var(--layout-gutter);
	}

	.features-page__cta-header :global(.section-header) {
		margin-inline: auto;
		max-width: 40rem;
	}

	.features-page__cta-panel {
		border-top: 1px solid transparent;
		margin-inline: auto;
		margin-top: clamp(1.75rem, 4vw, 2.25rem);
		max-width: 40rem;
		padding: 24px;
		padding-top: clamp(1.5rem, 3vw, 2rem);
		position: relative;
		width: 100%;
	}

	.features-page__cta-actions {
		align-items: center;
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		justify-content: center;
		width: 100%;
	}

	.features-page__cta-panel::before {
		background: linear-gradient(
			90deg,
			transparent,
			color-mix(in srgb, var(--foreground-primary) 16%, transparent) 22%,
			color-mix(in srgb, var(--foreground-primary) 16%, transparent) 78%,
			transparent
		);
		content: "";
		height: 1px;
		left: 0;
		position: absolute;
		right: 0;
		top: 0;
	}
</style>
