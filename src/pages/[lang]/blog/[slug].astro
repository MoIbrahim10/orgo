---
import type { CollectionEntry } from "astro:content";
import { getCollection, getEntries, getEntry, render } from "astro:content";
import TranslationAvailabilityNotice from "../../../components/TranslationAvailabilityNotice.astro";
import { getLocaleConfig } from "../../../data/site";
import Layout from "../../../layouts/BlogLayout.astro";
import {
	getBlogLocaleAlternates,
	getBlogLocaleSwitcherPaths,
	getBlogTranslationEntries,
} from "../../../utils/blog";
import { getPublicAssetPath } from "../../../utils/assets";
import { t } from "../../../utils/i18n";
import { getLanguageFromParams, getLocalizedPath } from "../../../utils/routing";

export async function getStaticPaths() {
	const pages = await getCollection("blog");
	return pages.map((page) => {
		const slug = page.data.slug ?? page.id;
		return { params: { lang: page.data.language, slug }, props: page };
	});
}

const lang = getLanguageFromParams(Astro.params.lang);
const page = Astro.props as CollectionEntry<"blog">;
const allPosts = await getCollection("blog", ({ data }) => !data.isDraft);
const authorEntry = await getEntry(page.data.author);
const author = authorEntry?.data;
const relatedPosts = (await getEntries(page.data.relatedPosts)).filter(
	(post) => post.data.language === lang,
);
const translationEntries = getBlogTranslationEntries(page, allPosts);
const localeAlternates = getBlogLocaleAlternates(translationEntries);
const localeSwitcherPaths = getBlogLocaleSwitcherPaths(localeAlternates);

const formattedDate = page.data.publishDate.toLocaleDateString(getLocaleConfig(lang).dateLocale, {
	dateStyle: "long",
});
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const heroImage = getPublicAssetPath(page.data.image.src);
const ogImage = getPublicAssetPath(page.data.ogImage, "/og.png");
const rssFeedUrl = getLocalizedPath(lang, "/rss.xml");
const structuredDataImage =
	Astro.site && ogImage ? new URL(ogImage, Astro.site).toString() : undefined;
const structuredData = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: page.data.metaTitle ?? page.data.title,
	description: page.data.metaDescription ?? page.data.title,
	datePublished: page.data.publishDate.toISOString(),
	dateModified: page.data.updatedDate.toISOString(),
	inLanguage: lang,
	mainEntityOfPage: canonicalUrl,
	...(structuredDataImage ? { image: [structuredDataImage] } : {}),
	...(author
		? {
				author: {
					"@type": "Person",
					name: author.name,
					...(author.portfolio ? { url: author.portfolio } : {}),
				},
			}
		: {}),
};
const { Content } = await render(page);
---
<Layout
	canonicalUrl={canonicalUrl}
	lang={lang}
	localeAlternates={localeAlternates}
	localeSwitcherPaths={localeSwitcherPaths}
	metaDescription={page.data.metaDescription ?? page.data.title}
	metaTitle={page.data.metaTitle ?? page.data.title}
	ogImage={ogImage}
	rssFeedTitle={page.data.metaTitle ?? page.data.title}
	rssFeedUrl={rssFeedUrl}
	structuredData={structuredData}
>
	<article class="mx-auto flex max-w-3xl flex-col gap-10 px-6 py-16">
		<header class="space-y-4">
			<p class="text-sm font-medium uppercase tracking-[0.2em] text-slate-500">
				{formattedDate}
			</p>
			<h1 class="text-4xl font-bold tracking-tight text-slate-950">{page.data.title}</h1>
			<p class="text-lg text-slate-600">
				{t(lang, "blog.by")} {author?.name ?? t(lang, "blog.unknown_author")}
			</p>
			{heroImage && (
				<img
					alt={page.data.image.alt}
					class="rounded-3xl border border-slate-200 object-cover"
					height="720"
					loading="eager"
					src={heroImage}
					width="1280"
				/>
			)}
		</header>
		<TranslationAvailabilityNotice availablePaths={localeAlternates} lang={lang} />
		<section class="space-y-6 leading-8 text-slate-700">
			<Content />
		</section>
		{relatedPosts.length > 0 && (
			<section class="space-y-4 border-t border-slate-200 pt-8">
				<h2 class="text-2xl font-semibold tracking-tight text-slate-950">
					{t(lang, "blog.related_posts")}
				</h2>
				<ul class="space-y-3">
					{relatedPosts.map((post) => (
						<li>
							<a
								class="text-slate-700 transition hover:text-slate-950"
								href={getLocalizedPath(lang, `/blog/${post.data.slug ?? post.id}`)}
							>
								{post.data.title}
							</a>
						</li>
					))}
				</ul>
			</section>
			)}
		</article>
</Layout>
