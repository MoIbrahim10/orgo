---
import { getCollection } from "astro:content";
import BlogArchiveView from "../../../components/blog/BlogArchiveView.astro";
import BlogSubscribeBand from "../../../components/blog/BlogSubscribeBand.astro";
import { getBlogCoverOgUrl } from "../../../data/blogCovers";
import BlogLayout from "../../../layouts/BlogLayout.astro";
import { supportedLanguages, type Language } from "../../../types/translations";
import { getBlogIndexPath, getCategorySummaries, getPaginatedItems, getPaginationState, getPublishedBlogEntries, getTagSummaries } from "../../../utils/blog";
import { t } from "../../../utils/i18n";
import { createArchiveMetadata, createBreadcrumbStructuredData } from "../../../utils/metadata";
import { getLanguageFromParams, getLocaleStaticPaths, getLocalizedPath } from "../../../utils/routing";

export function getStaticPaths() {
	return getLocaleStaticPaths();
}

const lang = getLanguageFromParams(Astro.params.lang);
const allEntries = await getCollection("blog");
const publishedPosts = getPublishedBlogEntries(allEntries, lang);
const posts = getPaginatedItems(publishedPosts, 1);
const featuredPost = posts[0];
const archivePosts = featuredPost ? posts.slice(1) : posts;
const categories = getCategorySummaries(allEntries, lang).map((summary) => ({
	...summary,
	active: false,
}));
const tags = getTagSummaries(allEntries, lang).map((summary) => ({
	...summary,
	active: false,
}));
const categoryCount = categories.length;
const topicCount = tags.length;
const pageTitle = t(lang, "blog.index_title");
const pageDescription = t(lang, "blog.index_description");
const rssFeedUrl = getLocalizedPath(lang, "/rss.xml");
const pagination = getPaginationState({
	currentPage: 1,
	pathForPage: (page) => getBlogIndexPath(lang, page),
	totalItems: publishedPosts.length,
});
const localeAlternates = Object.fromEntries(
	supportedLanguages.map((language) => [language, getBlogIndexPath(language)]),
) as Record<Language, string>;
const breadcrumbs = [
	{ href: getLocalizedPath(lang), label: t(lang, "header.logo") },
	{ label: pageTitle },
];
const ogImage = getBlogCoverOgUrl(publishedPosts[0]?.data.translationGroup ?? "introduction");
const breadcrumbStructuredData = createBreadcrumbStructuredData(
	Astro.site,
	breadcrumbs.map((item) => ({
		label: item.label,
		path: item.href,
	})),
);
const metadata = createArchiveMetadata(lang, {
	description: pageDescription,
	localeAlternates,
	localeSwitcherPaths: localeAlternates,
	ogImage,
	paginationNextUrl: pagination.nextPath,
	paginationPrevUrl: pagination.prevPath,
	rssFeedTitle: pageTitle,
	rssFeedUrl,
	structuredData: breadcrumbStructuredData,
	title: pageTitle,
});
---

<BlogLayout {...metadata}>
	<BlogArchiveView
		breadcrumbs={breadcrumbs}
		description={pageDescription}
		eyebrow={t(lang, "blog.eyebrow")}
		featuredPost={featuredPost}
		heroMetrics={{
			categoryCount,
			postCount: publishedPosts.length,
			topicCount,
		}}
		introTitleSize="display"
		lang={lang}
		pagination={pagination}
		posts={archivePosts}
		taxonomyGroups={[
			{ title: t(lang, "blog.categories_title"), items: categories, mode: "list" },
			{ title: t(lang, "blog.topics_title"), items: tags, mode: "chips" },
		]}
		totalItems={Math.max(0, publishedPosts.length - (featuredPost ? 1 : 0))}
		title={pageTitle}
	>
		<div class="blog-index-section-variants" slot="belowFold">
			<BlogSubscribeBand lang={lang} rssHref={rssFeedUrl} />
		</div>
	</BlogArchiveView>
</BlogLayout>

<style>
	.blog-index-section-variants {
		display: grid;
		gap: clamp(1.25rem, 3vw, 2.5rem);
	}
</style>
