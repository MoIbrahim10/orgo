---
import { getCollection } from "astro:content";
import BlogArchiveView from "../../../../../../components/blog/BlogArchiveView.astro";
import { getBlogCoverOgUrl } from "../../../../../../data/blogCovers";
import BlogLayout from "../../../../../../layouts/BlogLayout.astro";
import { supportedLanguages } from "../../../../../../types/translations";
import {
	findTagSummary,
	getBlogIndexPath,
	getBlogTagPath,
	getCategorySummaries,
	getPaginatedItems,
	getPaginationState,
	getPostsForTag,
	getTagSummaries,
	getTotalPages,
} from "../../../../../../utils/blog";
import { t, tWithParams } from "../../../../../../utils/i18n";
import {
	createArchiveMetadata,
	createBreadcrumbStructuredData,
	shouldIndexTagPages,
} from "../../../../../../utils/metadata";
import { getLanguageFromParams, getLocalizedPath } from "../../../../../../utils/routing";

export async function getStaticPaths() {
	const allEntries = await getCollection("blog");

	return supportedLanguages.flatMap((language) =>
		getTagSummaries(allEntries, language).flatMap((summary) => {
			const totalPages = getTotalPages(getPostsForTag(allEntries, language, summary.slug).length);
			return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => ({
				params: {
					lang: language,
					tag: summary.slug,
					page: String(index + 2),
				},
			}));
		}),
	);
}

const lang = getLanguageFromParams(Astro.params.lang);
const tagSlug = Astro.params.tag ?? "";
const currentPage = Number(Astro.params.page ?? "1");
const allEntries = await getCollection("blog");
const tag = findTagSummary(allEntries, lang, tagSlug);
const postsForTag = getPostsForTag(allEntries, lang, tagSlug);
const posts = getPaginatedItems(postsForTag, currentPage);
const categories = getCategorySummaries(allEntries, lang).map((summary) => ({
	...summary,
	active: false,
}));
const tags = getTagSummaries(allEntries, lang).map((summary) => ({
	...summary,
	active: summary.slug === tagSlug,
}));
const pagination = getPaginationState({
	currentPage,
	pathForPage: (page) => getBlogTagPath(lang, tagSlug, page),
	totalItems: postsForTag.length,
});
const localeAlternates = {
	[lang]: getBlogTagPath(lang, tagSlug, currentPage),
};
const localeSwitcherPaths = Object.fromEntries(
	supportedLanguages.map((language) => [language, getBlogIndexPath(language)]),
) as Record<(typeof supportedLanguages)[number], string>;
const pageTitle = tWithParams(lang, "blog.tag_page_title", {
	label: tag?.label ?? t(lang, "blog.index_title"),
});
const pageDescription = tWithParams(lang, "blog.tag_page_description", {
	label: tag?.label ?? t(lang, "blog.index_title"),
});
const breadcrumbs = [
	{ href: getLocalizedPath(lang), label: t(lang, "header.logo") },
	{ href: getBlogIndexPath(lang), label: t(lang, "blog.index_title") },
	{ href: getBlogTagPath(lang, tagSlug), label: tag?.label ?? pageTitle },
	{ label: pageTitle },
];
const ogImage = getBlogCoverOgUrl(postsForTag[0]?.data.translationGroup ?? "introduction");
const breadcrumbStructuredData = createBreadcrumbStructuredData(
	Astro.site,
	breadcrumbs.map((item) => ({
		label: item.label,
		path: item.href,
	})),
);
const metadata = createArchiveMetadata(lang, {
	description: pageDescription,
	localeAlternates,
	localeSwitcherPaths,
	noIndex: !shouldIndexTagPages(),
	ogImage,
	paginationNextUrl: pagination.nextPath,
	paginationPrevUrl: pagination.prevPath,
	structuredData: breadcrumbStructuredData,
	title: pageTitle,
});
---

<BlogLayout {...metadata}>
	<BlogArchiveView
		addStoriesBottomPadding
		breadcrumbs={breadcrumbs}
		description={pageDescription}
		eyebrow={t(lang, "blog.topics_title")}
		lang={lang}
		pagination={pagination}
		posts={posts}
		taxonomyGroups={[
			{ title: t(lang, "blog.categories_title"), items: categories, mode: "list" },
			{ title: t(lang, "blog.topics_title"), items: tags, mode: "chips" },
		]}
		totalItems={postsForTag.length}
		title={pageTitle}
	/>
</BlogLayout>
