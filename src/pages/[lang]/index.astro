---
import HomeHero from '../../components/home/HomeHero.astro';
import HomeFeatureSpotlightSection from '../../components/home/HomeFeatureSpotlightSection.astro';
import HomeBenefitsSection from '../../components/home/HomeBenefitsSection.astro';
import HomeConnectedToolsSection from '../../components/home/HomeConnectedToolsSection.astro';
import HomePricingSection from '../../components/home/HomePricingSection.astro';
import HomeSocialProofSection from '../../components/home/HomeSocialProofSection.astro';
import HomeWorkspaceGlanceSection from '../../components/home/HomeWorkspaceGlanceSection.astro';
import HomePerspectivesSection from '../../components/home/HomePerspectivesSection.astro';
import HomeProposalSection from '../../components/home/HomeProposalSection.astro';
import HomeCtaSection from '../../components/home/HomeCtaSection.astro';
import HomeWorkflowSection from '../../components/home/HomeWorkflowSection.astro';
import { getHomePageContent } from '../../data/translations/home';
import Layout from '../../layouts/Layout.astro';
import { getSiteTranslations } from '../../data/translations/site';
import { getLanguageFromParams, getLocalizedPath, getLocaleStaticPaths } from '../../utils/routing';

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const lang = getLanguageFromParams(Astro.params.lang);
const siteTranslations = getSiteTranslations(lang);
const homeContent = getHomePageContent(lang);
const pricingHref = getLocalizedPath(lang, '/pricing');
const aboutHref = getLocalizedPath(lang, '/about');
const bilingualPlanningHref = getLocalizedPath(lang, '/bilingual-planning');
---

<Layout
  lang={lang}
  pageDescription={homeContent.hero.description}
  pageTitle={siteTranslations.title}>
  <div class="py-10 flex flex-col gap-24">
    <HomeHero
      content={homeContent.hero}
      lang={lang}
      primaryHref={pricingHref}
      secondaryHref={bilingualPlanningHref}
    />
    <div class="home-main-stack flex flex-col gap-36 max-w-[914px] mx-auto">
      <HomeFeatureSpotlightSection content={homeContent.featureSpotlight} />
      <HomeWorkspaceGlanceSection
        content={homeContent.workspaceGlance}
        lang={lang}
      />
      <HomeBenefitsSection content={homeContent.benefits} lang={lang} />
      <HomeConnectedToolsSection content={homeContent.connectedTools} />
      <HomePricingSection content={homeContent.pricing} lang={lang} />
      <HomeSocialProofSection content={homeContent.socialProof} />

      <HomeWorkflowSection content={homeContent.workflow} />
      <HomeProposalSection
        content={homeContent.proposal}
        primaryHref={pricingHref}
        secondaryHref={bilingualPlanningHref}
      />
      <HomePerspectivesSection content={homeContent.perspectives} />
      <HomeCtaSection
        content={homeContent.cta}
        eyebrow={siteTranslations.title}
        primaryHref={pricingHref}
        secondaryHref={aboutHref}
      />
    </div>
  </div>
</Layout>
