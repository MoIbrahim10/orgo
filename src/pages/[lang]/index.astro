---
import HomeFeatureStory from "../../components/home/HomeFeatureStory.astro";
import HomeHero from "../../components/home/HomeHero.astro";
import HomeJumpNav from "../../components/home/HomeJumpNav.astro";
import MarketingIcon from "../../components/home/MarketingIcon.astro";
import { getHomePageContent } from "../../data/translations/home";
import Layout from "../../layouts/Layout.astro";
import { getSiteTranslations } from "../../data/translations/site";
import {
	getLanguageFromParams,
	getLocalizedPath,
	getLocaleStaticPaths,
} from "../../utils/routing";

export function getStaticPaths() {
	return getLocaleStaticPaths();
}

const lang = getLanguageFromParams(Astro.params.lang);
const siteTranslations = getSiteTranslations(lang);
const homeContent = getHomePageContent(lang);
const pricingHref = getLocalizedPath(lang, "/pricing");
const blogHref = getLocalizedPath(lang, "/blog");
const aboutHref = getLocalizedPath(lang, "/about");
---

<Layout lang={lang} pageDescription={homeContent.hero.description} pageTitle={siteTranslations.title}>
	<div class="home-shell pb-20">
		<HomeHero content={homeContent.hero} primaryHref={pricingHref} secondaryHref={blogHref} />
		<HomeJumpNav label={homeContent.jumpLinksLabel} links={homeContent.jumpLinks} />
		{
			homeContent.features.map((story) => (
				<HomeFeatureStory story={story} />
			))
		}
		<section class="px-6 py-8">
			<div class="marketing-panel mx-auto max-w-6xl overflow-hidden rounded-[2rem] border border-slate-200 bg-slate-950 text-white shadow-[0_26px_80px_rgba(15,23,42,0.16)]">
				<div class="grid gap-8 px-6 py-8 sm:px-8 sm:py-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-center lg:px-12">
					<div class="max-w-2xl">
							<p class="marketing-eyebrow border-white/10 bg-white/[0.06] text-white/70">
							{homeContent.workflow.eyebrow}
						</p>
						<h2 class="mt-5 text-4xl font-semibold tracking-tight text-white sm:text-[2.7rem] sm:leading-[1.08]">
							{homeContent.workflow.title}
						</h2>
						<p class="mt-5 text-lg leading-8 text-slate-300">
							{homeContent.workflow.description}
						</p>
					</div>
					<div class="grid gap-4 sm:grid-cols-2">
						{
							homeContent.workflow.steps.map((step) => (
									<div class="rounded-[1.5rem] border border-white/10 bg-white/[0.06] p-5">
									<div class="inline-flex rounded-2xl bg-white/10 p-2 text-white">
										<MarketingIcon className="h-5 w-5" name={step.icon} />
									</div>
									<h3 class="mt-4 text-lg font-semibold text-white">{step.title}</h3>
									<p class="mt-2 text-sm leading-6 text-slate-300">{step.body}</p>
								</div>
							))
						}
					</div>
				</div>
			</div>
		</section>
		<section class="scroll-mt-28 px-6 py-8" id="pricing">
			<div class="mx-auto max-w-6xl">
				<div class="max-w-2xl">
					<p class="marketing-eyebrow">{homeContent.pricing.eyebrow}</p>
					<h2 class="mt-5 text-4xl font-semibold tracking-tight text-slate-950 sm:text-[2.7rem] sm:leading-[1.08]">
						{homeContent.pricing.title}
					</h2>
					<p class="mt-5 text-lg leading-8 text-slate-600">{homeContent.pricing.description}</p>
				</div>
				<div class="mt-10 grid gap-6 lg:grid-cols-2">
					{
						homeContent.pricing.plans.map((plan) => (
							<article
								class:list={[
									"marketing-panel rounded-[2rem] border p-6 sm:p-8",
									plan.accent === "dark"
										? "border-slate-900 bg-slate-950 text-white shadow-[0_28px_80px_rgba(15,23,42,0.18)]"
										: "border-slate-200 bg-white text-slate-950",
								]}
							>
								<p
									class:list={[
										"inline-flex rounded-full px-3 py-1 text-xs font-medium uppercase tracking-[0.2em]",
										plan.accent === "dark"
											? "bg-white/10 text-white/70"
											: "bg-amber-100 text-amber-900",
									]}
								>
									{plan.eyebrow}
								</p>
								<h3 class="mt-5 text-3xl font-semibold">{plan.title}</h3>
								<p
									class:list={[
										"mt-3 text-base leading-7",
										plan.accent === "dark" ? "text-slate-300" : "text-slate-600",
									]}
								>
									{plan.description}
								</p>
								<ul class="mt-6 grid gap-3">
									{
										plan.features.map((feature) => (
											<li class="flex items-start gap-3">
												<div
													class:list={[
														"mt-0.5 rounded-full p-1.5",
														plan.accent === "dark" ? "bg-white/10 text-white" : "bg-slate-950 text-white",
													]}
												>
													<MarketingIcon className="h-3.5 w-3.5" name="check-circle" />
												</div>
												<span class:list={[plan.accent === "dark" ? "text-slate-200" : "text-slate-700"]}>
													{feature}
												</span>
											</li>
										))
									}
								</ul>
								<a
									class:list={[
										"mt-8 inline-flex items-center justify-center rounded-full px-5 py-3 text-sm font-medium transition",
										plan.accent === "dark"
											? "bg-white text-slate-950 hover:bg-slate-100"
											: "bg-slate-950 text-white hover:bg-slate-800",
									]}
									href={plan.href}
								>
									{plan.cta}
								</a>
							</article>
						))
					}
				</div>
			</div>
		</section>
		<section class="scroll-mt-28 px-6 py-8" id="stories">
			<div class="mx-auto max-w-6xl">
				<div class="max-w-2xl">
					<p class="marketing-eyebrow">{homeContent.proof.eyebrow}</p>
					<h2 class="mt-5 text-4xl font-semibold tracking-tight text-slate-950 sm:text-[2.7rem] sm:leading-[1.08]">
						{homeContent.proof.title}
					</h2>
					<p class="mt-5 text-lg leading-8 text-slate-600">{homeContent.proof.description}</p>
				</div>
				<div class="mt-10 grid gap-6 lg:grid-cols-3">
					{
						homeContent.proof.cards.map((card) => (
								<article class="marketing-panel rounded-[2rem] border border-slate-200 bg-white/[0.88] p-6">
								<div class="inline-flex rounded-2xl bg-amber-100 p-2 text-slate-950">
									<MarketingIcon className="h-5 w-5" name={card.icon} />
								</div>
								<h3 class="mt-5 text-2xl font-semibold tracking-tight text-slate-950">
									{card.title}
								</h3>
								<p class="mt-3 text-base leading-7 text-slate-600">{card.body}</p>
								<p class="mt-6 border-t border-slate-200 pt-5 text-base leading-7 text-slate-950">
									"{card.quote}"
								</p>
							</article>
						))
					}
				</div>
			</div>
		</section>
		<section class="px-6 pt-8">
			<div class="marketing-panel mx-auto max-w-6xl rounded-[2rem] border border-slate-200 bg-linear-to-br from-amber-50 via-white to-sky-50 px-6 py-8 shadow-[0_24px_70px_rgba(15,23,42,0.08)] sm:px-8 sm:py-10 lg:px-12">
				<div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
					<div class="max-w-3xl">
						<p class="marketing-eyebrow">{siteTranslations.title}</p>
						<h2 class="mt-5 text-4xl font-semibold tracking-tight text-slate-950 sm:text-[2.7rem] sm:leading-[1.08]">
							{homeContent.cta.title}
						</h2>
						<p class="mt-5 text-lg leading-8 text-slate-600">{homeContent.cta.description}</p>
					</div>
					<div class="flex flex-wrap gap-4">
						<a
							class="inline-flex items-center justify-center rounded-full bg-slate-950 px-5 py-3 text-sm font-medium text-white transition hover:bg-slate-800"
							href={pricingHref}
						>
							{homeContent.cta.primaryCta}
						</a>
						<a
							class="inline-flex items-center justify-center rounded-full border border-slate-300 bg-white/80 px-5 py-3 text-sm font-medium text-slate-700 transition hover:border-slate-900 hover:text-slate-900"
							href={aboutHref}
						>
							{homeContent.cta.secondaryCta}
						</a>
					</div>
				</div>
			</div>
		</section>
	</div>
</Layout>
