---
import ActionLink from "../components/ui/ActionLink.astro";
import Layout from "../layouts/Layout.astro";
import { buildLocalePathMap, getLanguageFromPathname, getLocalizedPath } from "../utils/routing";
import { t } from "../utils/i18n";

const lang = getLanguageFromPathname(Astro.url.pathname);
const homePaths = buildLocalePathMap("/");
const homeHref = getLocalizedPath(lang);
const pricingHref = getLocalizedPath(lang, "/pricing");
---

<Layout
	lang={lang}
	localeAlternates={{}}
	localeSwitcherPaths={homePaths}
	noIndex
	pageDescription={t(lang, "pages.errors.not_found.description")}
	pageTitle={t(lang, "pages.errors.not_found.title")}
	showLocaleSuggestion={false}
>
	<div class="flex flex-col gap-24 py-10">
		<div class="home-main-stack mx-auto flex w-full max-w-[914px] flex-col items-center gap-8 pb-12 text-center">
			<p class="font-display text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">
				{t(lang, "pages.errors.not_found.eyebrow")}
			</p>
			<p class="text-sm font-medium tabular-nums tracking-[0.2em] text-slate-400">404</p>
			<h1 class="font-display max-w-2xl text-4xl font-semibold tracking-tight text-slate-950 sm:text-[2.7rem] sm:leading-[1.08]">
				{t(lang, "pages.errors.not_found.title")}
			</h1>
			<p class="max-w-xl text-lg leading-8 text-slate-600">
				{t(lang, "pages.errors.not_found.description")}
			</p>
			<div class="flex flex-wrap items-center justify-center gap-3 pt-2">
				<ActionLink href={homeHref} variant="primary">
					{t(lang, "pages.errors.not_found.cta")}
				</ActionLink>
				<ActionLink href={pricingHref} variant="secondary">
					{t(lang, "pages.errors.not_found.secondary_cta")}
				</ActionLink>
			</div>
		</div>
	</div>
</Layout>
