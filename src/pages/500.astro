---
import ActionLink from "../components/ui/ActionLink.astro";
import Layout from "../layouts/Layout.astro";
import { buildLocalePathMap, getLanguageFromPathname, getLocalizedPath } from "../utils/routing";
import { t } from "../utils/i18n";

const { error } = Astro.props;
const lang = getLanguageFromPathname(Astro.url.pathname);
const homePaths = buildLocalePathMap("/");
const homeHref = getLocalizedPath(lang);
const shouldShowErrorDetails = import.meta.env.DEV && error instanceof Error;
---

<Layout
	lang={lang}
	localeAlternates={{}}
	localeSwitcherPaths={homePaths}
	noIndex
	pageDescription={t(lang, "pages.errors.server.description")}
	pageTitle={t(lang, "pages.errors.server.title")}
	showLocaleSuggestion={false}
>
	<div class="flex flex-col gap-24 py-10">
		<div class="home-main-stack mx-auto flex w-full max-w-[914px] flex-col items-center gap-8 text-center">
			<p class="font-display text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">
				{t(lang, "pages.errors.server.eyebrow")}
			</p>
			<p class="text-sm font-medium tabular-nums tracking-[0.2em] text-slate-400">500</p>
			<h1 class="font-display max-w-2xl text-4xl font-semibold tracking-tight text-slate-950 sm:text-[2.7rem] sm:leading-[1.08]">
				{t(lang, "pages.errors.server.title")}
			</h1>
			<p class="max-w-xl text-lg leading-8 text-slate-600">
				{t(lang, "pages.errors.server.description")}
			</p>
			<div class="pt-2">
				<ActionLink href={homeHref} variant="primary">
					{t(lang, "pages.errors.server.cta")}
				</ActionLink>
			</div>
			{shouldShowErrorDetails && (
				<pre class="w-full max-w-2xl overflow-x-auto rounded-2xl border border-slate-200 bg-slate-950 p-4 text-left text-sm text-slate-100">
					{error.message}
				</pre>
			)}
		</div>
	</div>
</Layout>
