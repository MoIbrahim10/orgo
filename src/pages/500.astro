---
import Layout from "../layouts/Layout.astro";
import { buildLocalePathMap, getLanguageFromPathname } from "../utils/routing";
import { t } from "../utils/i18n";

const { error } = Astro.props;
const lang = getLanguageFromPathname(Astro.url.pathname);
const homePaths = buildLocalePathMap("/");
const shouldShowErrorDetails = import.meta.env.DEV && error instanceof Error;
---

<Layout
	lang={lang}
	localeAlternates={{}}
	localeSwitcherPaths={homePaths}
	noIndex
	pageDescription={t(lang, "pages.errors.server.description")}
	pageTitle={t(lang, "pages.errors.server.title")}
	showLocaleSuggestion={false}
>
	<section class="mx-auto flex max-w-3xl flex-col gap-4 px-6 py-24 text-center">
		<p class="text-sm font-medium uppercase tracking-[0.2em] text-slate-500">500</p>
		<h1 class="text-4xl font-semibold tracking-tight text-slate-950">
			{t(lang, "pages.errors.server.title")}
		</h1>
		<p class="text-lg text-slate-600">{t(lang, "pages.errors.server.description")}</p>
		{shouldShowErrorDetails && (
			<pre class="overflow-x-auto rounded-2xl bg-slate-950 p-4 text-left text-sm text-slate-100">
				{error.message}
			</pre>
		)}
	</section>
</Layout>
