---
import { getEnabledAnalyticsProviders } from "../../data/site";

const { googleAnalytics: googleAnalyticsId, plausible: plausibleDomain } =
	getEnabledAnalyticsProviders();
---

{
	googleAnalyticsId && (
		<>
			<script
				async
				is:inline
				src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`}
			></script>
			<script define:vars={{ googleAnalyticsId }} is:inline>
				window.dataLayer = window.dataLayer || [];
				function gtag() {
					dataLayer.push(arguments);
				}
				gtag("js", new Date());
				gtag("config", googleAnalyticsId);
			</script>
		</>
	)
}
{
	plausibleDomain && (
		<script
			async
			data-domain={plausibleDomain}
			is:inline
			src="https://plausible.io/js/script.js"
		></script>
	)
}
