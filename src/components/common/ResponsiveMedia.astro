---
import { Image, Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
	src: ImageMetadata;
	alt: string;
	mode?: "image" | "picture";
	wrapperClass?: string;
	imgClass?: string;
	loading?: "eager" | "lazy";
	sizes?: string;
	widths?: number[];
	width?: number;
	height?: number;
	ariaHidden?: boolean;
}

const {
	alt,
	ariaHidden = false,
	height,
	imgClass = "",
	loading = "lazy",
	mode = "picture",
	sizes,
	src,
	width,
	widths,
	wrapperClass = "",
} = Astro.props as Props;
---

<div class={wrapperClass}>
	{
		mode === "image" ? (
			<Image
				alt={alt}
				aria-hidden={ariaHidden}
				class={imgClass}
				decoding="async"
				height={height ?? src.height}
				loading={loading}
				src={src}
				width={width ?? src.width}
			/>
		) : (
			<Picture
				alt={alt}
				aria-hidden={ariaHidden}
				class={imgClass}
				decoding="async"
				loading={loading}
				sizes={sizes}
				src={src}
				widths={widths}
			/>
		)
	}
</div>
