---
import { t } from "../utils/i18n";
import type { Language } from "../types/translations";

interface Props {
	class?: string;
	lang: Language;
}

const { class: className, lang } = Astro.props as Props;
const toggleLabel = t(lang, "theme.toggle");
const switchToDarkLabel = t(lang, "theme.switch_to_dark");
const switchToLightLabel = t(lang, "theme.switch_to_light");
---

<button
	aria-label={switchToDarkLabel}
	aria-pressed="false"
	class:list={[
		"theme-toggle",
		className,
	]}
	data-orgo-theme-toggle
	data-theme-label-dark={switchToDarkLabel}
	data-theme-label-light={switchToLightLabel}
	title={toggleLabel}
	type="button"
>
	<span class="sr-only">{toggleLabel}</span>
	<span aria-hidden="true" class="theme-toggle-icon">
		<svg
			class="theme-toggle-sun h-5 w-5"
			fill="none"
			stroke="currentColor"
			stroke-linecap="round"
			stroke-linejoin="round"
			stroke-width="1.75"
			viewBox="0 0 24 24"
		>
			<circle cx="12" cy="12" r="4" />
			<path d="M12 2.5v2.25" />
			<path d="M12 19.25v2.25" />
			<path d="m5.64 5.64 1.6 1.6" />
			<path d="m16.76 16.76 1.6 1.6" />
			<path d="M2.5 12h2.25" />
			<path d="M19.25 12h2.25" />
			<path d="m5.64 18.36 1.6-1.6" />
			<path d="m16.76 7.24 1.6-1.6" />
		</svg>
		<svg
			class="theme-toggle-moon h-5 w-5"
			fill="none"
			stroke="currentColor"
			stroke-linecap="round"
			stroke-linejoin="round"
			stroke-width="1.75"
			viewBox="0 0 24 24"
		>
			<path d="M18.25 14.75A6.75 6.75 0 1 1 11 6a5.25 5.25 0 0 0 7.25 8.75Z" />
		</svg>
	</span>
</button>

<script>
	type ThemePreference = "dark" | "light" | "system";
	type ResolvedTheme = Exclude<ThemePreference, "system">;
	type ThemeWindow = Window & {
		__orgoThemeToggleReady?: boolean;
	};

	const themeToggleWindow = window as ThemeWindow;

	if (!themeToggleWindow.__orgoThemeToggleReady) {
		themeToggleWindow.__orgoThemeToggleReady = true;

		const root = document.documentElement;
		const { themeColorDark, themeColorLight, themeStorageKey } = root.dataset;

		if (themeColorDark && themeColorLight && themeStorageKey) {
			const storageKey = themeStorageKey;
			const mediaQuery = window.matchMedia("(prefers-color-scheme: dark)");
			const metaThemeColor = document.querySelector('meta[name="theme-color"]');
			const themeColors: Record<ResolvedTheme, string> = {
				dark: themeColorDark,
				light: themeColorLight,
			};
			let transitionFrameId: number | undefined;

			const readPreference = (): ThemePreference => {
				try {
					const storedPreference = localStorage.getItem(storageKey);
					return storedPreference === "light" || storedPreference === "dark"
						? storedPreference
						: "system";
				} catch {
					return "system";
				}
			};

			const resolveTheme = (preference: ThemePreference): ResolvedTheme =>
				preference === "light" || preference === "dark"
					? preference
					: mediaQuery.matches
						? "dark"
						: "light";

			const syncToggle = (toggle: HTMLButtonElement, theme: ResolvedTheme) => {
				const lightLabel =
					toggle.getAttribute("data-theme-label-light") ?? "Switch to light mode";
				const darkLabel = toggle.getAttribute("data-theme-label-dark") ?? "Switch to dark mode";
				const nextLabel = theme === "dark" ? lightLabel : darkLabel;

				toggle.dataset.theme = theme;
				toggle.setAttribute("aria-label", nextLabel);
				toggle.setAttribute("aria-pressed", String(theme === "dark"));
				toggle.setAttribute("title", nextLabel);
			};

			const syncAllToggles = (theme: ResolvedTheme) => {
				document.querySelectorAll("[data-orgo-theme-toggle]").forEach((toggle) => {
					if (!(toggle instanceof HTMLButtonElement)) {
						return;
					}

					syncToggle(toggle, theme);
				});
			};

			const disableThemeTransitions = () => {
				root.classList.add("theme-transition-disabled");

				if (transitionFrameId !== undefined) {
					window.cancelAnimationFrame(transitionFrameId);
				}

				transitionFrameId = window.requestAnimationFrame(() => {
					transitionFrameId = window.requestAnimationFrame(() => {
						root.classList.remove("theme-transition-disabled");
						transitionFrameId = undefined;
					});
				});
			};

			const applyTheme = (preference: ThemePreference, { instant = false } = {}) => {
				const resolvedTheme = resolveTheme(preference);

				if (instant) {
					disableThemeTransitions();
				}

				root.dataset.theme = resolvedTheme;
				root.dataset.themeSource = preference;

				if (metaThemeColor) {
					metaThemeColor.setAttribute("content", themeColors[resolvedTheme]);
				}

				syncAllToggles(resolvedTheme);
			};

			const storePreference = (preference: ThemePreference) => {
				try {
					if (preference === "system") {
						localStorage.removeItem(storageKey);
						return;
					}

					localStorage.setItem(storageKey, preference);
				} catch {}
			};

			const toggleTheme = () => {
				const currentTheme = root.dataset.theme === "dark" ? "dark" : "light";
				const nextPreference = currentTheme === "dark" ? "light" : "dark";

				storePreference(nextPreference);
				applyTheme(nextPreference, { instant: true });
			};

			const bindThemeToggles = () => {
				document.querySelectorAll("[data-orgo-theme-toggle]").forEach((toggle) => {
					if (!(toggle instanceof HTMLButtonElement) || toggle.dataset.bound === "true") {
						return;
					}

					toggle.dataset.bound = "true";
					toggle.addEventListener("click", toggleTheme);
				});

				applyTheme(readPreference());
			};

			bindThemeToggles();

			mediaQuery.addEventListener("change", () => {
				if (readPreference() !== "system") {
					return;
				}

				applyTheme("system", { instant: true });
			});

			document.addEventListener("astro:page-load", bindThemeToggles);
		}
	}
</script>

<style>
	.theme-toggle.nav-icon-button {
		align-items: center;
		background: var(--nav-control-surface);
		border: 1px solid var(--nav-control-border);
		border-radius: var(--control-radius);
		box-shadow: var(--nav-control-shadow);
		color: var(--nav-control-text);
		cursor: pointer;
		display: inline-flex;
		flex-shrink: 0;
		height: 2.75rem;
		justify-content: center;
		outline: none;
		transition:
			background-color var(--control-transition),
			border-color var(--control-transition),
			box-shadow var(--control-transition),
			color var(--control-transition),
			transform var(--control-transition);
		width: 2.75rem;
	}

	.theme-toggle.nav-icon-button:hover {
		background: var(--nav-control-surface-hover);
		border-color: var(--header-panel-border);
		color: var(--nav-control-text-hover);
		transform: translateY(-1px);
	}

	.theme-toggle.nav-icon-button:active {
		transform: translateY(0) scale(0.98);
	}

	.theme-toggle.nav-icon-button:focus-visible {
		box-shadow:
			0 0 0 2px var(--page-bg),
			0 0 0 4px var(--focus-ring-color);
	}

	@media (prefers-reduced-motion: reduce) {
		.theme-toggle.nav-icon-button {
			transition: none;
		}
	}
</style>
