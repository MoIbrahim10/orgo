								fill="currentColor"></path>
						</svg>
					</a>
				</nav>
			</section>
			<section class="site-footer-col" aria-labelledby="footer-primary-heading">
				<p id="footer-primary-heading" class="site-footer-col-title">
					{footerTranslations.primaryTitle}
				</p>
				<nav aria-label={footerTranslations.primaryTitle} class="site-footer-nav">
					{footerTranslations.primaryLinks.map((link) => (
						<a
							class="site-footer-link"
							href={link.localeAbsolute ? link.href : getLocalizedPath(lang, link.href)}
						>
							{link.label}
						</a>
					))}
				</nav>
			</section>
			<section class="site-footer-col" aria-labelledby="footer-resources-heading">
				<p id="footer-resources-heading" class="site-footer-col-title">
					{footerTranslations.resourcesTitle}
				</p>
				<nav aria-label={footerTranslations.resourcesTitle} class="site-footer-nav">
					{footerTranslations.resourceLinks.map((link) => (
						<a
							class="site-footer-link"
							href={link.localeAbsolute ? link.href : getLocalizedPath(lang, link.href)}
						>
							{link.label}
						</a>
					))}
				</nav>
			</section>
		</div>
		<div class="site-footer-meta">
			<p class="site-footer-copyright">&copy; {new Date().getFullYear()} Orgo</p>
		</div>
	</Container>
</footer>

<style>
	.site-footer {
		background: var(--page-bg);
		border-top: 1px solid var(--page-border);
	}

	.site-footer-container {
		padding-block: 2.5rem 2rem;
	}

	.site-footer-grid {
		display: grid;
		gap: 2.5rem 2rem;
		grid-template-columns: 1fr;
	}

	@media (min-width: 768px) {
		.site-footer-grid {
			grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr) minmax(0, 1fr);
			align-items: start;
		}
	}

	.site-footer-brand {
		max-width: 22rem;
	}

	.site-footer-logo-wrap {
		display: flex;
		align-items: center;
	}

	.site-footer-tagline {
		margin: 0.875rem 0 0;
		font-family: var(--font-ui);
		font-size: 0.9375rem;
		line-height: 1.65;
		color: var(--foreground-secondary);
	}

	.site-footer-social {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.65rem;
		margin-top: 1.25rem;
	}

	.site-footer-social-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 2.5rem;
		min-height: 2.5rem;
		padding: 0.375rem;
		border-radius: 0.375rem;
		color: var(--foreground-tertiary);
		text-decoration: none;
		outline: none;
		transition:
			color var(--motion-duration-xs, 0.12s) var(--motion-ease-standard, ease),
			opacity var(--motion-duration-xs, 0.12s) var(--motion-ease-standard, ease);
	}

	.site-footer-social-link:hover {
		color: var(--nav-link-text-hover);
	}

	.site-footer-social-link:focus-visible {
		color: var(--nav-link-text-hover);
		box-shadow: 0 0 0 2px var(--page-bg), 0 0 0 4px var(--focus-ring-color);
	}

	.site-footer-social-icon {
		display: block;
		flex-shrink: 0;
	}

	.site-footer-col-title {
		margin: 0;
		font-family: var(--font-ui);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--foreground-tertiary);
	}

	.site-footer-nav {
		margin-top: 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
	}

	.site-footer-link {
		font-family: var(--font-ui);
		font-size: 0.9375rem;
		font-weight: 500;
		color: var(--nav-link-text);
		text-decoration: none;
		border-radius: 0.25rem;
		outline: none;
		transition: color var(--motion-duration-xs, 0.12s) var(--motion-ease-standard, ease);
		width: fit-content;
	}

	.site-footer-link:hover {
		color: var(--nav-link-text-hover);
	}

	.site-footer-link:focus-visible {
		color: var(--nav-link-text-hover);
		box-shadow: 0 0 0 2px var(--page-bg), 0 0 0 4px var(--focus-ring-color);
	}

	/* Matches `home-proposal__cta` divider in HomeProposalSection (“Why Orgo”). */
	.site-footer-meta {
		margin-top: clamp(1.75rem, 4vw, 2.5rem);
		padding-top: clamp(1.5rem, 3vw, 2rem);
		position: relative;
	}

	.site-footer-meta::before {
		background: linear-gradient(
			90deg,
			transparent,
			color-mix(in srgb, var(--foreground-primary) 16%, transparent) 22%,
			color-mix(in srgb, var(--foreground-primary) 16%, transparent) 78%,
			transparent
		);
		content: "";
		height: 1px;
		left: 0;
		position: absolute;
		right: 0;
		top: 0;
	}

	.site-footer-copyright {
		margin: 0;
		font-family: var(--font-ui);
		font-size: 0.8125rem;
		color: var(--foreground-tertiary);
	}
</style>
