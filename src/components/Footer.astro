---
import Container from "./ui/Container.astro";
import Logo from "./ui/Logo.astro";
import { publicSocialLinks } from "../data/site";
import { getFooterTranslations, getHeaderTranslations } from "../data/translations/header";
import type { Language } from "../types/translations";
import { getLocalizedPath } from "../utils/routing";

const { lang } = Astro.props as { lang: Language };
const footerTranslations = getFooterTranslations(lang);
const headerTranslations = getHeaderTranslations(lang);
const homeHref = getLocalizedPath(lang);
---

<footer class="site-footer">
	<Container class="site-footer-container" size="navbar">
		<div class="site-footer-grid">
			<section class="site-footer-brand">
				<div class="site-footer-logo-wrap">
					<Logo alt={headerTranslations.logo} href={homeHref} />
				</div>
				<p class="site-footer-tagline">{footerTranslations.tagline}</p>
				<nav aria-label={footerTranslations.socialNavLabel} class="site-footer-social">
					<a
						class="site-footer-social-link"
						href={publicSocialLinks.linkedin}
						target="_blank"
						rel="noopener noreferrer"
						aria-label={footerTranslations.linkedinAria}
					>
						<svg class="site-footer-social-icon" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
							<path
