---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";

interface Props {
	items: CollectionEntry<"faq">[];
}

const { items } = Astro.props as Props;
const entries = await Promise.all(
	items.map(async (item) => ({
		item,
		Content: (await render(item)).Content,
	})),
);
---

<div class="grid gap-4">
	{entries.map(({ item, Content }) => (
		<details class="group rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-[0_18px_50px_rgba(15,23,42,0.05)]">
			<summary class="flex cursor-pointer list-none items-start justify-between gap-4">
				<div class="space-y-3">
					<p class="text-xs font-medium uppercase tracking-[0.18em] text-slate-500">
						{item.data.category}
					</p>
					<h2 class="font-display text-2xl font-semibold tracking-tight text-slate-950">
						{item.data.question}
					</h2>
					<p class="text-base leading-7 text-slate-600">{item.data.answer}</p>
				</div>
				<span
					aria-hidden="true"
					class="mt-1 text-xl text-slate-400 transition group-open:rotate-45 group-open:text-slate-700"
				>
					+
				</span>
			</summary>
			<div class="blog-prose mt-5 border-t border-slate-200 pt-5">
				<Content />
			</div>
		</details>
	))}
</div>
