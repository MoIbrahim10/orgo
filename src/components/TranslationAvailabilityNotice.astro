---
import { getLocaleConfig } from "../data/site";
import { t } from "../utils/i18n";
import { supportedLanguages, type Language } from "../types/translations";
import type { LocalePathMap } from "../utils/routing";

interface Props {
	lang: Language;
	availablePaths: LocalePathMap;
}

const { lang, availablePaths } = Astro.props as Props;
const alternateLanguages = supportedLanguages.filter(
	(language) => language !== lang && Boolean(availablePaths[language]),
);
---

{
	alternateLanguages.length > 0 && (
		<aside
			aria-label={t(lang, "blog.translation_label")}
			class="text-sm text-(--page-text-muted)"
		>
			<p class="flex flex-wrap items-center gap-x-2 gap-y-1">
				<span class="text-(--page-text-soft)">{t(lang, "blog.available_in")}</span>
				{alternateLanguages.map((language, index) => (
					<>
						{index > 0 && <span aria-hidden="true">·</span>}
						<a
							class="font-medium text-(--page-text-strong) underline decoration-(--page-border-strong) underline-offset-4"
							dir={getLocaleConfig(language).dir}
							href={availablePaths[language] as string}
							lang={getLocaleConfig(language).htmlLang}
						>
							{getLocaleConfig(language).nativeLabel}
						</a>
					</>
				))}
			</p>
		</aside>
	)
}
