---
import type { BlogTaxonomyLink } from "./BlogTaxonomyList.astro";
import type { Language } from "../../types/translations";
import { t } from "../../utils/i18n";

export type TaxonomyAsideGroup = {
	title: string;
	items: BlogTaxonomyLink[];
	mode?: "list" | "chips";
};

interface Props {
	groups: TaxonomyAsideGroup[];
	lang: Language;
}

const { groups, lang } = Astro.props as Props;
const visibleGroups = groups.filter((group) => group.items.length > 0);
const COLLAPSED_TOPICS_COUNT = 7;
const categoriesGroup = visibleGroups.find((group) => group.mode !== "chips");
const topicsGroup = visibleGroups.find((group) => group.mode === "chips");
const topicToggleShowLabel = t(lang, "blog.topics_toggle_show").replace(
	"{count}",
	String(topicsGroup?.items.length ?? 0),
);
const topicToggleHideLabel = t(lang, "blog.topics_toggle_hide");
---

{
	visibleGroups.length > 0 && (
		<section class="blog-taxonomy-aside" aria-labelledby="blog-taxonomy-aside-heading" data-home-reveal-section>
			<header class:list={["blog-taxonomy-aside__header", "home-reveal"]} style="--reveal-index: 0">
				<p class="blog-taxonomy-aside__eyebrow">{t(lang, "blog.sidebar_title")}</p>
				<h2 class="blog-taxonomy-aside__title" id="blog-taxonomy-aside-heading">
					{t(lang, "blog.sidebar_title")}
				</h2>
				<p class="blog-taxonomy-aside__hint">{t(lang, "blog.sidebar_hint")}</p>
			</header>

			<div class="blog-taxonomy-aside__groups home-reveal" style="--reveal-index: 1">
			{
				categoriesGroup && (
					<section class="blog-taxonomy-aside__group" aria-labelledby="taxonomy-group-categories">
						<h3 class="blog-taxonomy-aside__group-title" id="taxonomy-group-categories">
							{categoriesGroup.title}
						</h3>
						<ul class="blog-taxonomy-aside__list">
							{categoriesGroup.items.map((item) => (
								<li>
									<a class:list={["blog-taxonomy-aside__row", item.active && "is-active"]} href={item.href}>
										<span>{item.label}</span>
										<span class="blog-taxonomy-aside__count">{item.count}</span>
									</a>
								</li>
							))}
						</ul>
					</section>
				)
			}

			{
				topicsGroup && (
					<section class="blog-taxonomy-aside__group" aria-labelledby="taxonomy-group-topics">
						<h3 class="blog-taxonomy-aside__group-title" id="taxonomy-group-topics">
							{topicsGroup.title}
						</h3>
						<div class="blog-taxonomy-aside__topics" data-topics-shell>
							<label class="blog-taxonomy-aside__search-label" for="taxonomy-topic-search">
								{t(lang, "blog.topics_search_placeholder")}
							</label>
							<input
								class="blog-taxonomy-aside__search-input"
								data-topics-search
								id="taxonomy-topic-search"
								placeholder={t(lang, "blog.topics_search_placeholder")}
								type="search"
							/>
							<ul class="blog-taxonomy-aside__topic-list">
								{topicsGroup.items.map((item, index) => (
									<li
										class="blog-taxonomy-aside__topic-item"
										data-topic-chip-item
										data-topic-index={index}
										data-topic-label={item.label.toLocaleLowerCase()}
									>
										<a
											class:list={["blog-taxonomy-aside__row", "blog-taxonomy-aside__row--topic", item.active && "is-active"]}
											href={item.href}
										>
											<span>{item.label}</span>
											<span class="blog-taxonomy-aside__count">{item.count}</span>
										</a>
									</li>
								))}
							</ul>
							<p class="blog-taxonomy-aside__no-results" data-topics-no-results hidden>
								{t(lang, "blog.topics_search_no_results")}
							</p>
							{
								topicsGroup.items.length > COLLAPSED_TOPICS_COUNT && (
									<button
										aria-expanded="false"
										class="blog-taxonomy-aside__toggle"
										data-topics-toggle
										data-topics-toggle-hide={topicToggleHideLabel}
										data-topics-toggle-show={topicToggleShowLabel}
										type="button"
									>
										{topicToggleShowLabel}
									</button>
								)
							}
						</div>
					</section>
				)
			}
			</div>
		</section>
	)
}

<script>
	function bindBlogTopicsAside() {
		const COLLAPSED_TOPICS_COUNT = 7;
		const asides = document.querySelectorAll<HTMLElement>(".blog-taxonomy-aside");
		for (const aside of asides) {
			if (aside.dataset.blogTopicsBound === "1") {
				continue;
			}
			aside.dataset.blogTopicsBound = "1";
			const searchInput = aside.querySelector<HTMLInputElement>("[data-topics-search]");
			const shell = aside.querySelector<HTMLElement>("[data-topics-shell]");
			const toggle = aside.querySelector<HTMLButtonElement>("[data-topics-toggle]");
			const chips = aside.querySelectorAll<HTMLElement>("[data-topic-chip-item]");
			const noResults = aside.querySelector<HTMLElement>("[data-topics-no-results]");
			if (toggle && shell) {
				toggle.addEventListener("click", () => {
					const isExpanded = toggle.getAttribute("aria-expanded") === "true";
					const nextExpanded = !isExpanded;
					toggle.setAttribute("aria-expanded", String(nextExpanded));
					shell.classList.toggle("is-expanded", nextExpanded);
					const nextLabel = nextExpanded
						? toggle.dataset.topicsToggleHide ?? toggle.textContent ?? ""
						: toggle.dataset.topicsToggleShow ?? toggle.textContent ?? "";
					toggle.textContent = nextLabel;
					searchInput?.dispatchEvent(new Event("input", { bubbles: true }));
				});
			}
			if (searchInput && chips.length > 0) {
				const getExpandedState = () => toggle?.getAttribute("aria-expanded") === "true";
				const setExpandedState = (expanded: boolean) => {
					if (!shell || !toggle) {
						return;
					}
					shell.classList.toggle("is-expanded", expanded);
					toggle.setAttribute("aria-expanded", String(expanded));
					toggle.textContent = expanded
						? toggle.dataset.topicsToggleHide ?? toggle.textContent ?? ""
						: toggle.dataset.topicsToggleShow ?? toggle.textContent ?? "";
				};
				const applySearch = () => {
					const query = searchInput.value.trim().toLocaleLowerCase();
					const hasQuery = query.length > 0;
					if (hasQuery) {
						setExpandedState(true);
					}
					const isExpanded = getExpandedState();
					let visibleCount = 0;
					chips.forEach((chip) => {
						const label = chip.dataset.topicLabel ?? "";
						const topicIndex = Number(chip.dataset.topicIndex ?? "0");
						const visibleByQuery = query.length === 0 || label.includes(query);
						const visibleByCollapse = query.length > 0 || isExpanded || topicIndex < COLLAPSED_TOPICS_COUNT;
						const visible = visibleByQuery && visibleByCollapse;
						chip.hidden = !visible;
						if (visibleByQuery) {
							visibleCount += 1;
						}
					});
					if (noResults) {
						noResults.hidden = visibleCount > 0 || query.length === 0;
					}
				};
				applySearch();
				searchInput.addEventListener("input", applySearch);
			}
		}
	}

	bindBlogTopicsAside();
	document.addEventListener("astro:page-load", bindBlogTopicsAside);
</script>

<style>
	.blog-taxonomy-aside {
		background: color-mix(in srgb, var(--page-surface-muted) 52%, transparent);
		border: 1px solid color-mix(in srgb, var(--page-border) 46%, transparent);
		border-radius: 0.95rem;
		display: grid;
		gap: 1.35rem;
		padding: 1rem;
	}

	.blog-taxonomy-aside__groups {
		display: grid;
		gap: 0;
		min-width: 0;
	}

	.blog-taxonomy-aside__header,
	.blog-taxonomy-aside__group {
		display: grid;
		gap: 0.75rem;
	}

	.blog-taxonomy-aside__group {
		border-top: 1px solid color-mix(in srgb, var(--page-border) 48%, transparent);
		padding-top: 1rem;
	}

	.blog-taxonomy-aside__eyebrow,
	.blog-taxonomy-aside__group-title {
		color: var(--page-text-muted);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		line-height: 1.4;
		margin: 0;
		text-transform: uppercase;
	}

	.blog-taxonomy-aside__title {
		color: var(--page-text-strong);
		font-family: var(--font-display-latin), var(--font-display-arabic), serif;
		font-size: 1.5rem;
		font-weight: 600;
		line-height: 1.1;
		margin: 0;
	}

	.blog-taxonomy-aside__hint {
		color: var(--page-text-soft);
		font-size: 0.95rem;
		line-height: 1.72;
		margin: 0;
	}

	.blog-taxonomy-aside__list {
		display: grid;
		gap: 0.45rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.blog-taxonomy-aside__row {
		align-items: baseline;
		color: var(--page-text);
		display: flex;
		gap: 0.85rem;
		justify-content: space-between;
		padding: 0.25rem 0.1rem;
		border-radius: 0.45rem;
		text-decoration: none;
		transition: color 160ms ease, transform 160ms ease;
	}

	.blog-taxonomy-aside__row:hover,
	.blog-taxonomy-aside__row:focus-visible {
		color: var(--page-text-strong);
		outline: none;
		transform: translateX(0.18rem);
	}

	.blog-taxonomy-aside__toggle {
		background: none;
		border: 0;
		color: var(--page-text-soft);
		cursor: pointer;
		font-size: 0.84rem;
		font-weight: 500;
		padding: 0;
		text-align: start;
	}

	.blog-taxonomy-aside__toggle:hover,
	.blog-taxonomy-aside__toggle:focus-visible {
		color: var(--page-text-strong);
		outline: none;
	}

	.blog-taxonomy-aside__topics {
		display: grid;
		gap: 0.75rem;
	}

	.blog-taxonomy-aside__search-label {
		height: 1px;
		margin: -1px;
		overflow: hidden;
		padding: 0;
		position: absolute;
		width: 1px;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}

	.blog-taxonomy-aside__search-input {
		background: color-mix(in srgb, var(--page-surface-muted) 72%, transparent);
		border: 1px solid color-mix(in srgb, var(--page-border) 50%, transparent);
		border-radius: 0.65rem;
		color: var(--page-text);
		font-size: 0.86rem;
		line-height: 1.2;
		min-height: 2rem;
		padding: 0.4rem 0.75rem;
	}

	.blog-taxonomy-aside__search-input:focus-visible {
		outline: 2px solid color-mix(in srgb, var(--focus-ring-color) 70%, transparent);
		outline-offset: 1px;
	}

	.blog-taxonomy-aside__topic-list {
		display: grid;
		gap: 0.35rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.blog-taxonomy-aside__topic-item {
		overflow: hidden;
	}

	.blog-taxonomy-aside__row--topic {
		align-items: center;
	}

	.blog-taxonomy-aside__no-results {
		color: var(--page-text-muted);
		font-size: 0.82rem;
		line-height: 1.5;
		margin: 0;
	}

	.blog-taxonomy-aside__count {
		color: var(--page-text-muted);
		font-size: 0.74rem;
		font-variant-numeric: tabular-nums;
	}

	.blog-taxonomy-aside__row.is-active {
		color: var(--page-text-strong);
		font-weight: 650;
		transform: translateX(0.18rem);
	}

	.blog-taxonomy-aside__row.is-active .blog-taxonomy-aside__count {
		color: var(--page-text-strong);
		font-weight: 600;
	}

	@media (max-width: 1023px) {
		.blog-taxonomy-aside {
			margin-top: 0.5rem;
			padding: 1rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.blog-taxonomy-aside__row {
			transition: none;
		}
	}
</style>
