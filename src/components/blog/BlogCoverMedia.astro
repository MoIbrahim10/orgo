---
import { buildBlogCoverSrcset, buildBlogCoverUrl } from "../../data/blogCovers";

interface Props {
	translationGroup: string;
	alt: string;
	loading?: "eager" | "lazy";
	sizes?: string;
	imgClass?: string;
	wrapperClass?: string;
	widths?: readonly number[];
	fetchpriority?: "high" | "low" | "auto";
}

const {
	alt,
	fetchpriority,
	imgClass = "",
	loading = "lazy",
	sizes = "(max-width: 768px) 100vw, 768px",
	translationGroup,
	widths = [640, 960, 1280],
	wrapperClass = "",
} = Astro.props as Props;
const src = buildBlogCoverUrl(translationGroup, widths[widths.length - 1] ?? 1280);
const srcset = buildBlogCoverSrcset(translationGroup, widths);
---

<div class:list={["blog-cover-media", wrapperClass]}>
	<div class="blog-cover-media__frame" aria-hidden="true"></div>
	<img
		alt={alt}
		class:list={["blog-cover-media__img", imgClass]}
		decoding="async"
		fetchpriority={fetchpriority}
		height={675}
		loading={loading}
		sizes={sizes}
		src={src}
		srcset={srcset}
		width={1200}
	/>
</div>

<style>
	.blog-cover-media {
		position: relative;
		isolation: isolate;
	}

	.blog-cover-media__frame {
		border-radius: inherit;
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--page-border) 70%, transparent);
		inset: 0;
		pointer-events: none;
		position: absolute;
		z-index: 1;
	}

	.blog-cover-media__img {
		border-radius: inherit;
		display: block;
		height: 100%;
		object-fit: cover;
		width: 100%;
	}

	.blog-cover-media::after {
		background: linear-gradient(
			145deg,
			color-mix(in srgb, var(--action-link-primary-gradient-start) 18%, transparent) 0%,
			transparent 42%,
			color-mix(in srgb, var(--action-link-primary-gradient-end) 12%, transparent) 100%
		);
		border-radius: inherit;
		content: "";
		inset: 0;
		mix-blend-mode: multiply;
		opacity: 0.14;
		pointer-events: none;
		position: absolute;
		z-index: 2;
	}

	html[data-theme="dark"] .blog-cover-media::after {
		mix-blend-mode: soft-light;
		opacity: 0.22;
	}
</style>
