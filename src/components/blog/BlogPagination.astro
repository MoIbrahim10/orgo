---
import ActionLink from "../ui/ActionLink.astro";

interface Props {
	currentPage: number;
	nextHref?: string;
	nextLabel: string;
	prevHref?: string;
	prevLabel: string;
	summaryLabel: string;
	totalPages: number;
}

const { currentPage, nextHref, nextLabel, prevHref, prevLabel, summaryLabel, totalPages } =
	Astro.props as Props;
---

{
	totalPages > 1 && (
		<nav class="blog-pagination" aria-label={summaryLabel}>
			<div class="blog-pagination__edge">
				{prevHref && (
					<ActionLink href={prevHref} size="sm" variant="subtle">
						{prevLabel}
					</ActionLink>
				)}
			</div>
			<p class="blog-pagination__summary">
				<span>{summaryLabel}</span>
				<span>
					{currentPage} / {totalPages}
				</span>
			</p>
			<div class="blog-pagination__edge blog-pagination__edge--end">
				{nextHref && (
					<ActionLink href={nextHref} size="sm" variant="secondary">
						{nextLabel}
					</ActionLink>
				)}
			</div>
		</nav>
	)
}

<style>
	.blog-pagination {
		align-items: center;
		border-top: 1px solid color-mix(in srgb, var(--page-border) 58%, transparent);
		display: grid;
		gap: 1rem;
		padding-top: 1.75rem;
	}

	.blog-pagination__edge {
		display: flex;
	}

	.blog-pagination__edge--end {
		justify-content: flex-start;
	}

	.blog-pagination__summary {
		color: var(--page-text-muted);
		display: grid;
		gap: 0.2rem;
		margin: 0;
		text-align: center;
	}

	.blog-pagination__summary span:first-child {
		font-size: 0.86rem;
		line-height: 1.6;
	}

	.blog-pagination__summary span:last-child {
		color: var(--page-text-soft);
		font-size: 0.8rem;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	@media (min-width: 720px) {
		.blog-pagination {
			grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		}

		.blog-pagination__edge--end {
			justify-content: flex-end;
		}
	}
</style>
