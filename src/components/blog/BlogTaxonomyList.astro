---
export type BlogTaxonomyLink = {
	active?: boolean;
	count: number;
	href: string;
	label: string;
};

interface Props {
	title: string;
	items: BlogTaxonomyLink[];
}

const { items, title } = Astro.props as Props;
---

{
	items.length > 0 && (
		<section
			class="rounded-[1.75rem] border border-(--page-border) bg-(--page-surface-solid) p-5 shadow-(--theme-shadow-soft)"
		>
			<h2 class="text-xs font-medium uppercase tracking-[0.2em] text-(--page-text-muted)">{title}</h2>
			<ul class="mt-4 grid gap-2">
				{items.map((item) => (
					<li>
						<a
							class:list={[
								"flex items-center justify-between rounded-2xl px-3 py-2 text-sm transition",
								item.active
									? "bg-(--page-surface-strong) text-(--theme-button-primary-text)"
									: "bg-(--page-surface-muted) text-(--page-text) hover:bg-[color-mix(in_srgb,var(--page-surface-muted)_88%,var(--page-border))] hover:text-(--page-text-strong)",
							]}
							href={item.href}
						>
							<span>{item.label}</span>
							<span
								class:list={[
									"rounded-full px-2 py-0.5 text-xs",
									item.active
										? "bg-[color-mix(in_srgb,var(--theme-button-primary-text)_14%,transparent)] text-(--theme-button-primary-text)"
										: "bg-(--page-surface-solid) text-(--page-text-muted)",
								]}
							>
								{item.count}
							</span>
						</a>
					</li>
				))}
			</ul>
		</section>
	)
}
