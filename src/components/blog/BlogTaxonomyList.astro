---
export type BlogTaxonomyLink = {
	active?: boolean;
	count: number;
	href: string;
	label: string;
};

interface Props {
	title: string;
	items: BlogTaxonomyLink[];
}

const { items, title } = Astro.props as Props;
---

{
	items.length > 0 && (
		<section class="rounded-[1.75rem] border border-slate-200 bg-white p-5 shadow-[0_18px_50px_rgba(15,23,42,0.05)]">
			<h2 class="text-xs font-medium uppercase tracking-[0.2em] text-slate-500">{title}</h2>
			<ul class="mt-4 grid gap-2">
				{items.map((item) => (
					<li>
						<a
							class:list={[
								"flex items-center justify-between rounded-2xl px-3 py-2 text-sm transition",
								item.active
									? "bg-slate-950 text-white"
									: "bg-slate-50 text-slate-700 hover:bg-slate-100 hover:text-slate-950",
							]}
							href={item.href}
						>
							<span>{item.label}</span>
							<span
								class:list={[
									"rounded-full px-2 py-0.5 text-xs",
									item.active ? "bg-white/10 text-white" : "bg-white text-slate-500",
								]}
							>
								{item.count}
							</span>
						</a>
					</li>
				))}
			</ul>
		</section>
	)
}
