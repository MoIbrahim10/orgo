---
import { getContactPageContent } from "../../data/translations/contact";
import type { Language } from "../../types/translations";
import { t } from "../../utils/i18n";
import { getEditorialArchiveCopy } from "../../utils/blogVariants";

interface Props {
	lang: Language;
	rssHref: string;
}

const { lang, rssHref } = Astro.props as Props;
const contact = getContactPageContent(lang);
const copy = getEditorialArchiveCopy(lang);
const mailtoBase = `mailto:${contact.emailValue}`;
---

<section class="blog-subscribe-band" aria-labelledby="blog-subscribe-heading">
	<div class="blog-subscribe-band__copy">
		<p class="blog-subscribe-band__eyebrow">{t(lang, "blog.newsletter_title")}</p>
		<h2 class="blog-subscribe-band__title" id="blog-subscribe-heading">
			{t(lang, "blog.newsletter_title")}
		</h2>
		<p class="blog-subscribe-band__lede">{t(lang, "blog.newsletter_description")}</p>
		<ul class="blog-subscribe-band__points">
			{copy.newsletterPoints.map((point) => (
				<li>{point}</li>
			))}
		</ul>
	</div>

	<div class="blog-subscribe-band__panel">
		<form
			class="blog-subscribe-band__form"
			data-blog-subscribe
			data-mail-body={t(lang, "blog.newsletter_mail_body")}
			data-mail-subject={t(lang, "blog.newsletter_mail_subject")}
			data-mailto-base={mailtoBase}
			novalidate
		>
			<label class="blog-subscribe-band__label" for="blog-subscribe-email">
				{t(lang, "blog.newsletter_placeholder")}
			</label>
			<div class="blog-subscribe-band__field-row">
				<input
					autocomplete="email"
					class="blog-subscribe-band__input"
					id="blog-subscribe-email"
					inputmode="email"
					name="email"
					placeholder={t(lang, "blog.newsletter_placeholder")}
					required
					type="email"
				/>
				<button class="blog-subscribe-band__submit" type="submit">
					{t(lang, "blog.newsletter_cta")}
				</button>
			</div>
		</form>
		<p class="blog-subscribe-band__note">{copy.newsletterNote}</p>
		<p class="blog-subscribe-band__fine">
			{t(lang, "blog.newsletter_fine_print")}{" "}
			<a class="blog-subscribe-band__rss" href={rssHref}>{t(lang, "blog.newsletter_rss_link")}</a>
		</p>
	</div>
</section>

<script>
	function bindBlogNewsletterForms() {
		const forms = document.querySelectorAll<HTMLFormElement>("[data-blog-subscribe]");
		for (const form of forms) {
			if (form.dataset.blogNewsletterBound === "1") {
				continue;
			}
			form.dataset.blogNewsletterBound = "1";
			form.addEventListener("submit", (event) => {
				event.preventDefault();
				const data = new FormData(form);
				const email = String(data.get("email") ?? "").trim();
				if (!email) {
					return;
				}
				const subject = form.dataset.mailSubject ?? "";
				const bodyTemplate = form.dataset.mailBody ?? "";
				const body = bodyTemplate.replaceAll("{email}", email);
				const action = form.dataset.mailtoBase;
				if (!action) {
					return;
				}
				window.location.href = `${action}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
			});
		}
	}

	bindBlogNewsletterForms();
	document.addEventListener("astro:page-load", bindBlogNewsletterForms);
</script>

<style>
	.blog-subscribe-band {
		--subscribe-accent: var(--action-link-primary-gradient-end);
		--subscribe-input-surface: color-mix(in srgb, var(--page-surface-solid) 93%, var(--page-surface-muted));
		--subscribe-input-border: color-mix(in srgb, var(--page-border-strong) 55%, transparent);
		--subscribe-input-placeholder: color-mix(in srgb, var(--page-text-muted) 78%, var(--page-text-soft));

		background: var(--page-bg);
		display: grid;
		gap: clamp(1.5rem, 3vw, 2.75rem);
		margin-inline: calc(50% - 50vw);
		overflow: clip;
		padding-block: clamp(2.25rem, 5.5vw, 4.8rem);
		padding-inline: max(
			var(--blog-page-inline, var(--layout-gutter)),
			calc((100vw - var(--blog-page-max-shell, var(--layout-width-navbar))) / 2 + var(--blog-page-inline, var(--layout-gutter)))
		);
		position: relative;
	}

	.blog-subscribe-band__copy,
	.blog-subscribe-band__panel,
	.blog-subscribe-band__form {
		display: grid;
		gap: 0.95rem;
	}

	.blog-subscribe-band__eyebrow {
		color: var(--page-text-muted);
		font-size: 0.72rem;
		font-weight: 650;
		letter-spacing: 0;
		line-height: 1.45;
		margin: 0;
		text-transform: uppercase;
	}

	.blog-subscribe-band__title {
		color: var(--page-text-strong);
		font-family: var(--font-display-latin), var(--font-display-arabic), serif;
		font-size: clamp(2.35rem, 6vw, 5.4rem);
		font-weight: 600;
		letter-spacing: 0;
		line-height: 0.9;
		margin: 0;
		max-width: 10ch;
		text-wrap: balance;
	}

	.blog-subscribe-band__lede,
	.blog-subscribe-band__note,
	.blog-subscribe-band__fine,
	.blog-subscribe-band__points li {
		color: var(--page-text-soft);
		font-size: clamp(0.98rem, 1.15vw, 1.05rem);
		line-height: 1.76;
		margin: 0;
	}

	.blog-subscribe-band__points {
		display: grid;
		gap: 0.72rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.blog-subscribe-band__points li {
		display: grid;
		gap: 0.55rem;
		grid-template-columns: auto minmax(0, 1fr);
	}

	.blog-subscribe-band__points li::before {
		background: var(--page-text-muted);
		border-radius: 999px;
		content: "";
		height: 0.38rem;
		margin-top: 0.68rem;
		width: 0.38rem;
	}

	.blog-subscribe-band__label {
		height: 1px;
		margin: -1px;
		overflow: hidden;
		padding: 0;
		position: absolute;
		width: 1px;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}

	.blog-subscribe-band__field-row {
		display: grid;
		gap: 0.75rem;
	}

	.blog-subscribe-band__input {
		background: var(--subscribe-input-surface);
		border: 1px solid var(--subscribe-input-border);
		border-radius: 0.5rem;
		color: var(--page-text-strong);
		font-size: clamp(1rem, 1.5vw, 1.16rem);
		min-height: 3.85rem;
		min-width: 0;
		outline: none;
		padding: 0.95rem 1.1rem;
	}

	.blog-subscribe-band__input::placeholder {
		color: var(--subscribe-input-placeholder);
	}

	.blog-subscribe-band__input:focus-visible {
		background:
			linear-gradient(var(--subscribe-input-surface), var(--subscribe-input-surface)) padding-box,
			linear-gradient(
					135deg,
					var(--action-link-primary-gradient-start),
					var(--action-link-primary-gradient-middle),
					var(--action-link-primary-gradient-end)
				)
				border-box;
		border-color: transparent;
		box-shadow: 0 0 0 2px color-mix(in srgb, var(--subscribe-accent) 18%, transparent);
	}

	html[data-theme="dark"] .blog-subscribe-band {
		--subscribe-input-surface: color-mix(in srgb, var(--page-surface-strong) 82%, #030303);
		--subscribe-input-border: color-mix(in srgb, var(--page-border-strong) 46%, transparent);
		--subscribe-input-placeholder: color-mix(in srgb, var(--page-text-muted) 86%, var(--page-text-soft));
	}

	.blog-subscribe-band__submit {
		background: linear-gradient(
			135deg,
			var(--action-link-primary-gradient-start),
			var(--action-link-primary-gradient-middle),
			var(--action-link-primary-gradient-end)
		);
		border: 0;
		border-radius: 0.5rem;
		color: oklch(98% 0 0deg);
		cursor: pointer;
		font-size: clamp(0.98rem, 1.5vw, 1.08rem);
		font-weight: 650;
		min-height: 3.85rem;
		padding: 0.95rem 1.35rem;
		transition: transform 160ms ease, filter 160ms ease;
	}

	.blog-subscribe-band__submit:hover,
	.blog-subscribe-band__submit:focus-visible {
		filter: brightness(1.05);
		outline: none;
		transform: translateY(-1px);
	}

	.blog-subscribe-band__submit:active {
		transform: translateY(0);
	}

	.blog-subscribe-band__rss {
		color: var(--page-text-strong);
		text-decoration: underline;
		text-decoration-color: color-mix(in srgb, var(--page-text-strong) 34%, transparent);
		text-underline-offset: 0.18em;
	}

	.blog-subscribe-band__rss:hover,
	.blog-subscribe-band__rss:focus-visible {
		text-decoration-color: currentColor;
	}

	@media (min-width: 760px) {
		.blog-subscribe-band__field-row {
			align-items: stretch;
			grid-template-columns: minmax(0, 1fr) auto;
		}
	}

	@media (min-width: 980px) {
		.blog-subscribe-band {
			align-items: center;
			grid-template-columns: minmax(0, 0.92fr) minmax(22rem, 1fr);
			min-height: clamp(28rem, 42vw, 38rem);
		}

		.blog-subscribe-band::before {
			background: color-mix(in srgb, var(--page-border) 58%, transparent);
			content: "";
			height: min(78%, 31rem);
			inset-block: 50% auto;
			inset-inline-start: calc(50% - 0.5px);
			position: absolute;
			transform: translateY(-50%);
			width: 1px;
		}

		.blog-subscribe-band__panel {
			align-content: center;
			margin-inline-start: clamp(1.5rem, 4vw, 3.25rem);
			min-height: clamp(18rem, 30vw, 27rem);
			position: relative;
			z-index: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.blog-subscribe-band__submit {
			transition: none;
		}
	}
</style>
