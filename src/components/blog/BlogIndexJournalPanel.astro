---
import type { Language } from "../../types/translations";
import { t } from "../../utils/i18n";

interface Props {
	lang: Language;
}

const { lang } = Astro.props as Props;
const pillars = [
	{ title: t(lang, "blog.index_pillar_1_title"), body: t(lang, "blog.index_pillar_1_body") },
	{ title: t(lang, "blog.index_pillar_2_title"), body: t(lang, "blog.index_pillar_2_body") },
	{ title: t(lang, "blog.index_pillar_3_title"), body: t(lang, "blog.index_pillar_3_body") },
];
---

<section class="blog-journal-panel" aria-labelledby="blog-journal-panel-heading">
	<div class="blog-journal-panel__intro">
		<p class="blog-journal-panel__eyebrow">{t(lang, "blog.index_panel_title")}</p>
		<h2 class="blog-journal-panel__title" id="blog-journal-panel-heading">
			{t(lang, "blog.index_panel_title")}
		</h2>
		<p class="blog-journal-panel__lead">{t(lang, "blog.index_panel_lead")}</p>
	</div>

	<ol class="blog-journal-panel__list">
		{
			pillars.map((pillar, index) => (
				<li class="blog-journal-panel__item">
					<p class="blog-journal-panel__number">{String(index + 1).padStart(2, "0")}</p>
					<div class="blog-journal-panel__copy">
						<h3 class="blog-journal-panel__item-title">{pillar.title}</h3>
						<p class="blog-journal-panel__item-body">{pillar.body}</p>
					</div>
				</li>
			))
		}
	</ol>
</section>

<style>
	.blog-journal-panel {
		background:
			radial-gradient(
				circle at 16% 8%,
				color-mix(in srgb, var(--action-link-primary-gradient-start) 18%, transparent),
				transparent 20rem
			);
		color: var(--page-text-strong);
		display: grid;
		gap: clamp(1.45rem, 3vw, 2.6rem);
		margin-inline: calc(50% - 50vw);
		overflow: clip;
		padding-block: clamp(2.3rem, 5.5vw, 4.8rem);
		padding-inline: max(
			var(--blog-page-inline, var(--layout-gutter)),
			calc((100vw - var(--blog-page-max-shell, var(--layout-width-navbar))) / 2 + var(--blog-page-inline, var(--layout-gutter)))
		);
		position: relative;
	}

	.blog-journal-panel__intro,
	.blog-journal-panel__copy {
		display: grid;
		gap: 0.72rem;
	}

	.blog-journal-panel__eyebrow,
	.blog-journal-panel__number {
		color: var(--page-text-muted);
		font-size: 0.72rem;
		font-weight: 650;
		letter-spacing: 0;
		line-height: 1.45;
		margin: 0;
		text-transform: uppercase;
	}

	.blog-journal-panel__title {
		color: var(--page-text-strong);
		font-family: var(--font-display-latin), var(--font-display-arabic), serif;
		font-size: clamp(3rem, 7vw, 5.9rem);
		font-weight: 600;
		letter-spacing: 0;
		line-height: 0.9;
		margin: 0;
		text-wrap: balance;
	}

	.blog-journal-panel__lead,
	.blog-journal-panel__item-body {
		color: var(--page-text-soft);
		font-size: clamp(1rem, 1.25vw, 1.1rem);
		line-height: 1.78;
		margin: 0;
		max-width: 66ch;
	}

	.blog-journal-panel__list {
		display: grid;
		gap: 0.9rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.blog-journal-panel__item {
		background:
			linear-gradient(145deg, color-mix(in srgb, var(--card-accent) 28%, transparent), transparent 70%),
			color-mix(in srgb, white 6%, transparent);
		border: 1px solid color-mix(in srgb, var(--card-accent) 38%, transparent);
		border-radius: 0.5rem;
		box-shadow: 0 1.25rem 3rem color-mix(in srgb, #000 24%, transparent);
		display: grid;
		gap: 0.8rem;
		min-height: clamp(12rem, 17vw, 15rem);
		padding: clamp(1rem, 2vw, 1.35rem);
	}

	.blog-journal-panel__item:nth-child(1) {
		--card-accent: var(--action-link-primary-gradient-start);
	}

	.blog-journal-panel__item:nth-child(2) {
		--card-accent: var(--action-link-primary-gradient-middle);
	}

	.blog-journal-panel__item:nth-child(3) {
		--card-accent: var(--action-link-primary-gradient-end);
	}

	.blog-journal-panel__number {
		color: color-mix(in srgb, var(--card-accent) 72%, var(--page-text-strong));
		font-family: var(--font-display-latin), var(--font-display-arabic), serif;
		font-size: clamp(2.4rem, 5vw, 4.2rem);
		line-height: 1;
	}

	.blog-journal-panel__item-title {
		color: var(--page-text-strong);
		font-size: clamp(1.22rem, 2vw, 1.6rem);
		font-weight: 650;
		letter-spacing: 0;
		line-height: 1.08;
		margin: 0;
	}

	@media (min-width: 760px) {
		.blog-journal-panel__list {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
