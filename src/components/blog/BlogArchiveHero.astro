---
import { getLocaleConfig } from "../../data/site";
import type { Language } from "../../types/translations";
import type { EditorialArchiveCopy, EditorialPost } from "../../utils/blogVariants";
import { t } from "../../utils/i18n";
import type { BreadcrumbItem } from "../ui/Breadcrumbs.astro";

interface Props {
	breadcrumbs?: BreadcrumbItem[];
	copy: EditorialArchiveCopy;
	description: string;
	eyebrow?: string;
	featuredStory?: EditorialPost;
	lang: Language;
	metrics?: {
		categoryCount: number;
		postCount: number;
		topicCount: number;
	};
	title: string;
}

const {
	breadcrumbs = [],
	description,
	eyebrow,
	lang,
	metrics,
	title,
} = Astro.props as Props;

const numberFormatter = new Intl.NumberFormat(getLocaleConfig(lang).numberLocale);
const metricItems = metrics
	? [
			{
				label: t(lang, "blog.index_metric_posts_label"),
				value: numberFormatter.format(metrics.postCount),
			},
			{
				label: t(lang, "blog.index_metric_categories_label"),
				value: numberFormatter.format(metrics.categoryCount),
			},
			{
				label: t(lang, "blog.index_metric_topics_label"),
				value: numberFormatter.format(metrics.topicCount),
			},
		]
	: [];
---

<section class="blog-hero">
	{breadcrumbs.length > 0 && (
		<nav aria-label="Breadcrumb" class="blog-hero__breadcrumbs">
			<ol class="blog-hero__breadcrumbs-list">
				{breadcrumbs.map((item, breadcrumbIndex) => (
					<li class="blog-hero__breadcrumbs-item">
						{breadcrumbIndex > 0 && <span aria-hidden="true">/</span>}
						{item.href ? (
							<a href={item.href}>{item.label}</a>
						) : (
							<span aria-current="page">{item.label}</span>
						)}
					</li>
				))}
			</ol>
		</nav>
	)}

	<div class="blog-hero__layout">
		<div class="blog-hero__main">
			{eyebrow && <p class="blog-hero__eyebrow">{eyebrow}</p>}
			<h1 class="blog-hero__title">{title}</h1>
			<p class="blog-hero__description">{description}</p>
			{
				metricItems.length > 0 && (
					<ul class="blog-hero__metrics" aria-label="Archive metrics">
						{metricItems.map((metric) => (
							<li class="blog-hero__metric">
								<p class="blog-hero__metric-value">{metric.value}</p>
								<p class="blog-hero__metric-label">{metric.label}</p>
							</li>
						))}
					</ul>
				)
			}
		</div>
	</div>
</section>

<style>
	.blog-hero {
		background:
			radial-gradient(
				circle at 50% 0,
				color-mix(in srgb, var(--action-link-primary-gradient-middle) 8%, transparent),
				transparent 28rem
			),
			linear-gradient(
				180deg,
				color-mix(in srgb, var(--page-surface-muted) 26%, var(--page-bg)),
				var(--page-bg) 88%
			);
		border-block: 1px solid color-mix(in srgb, var(--page-border) 55%, transparent);
		box-shadow: none;
		display: grid;
		gap: clamp(0.85rem, 2vw, 1.2rem);
		margin-inline: calc(50% - 50vw);
		overflow: clip;
		padding-block: clamp(1.75rem, 5vw, 3.6rem);
		padding-inline: max(
			var(--blog-page-inline, var(--layout-gutter)),
			calc((100vw - var(--blog-page-max-shell, var(--layout-width-navbar))) / 2 + var(--blog-page-inline, var(--layout-gutter)))
		);
		position: relative;
	}

	.blog-hero::after {
		background:
			linear-gradient(color-mix(in srgb, var(--page-border) 22%, transparent) 1px, transparent 1px),
			linear-gradient(90deg, color-mix(in srgb, var(--page-border) 18%, transparent) 1px, transparent 1px);
		background-size: 5rem 5rem;
		content: "";
		inset: 0;
		mask-image: linear-gradient(180deg, black, transparent 70%);
		opacity: 0.2;
		pointer-events: none;
		position: absolute;
	}

	.blog-hero__breadcrumbs,
	.blog-hero__layout {
		position: relative;
		z-index: 1;
	}

	.blog-hero__breadcrumbs-list {
		align-items: center;
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem 0.65rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.blog-hero__breadcrumbs-item {
		align-items: center;
		color: var(--page-text-muted);
		display: flex;
		gap: 0.45rem;
	}

	.blog-hero__breadcrumbs-item a {
		color: inherit;
		text-decoration: none;
		transition: color 160ms ease;
	}

	.blog-hero__breadcrumbs-item a:hover,
	.blog-hero__breadcrumbs-item a:focus-visible {
		color: var(--page-text-strong);
		outline: none;
	}

	.blog-hero__layout {
		display: grid;
		gap: clamp(0.95rem, 2vw, 1.35rem);
		justify-items: center;
		text-align: center;
	}

	.blog-hero__main {
		display: grid;
		gap: 0.85rem;
	}

	.blog-hero__main {
		justify-items: center;
		max-width: 62rem;
	}

	.blog-hero__eyebrow,
	.blog-hero__metric-label {
		color: var(--page-text-muted);
		font-size: 0.76rem;
		font-weight: 600;
		letter-spacing: 0;
		line-height: 1.45;
		margin: 0;
		text-transform: uppercase;
	}

	.blog-hero__title {
		color: var(--page-text-strong);
		font-family: var(--font-display-latin), var(--font-display-arabic), serif;
		font-size: clamp(2.3rem, 8.5vw, 4.7rem);
		font-weight: 600;
		letter-spacing: 0;
		line-height: 0.9;
		margin: 0;
		max-width: 13ch;
		text-wrap: balance;
	}

	.blog-hero__description {
		color: var(--page-text-soft);
		font-size: clamp(0.95rem, 1.2vw, 1.08rem);
		line-height: 1.65;
		margin: 0;
		max-width: 64ch;
	}

	.blog-hero__metrics {
		display: grid;
		gap: 0.55rem;
		list-style: none;
		margin: clamp(0.05rem, 0.4vw, 0.2rem) 0 0;
		padding: 0;
		width: 100%;
	}

	.blog-hero__metric {
		border-top: 1px solid color-mix(in srgb, var(--page-border) 42%, transparent);
		display: grid;
		gap: 0.28rem;
		padding-top: 0.55rem;
	}

	.blog-hero__metric-value {
		color: var(--page-text-strong);
		font-family: var(--font-display-latin), var(--font-display-arabic), serif;
		font-size: clamp(1.25rem, 2.1vw, 1.9rem);
		font-weight: 600;
		line-height: 0.92;
		margin: 0;
	}

	@media (min-width: 720px) {
		.blog-hero__metrics {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (max-width: 719px) {
		.blog-hero__title {
			font-size: clamp(2.4rem, 14vw, 3.5rem);
		}
	}
</style>
