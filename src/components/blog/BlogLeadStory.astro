---
import type { CollectionEntry } from "astro:content";
import ResponsiveMedia from "../common/ResponsiveMedia.astro";
import ActionLink from "../ui/ActionLink.astro";
import { getBlogCoverImage } from "../../data/media";
import { formatLocalizedDate } from "../../data/site";
import type { Language } from "../../types/translations";
import {
	getBlogCategoryPath,
	getBlogEntrySlug,
	getBlogPostPath,
	getCategorySlug,
} from "../../utils/blog";
import { t } from "../../utils/i18n";

interface Props {
	post: CollectionEntry<"blog">;
	lang: Language;
	authorName?: string;
}

const { authorName, lang, post } = Astro.props as Props;
const href = getBlogPostPath(lang, getBlogEntrySlug(post));
const coverImage = getBlogCoverImage(post.data.translationGroup);
---

<article class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-[0_24px_70px_rgba(15,23,42,0.08)]">
	<div class="grid gap-0 lg:grid-cols-[minmax(0,1.1fr)_minmax(22rem,0.9fr)]">
		<a class="min-h-full bg-slate-50" href={href}>
			<ResponsiveMedia
				alt={post.data.image.alt}
				imgClass="h-full w-full object-cover"
				loading="eager"
				sizes="(max-width: 1024px) 100vw, 720px"
				src={coverImage}
				widths={[640, 960, 1280]}
			/>
		</a>
		<div class="flex flex-col justify-between gap-6 p-8">
			<div class="space-y-5">
				<div class="flex flex-wrap items-center gap-3 text-xs font-medium uppercase tracking-[0.2em] text-slate-500">
					<a
						class="rounded-full bg-slate-950 px-3 py-1 text-white transition hover:bg-slate-800"
						href={getBlogCategoryPath(lang, getCategorySlug(post.data.category))}
					>
						{post.data.category}
					</a>
					<time datetime={post.data.publishDate.toISOString()}>
						{formatLocalizedDate(lang, post.data.publishDate, { dateStyle: "medium" })}
					</time>
				</div>
				<h2 class="font-display text-4xl font-semibold tracking-tight text-slate-950 sm:text-[2.7rem] sm:leading-[1.08]">
					<a class="transition hover:text-slate-700" href={href}>
						{post.data.title}
					</a>
				</h2>
				<p class="text-lg leading-8 text-slate-600">{post.data.metaDescription}</p>
			</div>
			<div class="flex flex-col gap-4 border-t border-slate-200 pt-5 sm:flex-row sm:items-center sm:justify-between">
				<div>
					<p class="text-xs font-medium uppercase tracking-[0.18em] text-slate-500">
						{t(lang, "blog.by")}
					</p>
					<p class="mt-2 text-base font-medium text-slate-900">
						{authorName ?? t(lang, "blog.unknown_author")}
					</p>
				</div>
				<ActionLink href={href} variant="primary">
					{t(lang, "blog.read_article")}
				</ActionLink>
			</div>
		</div>
	</div>
</article>
