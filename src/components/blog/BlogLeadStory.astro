---
import BlogCoverMedia from "./BlogCoverMedia.astro";
import ActionLink from "../ui/ActionLink.astro";
import type { Language } from "../../types/translations";
import { t } from "../../utils/i18n";
import type { EditorialArchiveCopy, EditorialPost } from "../../utils/blogVariants";

interface Props {
	copy: EditorialArchiveCopy;
	lang: Language;
	story: EditorialPost;
}

const { copy, lang, story } = Astro.props as Props;
---

<article class:list={["blog-lead-story", "blog-lead-story--atlas"]}>
	<div class="blog-lead-story__glow" aria-hidden="true"></div>
	<div class="blog-lead-story__grid">
		<a class="blog-lead-story__media" href={story.href}>
			<BlogCoverMedia
				alt={story.imageAlt}
				fetchpriority="high"
				imgClass="blog-lead-story__img"
				loading="eager"
				sizes="(max-width: 767px) 100vw, (max-width: 1120px) 56vw, 720px"
				translationGroup={story.translationGroup}
				widths={[640, 960, 1280]}
				wrapperClass="h-full rounded-[inherit]"
			/>
		</a>

		<div class="blog-lead-story__body">
			<div class="blog-lead-story__meta">
				<a class="blog-lead-story__category" href={story.categoryHref}>
					{story.entry.data.category}
				</a>
				<span>{story.readingTimeLabel}</span>
				<span>
					{copy.publishedLabel} {story.publishedLabel}
				</span>
			</div>

			<div class="blog-lead-story__copy">
				<h2 class="blog-lead-story__title">
					<a class="blog-lead-story__title-link" href={story.href}>
						{story.title}
					</a>
				</h2>
				<p class="blog-lead-story__deck">{story.deck}</p>
			</div>

			<div class="blog-lead-story__details">
				<div>
					<p class="blog-lead-story__section-label">{copy.authorLabel}</p>
					<p class="blog-lead-story__detail">{story.authorName}</p>
				</div>
			</div>

			{story.tagLinks.length > 0 && (
				<ul class="blog-lead-story__tags" aria-label={t(lang, "blog.topics_title")}>
					{story.tagLinks.map((tag) => (
						<li>
							<a class="blog-lead-story__tag" href={tag.href}>
								#{tag.label}
							</a>
						</li>
					))}
				</ul>
			)}

			<footer class="blog-lead-story__footer">
				<div class="blog-lead-story__author-note">
					{story.authorSummary ?? story.authorRole ?? story.context}
				</div>
				<ActionLink href={story.href} variant="secondary">
					{t(lang, "blog.read_article")}
				</ActionLink>
			</footer>
		</div>
	</div>
</article>

<style>
	.blog-lead-story {
		background: color-mix(in srgb, var(--page-surface-muted) 82%, transparent);
		border: 1px solid color-mix(in srgb, var(--page-border) 56%, transparent);
		border-radius: 0.9rem;
		padding: clamp(0.95rem, 2.3vw, 1.4rem);
		position: relative;
	}

	.blog-lead-story__glow {
		display: none;
	}

	.blog-lead-story__grid {
		display: grid;
		gap: clamp(1rem, 2vw, 1.35rem);
	}

	.blog-lead-story__media {
		aspect-ratio: 16 / 10;
		border-radius: 0.7rem;
		display: block;
		overflow: hidden;
		position: relative;
		transition: filter 180ms ease;
		will-change: filter;
	}

	.blog-lead-story__media:hover,
	.blog-lead-story__media:focus-visible {
		filter: saturate(1.02) brightness(1.01);
		outline: none;
	}

	.blog-lead-story__body {
		display: grid;
		gap: 0.9rem;
	}

	.blog-lead-story__meta {
		align-items: center;
		color: var(--page-text-muted);
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem 0.95rem;
		font-size: 0.78rem;
		line-height: 1.55;
		margin: 0;
	}

	.blog-lead-story__section-label {
		color: var(--page-text-muted);
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1.4;
		margin: 0;
		text-transform: uppercase;
	}

	.blog-lead-story__category,
	.blog-lead-story__tag {
		align-items: center;
		color: var(--page-text-soft);
		display: inline-flex;
		font-size: 0.84rem;
		line-height: 1.3;
		text-decoration: none;
		transition: color 160ms ease, opacity 160ms ease;
	}

	.blog-lead-story__category:hover,
	.blog-lead-story__category:focus-visible,
	.blog-lead-story__tag:hover,
	.blog-lead-story__tag:focus-visible {
		color: var(--page-text-strong);
		outline: none;
	}

	.blog-lead-story__copy {
		display: grid;
		gap: 0.7rem;
	}

	.blog-lead-story__title {
		color: var(--page-text-strong);
		font-family: var(--font-display-latin), var(--font-display-arabic), serif;
		font-size: clamp(1.7rem, 3.8vw, 2.75rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.02;
		margin: 0;
		max-width: 16ch;
		text-wrap: balance;
	}

	.blog-lead-story__title-link {
		color: inherit;
		text-decoration: none;
		transition: color 160ms ease;
	}

	.blog-lead-story__title-link:hover,
	.blog-lead-story__title-link:focus-visible {
		color: var(--page-text);
		outline: none;
	}

	.blog-lead-story__deck {
		color: var(--page-text);
		font-size: clamp(0.98rem, 1.4vw, 1.1rem);
		line-height: 1.68;
		margin: 0;
		max-width: 54ch;
	}

	.blog-lead-story__detail,
	.blog-lead-story__author-note {
		color: var(--page-text-soft);
		font-size: 0.92rem;
		line-height: 1.64;
		margin: 0;
		max-width: 62ch;
	}

	.blog-lead-story__details {
		display: grid;
		gap: 0.55rem;
	}

	.blog-lead-story__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 0.75rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.blog-lead-story__tag {
		background: color-mix(in srgb, var(--page-surface-solid) 86%, transparent);
		border: 1px solid color-mix(in srgb, var(--page-border) 46%, transparent);
		border-radius: 999px;
		padding: 0.26rem 0.58rem;
	}

	.blog-lead-story__footer {
		align-items: end;
		border-top: 1px solid color-mix(in srgb, var(--page-border) 45%, transparent);
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 1.5rem;
		justify-content: space-between;
		padding-top: 0.85rem;
	}

	.blog-lead-story__author-note {
		max-width: 42ch;
	}

	/* V1 ATLAS OVERLAY: shifted copy over image, right-aligned */
	.blog-lead-story--atlas {
		background: transparent;
		border: 0;
		padding: 0;
	}

	.blog-lead-story--atlas .blog-lead-story__media {
		aspect-ratio: 21 / 9;
		border-radius: 1rem;
	}

	.blog-lead-story--atlas .blog-lead-story__media::after {
		background: linear-gradient(
			90deg,
			color-mix(in srgb, #000 16%, transparent),
			color-mix(in srgb, #000 58%, transparent) 52%,
			color-mix(in srgb, #000 72%, transparent)
		);
		content: "";
		inset: 0;
		position: absolute;
		pointer-events: none;
	}

	.blog-lead-story--atlas .blog-lead-story__title,
	.blog-lead-story--atlas .blog-lead-story__title-link,
	.blog-lead-story--atlas .blog-lead-story__deck,
	.blog-lead-story--atlas .blog-lead-story__meta,
	.blog-lead-story--atlas .blog-lead-story__detail,
	.blog-lead-story--atlas .blog-lead-story__author-note,
	.blog-lead-story--atlas .blog-lead-story__section-label,
	.blog-lead-story--atlas .blog-lead-story__category,
	.blog-lead-story--atlas .blog-lead-story__tag {
		color: color-mix(in srgb, white 95%, var(--page-text-strong));
	}

	.blog-lead-story--atlas .blog-lead-story__tag {
		background: color-mix(in srgb, white 12%, transparent);
		border-color: color-mix(in srgb, white 28%, transparent);
	}

	.blog-lead-story--atlas .blog-lead-story__footer {
		border-top-color: color-mix(in srgb, white 20%, transparent);
	}

	.blog-lead-story--atlas:has(.blog-cover-media[data-cover-state="missing"]) .blog-lead-story__media::after {
		background: linear-gradient(
			180deg,
			color-mix(in srgb, var(--page-surface-strong) 28%, transparent),
			color-mix(in srgb, var(--page-surface-strong) 10%, transparent)
		);
	}

	.blog-lead-story--atlas:has(.blog-cover-media[data-cover-state="missing"]) .blog-lead-story__body,
	.blog-lead-story--atlas:has(.blog-cover-media[data-cover-state="missing"]) .blog-lead-story__title,
	.blog-lead-story--atlas:has(.blog-cover-media[data-cover-state="missing"]) .blog-lead-story__title-link,
	.blog-lead-story--atlas:has(.blog-cover-media[data-cover-state="missing"]) .blog-lead-story__deck,
	.blog-lead-story--atlas:has(.blog-cover-media[data-cover-state="missing"]) .blog-lead-story__meta,
	.blog-lead-story--atlas:has(.blog-cover-media[data-cover-state="missing"]) .blog-lead-story__detail,
	.blog-lead-story--atlas:has(.blog-cover-media[data-cover-state="missing"]) .blog-lead-story__author-note,
	.blog-lead-story--atlas:has(.blog-cover-media[data-cover-state="missing"]) .blog-lead-story__section-label,
	.blog-lead-story--atlas:has(.blog-cover-media[data-cover-state="missing"]) .blog-lead-story__category,
	.blog-lead-story--atlas:has(.blog-cover-media[data-cover-state="missing"]) .blog-lead-story__tag {
		color: var(--page-text-strong);
	}

	.blog-lead-story--atlas:has(.blog-cover-media[data-cover-state="missing"]) .blog-lead-story__tag {
		background: color-mix(in srgb, var(--page-surface-muted) 76%, transparent);
		border-color: color-mix(in srgb, var(--page-border) 46%, transparent);
		color: var(--page-text-soft);
	}

	.blog-lead-story--atlas:has(.blog-cover-media[data-cover-state="missing"]) .blog-lead-story__footer {
		border-top-color: color-mix(in srgb, var(--page-border) 45%, transparent);
	}

	@media (min-width: 820px) {
		.blog-lead-story__grid {
			align-items: start;
			grid-template-columns: minmax(0, 1.02fr) minmax(20rem, 0.98fr);
		}

		.blog-lead-story__body {
			padding-top: clamp(0.2rem, 1vw, 0.6rem);
		}

		.blog-lead-story--atlas .blog-lead-story__grid {
			grid-template-columns: minmax(0, 1fr);
			position: relative;
		}

		.blog-lead-story--atlas .blog-lead-story__body {
			background: color-mix(in srgb, #000 52%, transparent);
			backdrop-filter: blur(2px);
			border: 1px solid color-mix(in srgb, white 22%, transparent);
			border-radius: 0.9rem;
			gap: 0.8rem;
			grid-area: 1 / 1;
			justify-self: end;
			margin: clamp(1rem, 2.3vw, 1.8rem);
			padding: clamp(1rem, 2.1vw, 1.4rem);
			width: min(56%, 39rem);
			z-index: 1;
		}

		.blog-lead-story--atlas:has(.blog-cover-media[data-cover-state="missing"]) .blog-lead-story__body {
			backdrop-filter: none;
			background: color-mix(in srgb, var(--page-surface-muted) 82%, transparent);
			border-color: color-mix(in srgb, var(--page-border) 46%, transparent);
			grid-area: auto;
			margin: 0;
			justify-self: stretch;
			width: 100%;
		}

		.blog-lead-story--atlas .blog-lead-story__media {
			grid-area: 1 / 1;
			z-index: 0;
		}

		.blog-lead-story--atlas:has(.blog-cover-media[data-cover-state="missing"]) .blog-lead-story__media {
			display: none;
		}
	}

	@media (max-width: 819px) {
		.blog-lead-story--atlas .blog-lead-story__media::after {
			background: linear-gradient(
				180deg,
				color-mix(in srgb, #000 12%, transparent),
				color-mix(in srgb, #000 46%, transparent)
			);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.blog-lead-story__media {
			transition: none;
		}
	}
</style>
