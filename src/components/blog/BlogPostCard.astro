---
import BlogCoverMedia from "./BlogCoverMedia.astro";
import ActionLink from "../ui/ActionLink.astro";
import type { Language } from "../../types/translations";
import { t } from "../../utils/i18n";
import type { EditorialArchiveCopy, EditorialPost } from "../../utils/blogVariants";

interface Props {
	copy: EditorialArchiveCopy;
	lang: Language;
	reverse?: boolean;
	story: EditorialPost;
	tone?: "note" | "river" | "spotlight";
}

const { copy, lang, reverse = false, story, tone = "river" } = Astro.props as Props;
const showImage = tone !== "note";
const intro = tone === "spotlight" ? story.deck : story.summary;
const body = tone === "note" ? story.takeaway : story.excerpt;
---

<article class:list={["blog-post-card", `blog-post-card--${tone}`, reverse && "is-reverse"]}>
	{
		showImage && (
			<a class="blog-post-card__media" href={story.href}>
				<BlogCoverMedia
					alt={story.imageAlt}
					imgClass="blog-post-card__img"
					loading="lazy"
					sizes="(max-width: 767px) 100vw, (max-width: 1120px) 42vw, 480px"
					translationGroup={story.translationGroup}
					widths={[480, 720, 960]}
					wrapperClass="h-full rounded-[inherit]"
				/>
			</a>
		)
	}

	<div class="blog-post-card__body">
		<div class="blog-post-card__meta">
			<span class="blog-post-card__sequence">{story.sequence}</span>
			<a class="blog-post-card__category" href={story.categoryHref}>
				{story.entry.data.category}
			</a>
			<span>{story.readingTimeLabel}</span>
		</div>

		<div class="blog-post-card__copy">
			<h3 class="blog-post-card__title">
				<a class="blog-post-card__title-link" href={story.href}>
					{story.title}
				</a>
			</h3>
			<p class="blog-post-card__intro">{intro}</p>
			<p class="blog-post-card__body-text">{body}</p>
		</div>

		<div class="blog-post-card__details">
			<p class="blog-post-card__context">
				<span>{copy.contextLabel}</span>
				{story.context}
			</p>
			{story.tagLinks.length > 0 && (
				<ul class="blog-post-card__tags" aria-label={t(lang, "blog.topics_title")}>
					{story.tagLinks.slice(0, tone === "spotlight" ? 3 : 2).map((tag) => (
						<li>
							<a class="blog-post-card__tag" href={tag.href}>
								#{tag.label}
							</a>
						</li>
					))}
				</ul>
			)}
		</div>

		<footer class="blog-post-card__footer">
			<div>
				<p class="blog-post-card__author">{story.authorName}</p>
				<p class="blog-post-card__date">
					{copy.publishedLabel} {story.publishedLabel}
				</p>
			</div>
			<ActionLink href={story.href} size="sm" variant="secondary">
				{t(lang, "blog.read_article")}
			</ActionLink>
		</footer>
	</div>
</article>

<style>
	.blog-post-card {
		display: grid;
		gap: 1rem;
		padding-block: clamp(1.25rem, 2.6vw, 1.9rem);
	}

	.blog-post-card + .blog-post-card {
		border-top: 1px solid color-mix(in srgb, var(--page-border) 58%, transparent);
	}

	.blog-post-card__media {
		aspect-ratio: 5 / 4;
		border-radius: 0.5rem;
		display: block;
		overflow: hidden;
		position: relative;
		transition: transform 220ms ease, filter 220ms ease;
	}

	.blog-post-card__media:hover,
	.blog-post-card__media:focus-visible {
		filter: saturate(1.04);
		outline: none;
		transform: translateY(-2px);
	}

	.blog-post-card__img {
		min-height: 100%;
	}

	.blog-post-card__body {
		display: grid;
		gap: 0.95rem;
	}

	.blog-post-card__meta {
		align-items: center;
		color: var(--page-text-muted);
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem 0.85rem;
		font-size: 0.76rem;
		line-height: 1.5;
	}

	.blog-post-card__sequence,
	.blog-post-card__context span {
		color: var(--page-text-muted);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.blog-post-card__category,
	.blog-post-card__tag {
		color: var(--page-text-soft);
		text-decoration: none;
		transition: color 160ms ease;
	}

	.blog-post-card__category:hover,
	.blog-post-card__category:focus-visible,
	.blog-post-card__tag:hover,
	.blog-post-card__tag:focus-visible {
		color: var(--page-text-strong);
		outline: none;
	}

	.blog-post-card__copy {
		display: grid;
		gap: 0.7rem;
	}

	.blog-post-card__title {
		color: var(--page-text-strong);
		font-family: var(--font-display-latin), var(--font-display-arabic), serif;
		font-size: clamp(1.7rem, 3.8vw, 2.65rem);
		font-weight: 600;
		letter-spacing: -0.03em;
		line-height: 1.03;
		margin: 0;
		max-width: 14ch;
		text-wrap: balance;
	}

	.blog-post-card__title-link {
		color: inherit;
		text-decoration: none;
		transition: color 160ms ease;
	}

	.blog-post-card__title-link:hover,
	.blog-post-card__title-link:focus-visible {
		color: var(--page-text);
		outline: none;
	}

	.blog-post-card__intro {
		color: var(--page-text);
		font-size: 1.02rem;
		line-height: 1.72;
		margin: 0;
		max-width: 46ch;
	}

	.blog-post-card__body-text,
	.blog-post-card__context,
	.blog-post-card__date {
		color: var(--page-text-soft);
		font-size: 0.96rem;
		line-height: 1.72;
		margin: 0;
		max-width: 54ch;
	}

	.blog-post-card__details {
		display: grid;
		gap: 0.9rem;
	}

	.blog-post-card__context {
		display: grid;
		gap: 0.25rem;
	}

	.blog-post-card__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem 0.85rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.blog-post-card__footer {
		align-items: end;
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem 1rem;
		justify-content: space-between;
		padding-top: 0.15rem;
	}

	.blog-post-card__author {
		color: var(--page-text-strong);
		font-size: 0.95rem;
		font-weight: 600;
		line-height: 1.45;
		margin: 0;
	}

	.blog-post-card--spotlight {
		background:
			linear-gradient(
				180deg,
				color-mix(in srgb, var(--page-surface-muted) 78%, var(--page-bg)),
				transparent 72%
			);
		border-radius: 0.5rem;
		padding: clamp(1rem, 2vw, 1.35rem);
	}

	.blog-post-card--spotlight + .blog-post-card,
	.blog-post-card--river + .blog-post-card--spotlight,
	.blog-post-card--note + .blog-post-card--spotlight {
		border-top-color: transparent;
	}

	.blog-post-card--note {
		grid-template-columns: minmax(0, 1fr);
	}

	.blog-post-card--note .blog-post-card__title {
		font-size: clamp(2rem, 4.2vw, 3.1rem);
		max-width: 12ch;
	}

	@media (min-width: 820px) {
		.blog-post-card--spotlight,
		.blog-post-card--river {
			align-items: start;
			grid-template-columns: minmax(15rem, 0.78fr) minmax(0, 1fr);
			gap: 1.35rem;
		}

		.blog-post-card.is-reverse {
			grid-template-columns: minmax(0, 1fr) minmax(15rem, 0.78fr);
		}

		.blog-post-card.is-reverse .blog-post-card__media {
			order: 2;
		}

		.blog-post-card.is-reverse .blog-post-card__body {
			order: 1;
		}

		.blog-post-card--spotlight .blog-post-card__title {
			font-size: clamp(2rem, 3vw, 2.7rem);
		}

		.blog-post-card--note .blog-post-card__details,
		.blog-post-card--note .blog-post-card__footer {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.blog-post-card__media {
			transition: none;
		}
	}
</style>
