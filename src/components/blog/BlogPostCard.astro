---
import type { CollectionEntry } from "astro:content";
import ResponsiveMedia from "../common/ResponsiveMedia.astro";
import ActionLink from "../ui/ActionLink.astro";
import { getBlogCoverImage } from "../../data/media";
import { formatLocalizedDate } from "../../data/site";
import type { Language } from "../../types/translations";
import { t } from "../../utils/i18n";
import {
	getBlogCategoryPath,
	getBlogPostPath,
	getBlogTagPath,
	getBlogEntrySlug,
	getTagSlug,
	getCategorySlug,
} from "../../utils/blog";

interface Props {
	post: CollectionEntry<"blog">;
	lang: Language;
	authorName?: string;
	priority?: boolean;
}

const { authorName, lang, post, priority = false } = Astro.props as Props;
const href = getBlogPostPath(lang, getBlogEntrySlug(post));
const coverImage = getBlogCoverImage(post.data.translationGroup);
---

<article class="grid gap-6 rounded-[2rem] border border-slate-200 bg-white p-5 shadow-[0_20px_60px_rgba(15,23,42,0.05)] lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:p-6">
	<a
		class="overflow-hidden rounded-[1.5rem] border border-slate-200 bg-slate-50"
		href={href}
	>
		<ResponsiveMedia
			alt={post.data.image.alt}
			imgClass="h-full w-full object-cover"
			loading={priority ? "eager" : "lazy"}
			sizes="(max-width: 1024px) 100vw, 420px"
			src={coverImage}
			widths={[480, 720, 960]}
		/>
	</a>
	<div class="flex flex-col justify-between gap-5">
		<div class="space-y-4">
			<div class="flex flex-wrap items-center gap-3 text-xs font-medium uppercase tracking-[0.2em] text-slate-500">
				<a
					class="rounded-full bg-slate-950 px-3 py-1 text-white transition hover:bg-slate-800"
					href={getBlogCategoryPath(lang, getCategorySlug(post.data.category))}
				>
					{post.data.category}
				</a>
				<time datetime={post.data.publishDate.toISOString()}>
					{formatLocalizedDate(lang, post.data.publishDate, { dateStyle: "medium" })}
				</time>
			</div>
			<h2 class="font-display text-3xl font-semibold leading-tight text-slate-950">
				<a class="transition hover:text-slate-700" href={href}>
					{post.data.title}
				</a>
			</h2>
			<p class="text-base leading-7 text-slate-600">{post.data.metaDescription}</p>
			{post.data.tags && post.data.tags.length > 0 && (
				<div class="flex flex-wrap gap-2">
					{post.data.tags.map((tag) => (
						<a
							class="rounded-full bg-slate-100 px-3 py-1.5 text-sm text-slate-600 transition hover:bg-slate-200 hover:text-slate-900"
							href={getBlogTagPath(lang, getTagSlug(tag))}
						>
							#{tag}
						</a>
					))}
				</div>
			)}
		</div>
		<div class="flex flex-col gap-4 border-t border-slate-200 pt-4 sm:flex-row sm:items-center sm:justify-between">
			<p class="text-sm text-slate-500">{authorName ?? t(lang, "blog.unknown_author")}</p>
			<ActionLink href={href} size="sm" variant="subtle">
				{t(lang, "blog.read_article")}
			</ActionLink>
		</div>
	</div>
</article>
