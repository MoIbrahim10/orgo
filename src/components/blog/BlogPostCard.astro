---
import BlogCoverMedia from "./BlogCoverMedia.astro";
import ActionLink from "../ui/ActionLink.astro";
import type { Language } from "../../types/translations";
import { t } from "../../utils/i18n";
import type { EditorialArchiveCopy, EditorialPost } from "../../utils/blogVariants";

interface Props {
	copy: EditorialArchiveCopy;
	lang: Language;
	story: EditorialPost;
	tone?: "note" | "river" | "spotlight";
}

const { copy, lang, story, tone = "river" } = Astro.props as Props;
const intro = tone === "spotlight" ? story.deck : story.excerpt;
---

<article
	class:list={["blog-post-card", `blog-post-card--${tone}`]}
	data-blog-feed-item
	data-published-ts={story.publishDate.getTime()}
	data-sort-title={story.title}
>
	<a class="blog-post-card__media" href={story.href}>
		<BlogCoverMedia
			alt={story.imageAlt}
			imgClass="blog-post-card__img"
			loading="lazy"
			sizes="(max-width: 767px) 100vw, (max-width: 1120px) 42vw, 480px"
			translationGroup={story.translationGroup}
			widths={[480, 720, 960]}
			wrapperClass="h-full rounded-[inherit]"
		/>
	</a>

	<div class="blog-post-card__body">
		<div class="blog-post-card__meta">
			<a class="blog-post-card__category" href={story.categoryHref}>
				{story.entry.data.category}
			</a>
			<span>{story.readingTimeLabel}</span>
		</div>

		<div class="blog-post-card__copy">
			<h3 class="blog-post-card__title">
				<a class="blog-post-card__title-link" href={story.href}>
					{story.title}
				</a>
			</h3>
			<p class="blog-post-card__intro">{intro}</p>
		</div>

		{story.tagLinks.length > 0 && (
			<ul class="blog-post-card__tags" aria-label={t(lang, "blog.topics_title")}>
				{story.tagLinks.slice(0, 2).map((tag) => (
					<li>
						<a class="blog-post-card__tag" href={tag.href}>
							#{tag.label}
						</a>
					</li>
				))}
			</ul>
		)}

		<footer class="blog-post-card__footer">
			<div>
				<p class="blog-post-card__author">{story.authorName}</p>
				<p class="blog-post-card__date">
					{copy.publishedLabel} {story.publishedLabel}
				</p>
			</div>
			<ActionLink href={story.href} size="sm" variant="secondary">
				{t(lang, "blog.read_article")}
			</ActionLink>
		</footer>
	</div>
</article>

<style>
	.blog-post-card {
		background:
			linear-gradient(
				180deg,
				color-mix(in srgb, var(--page-surface-muted) 88%, var(--page-bg)),
				color-mix(in srgb, var(--page-surface-muted) 66%, var(--page-bg))
			);
		border: 1px solid color-mix(in srgb, var(--page-border) 48%, transparent);
		border-radius: 1rem;
		display: grid;
		gap: clamp(0.95rem, 1.8vw, 1.25rem);
		padding: clamp(0.9rem, 1.8vw, 1.25rem);
		position: relative;
		transition:
			border-color 180ms ease,
			box-shadow 180ms ease;
	}

	.blog-post-card + .blog-post-card {
		margin-top: clamp(0.9rem, 2vw, 1.25rem);
	}

	.blog-post-card:hover {
		border-color: color-mix(in srgb, var(--page-border-strong) 78%, transparent);
		box-shadow: 0 16px 34px color-mix(in srgb, #000 12%, transparent);
	}

	.blog-post-card__media {
		aspect-ratio: 16 / 10.2;
		border-radius: 0.82rem;
		display: block;
		overflow: hidden;
		position: relative;
		transition: filter 180ms ease, opacity 180ms ease;
		will-change: filter;
	}

	.blog-post-card__media:hover,
	.blog-post-card__media:focus-visible {
		filter: saturate(1.02) brightness(1.01);
		outline: none;
	}

	.blog-post-card__img {
		min-height: 100%;
	}

	.blog-post-card__body {
		display: grid;
		gap: 0.8rem;
		align-content: start;
	}

	.blog-post-card__meta {
		align-items: center;
		color: var(--page-text-muted);
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem 0.85rem;
		font-size: 0.78rem;
		line-height: 1.45;
	}

	.blog-post-card__category,
	.blog-post-card__tag {
		color: var(--page-text-soft);
		text-decoration: none;
		transition: color 160ms ease;
	}

	.blog-post-card__category:hover,
	.blog-post-card__category:focus-visible,
	.blog-post-card__tag:hover,
	.blog-post-card__tag:focus-visible {
		color: var(--page-text-strong);
		outline: none;
	}

	.blog-post-card__copy {
		display: grid;
		gap: 0.62rem;
	}

	.blog-post-card__title {
		color: var(--page-text-strong);
		font-family: var(--font-display-latin), var(--font-display-arabic), serif;
		font-size: clamp(1.5rem, 3vw, 2.25rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 0.98;
		margin: 0;
		max-width: 18ch;
		text-wrap: balance;
	}

	.blog-post-card__title-link {
		color: inherit;
		text-decoration: none;
		transition: color 160ms ease;
	}

	.blog-post-card__title-link:hover,
	.blog-post-card__title-link:focus-visible {
		color: var(--page-text);
		outline: none;
	}

	.blog-post-card__intro {
		color: var(--page-text-soft);
		display: -webkit-box;
		font-size: 1rem;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		line-height: 1.6;
		margin: 0;
		max-width: 60ch;
		overflow: hidden;
	}

	.blog-post-card__date {
		color: var(--page-text-soft);
		font-size: 0.9rem;
		line-height: 1.55;
		margin: 0;
	}

	.blog-post-card__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem 0.6rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.blog-post-card__tag {
		background: color-mix(in srgb, var(--page-surface-solid) 90%, transparent);
		border: 1px solid color-mix(in srgb, var(--page-border) 46%, transparent);
		border-radius: 999px;
		font-size: 0.77rem;
		padding: 0.24rem 0.58rem;
	}

	.blog-post-card__footer {
		align-items: end;
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1rem;
		justify-content: space-between;
		padding-top: 0.2rem;
	}

	.blog-post-card__author {
		color: var(--page-text-strong);
		font-size: 0.95rem;
		font-weight: 600;
		line-height: 1.45;
		margin: 0;
	}

	.blog-post-card--spotlight {
		background:
			linear-gradient(
				135deg,
				color-mix(in srgb, var(--action-link-primary-gradient-start) 8%, var(--page-surface-muted)),
				color-mix(in srgb, var(--action-link-primary-gradient-end) 8%, var(--page-surface-muted))
			);
	}

	.blog-post-card--spotlight .blog-post-card__title {
		font-size: clamp(1.65rem, 3.2vw, 2.45rem);
	}

	@media (min-width: 820px) {
		.blog-post-card--river,
		.blog-post-card--spotlight,
		.blog-post-card--note {
			align-items: start;
			grid-template-columns: minmax(14rem, 0.78fr) minmax(0, 1fr);
			gap: clamp(1rem, 2vw, 1.4rem);
		}
	}

	@media (min-width: 1024px) {
		.blog-post-card--river,
		.blog-post-card--spotlight,
		.blog-post-card--note {
			grid-template-columns: minmax(16rem, 0.84fr) minmax(0, 1fr);
		}
	}

	:global(body.locale-arabic) .blog-post-card__title {
		line-height: 1.08;
	}

	:global(body.locale-arabic) .blog-post-card__meta {
		justify-content: flex-start;
	}

	@media (prefers-reduced-motion: reduce) {
		.blog-post-card {
			transition: none;
		}

		.blog-post-card__media {
			transition: none;
		}
	}
</style>
