---
import type { HomeVisualCard } from "../../types/home";
import MarketingIcon from "./MarketingIcon.astro";

interface Props {
	cards: HomeVisualCard[];
}

const { cards } = Astro.props as Props;
---

<div
	aria-hidden="true"
	class="hero-scene relative mx-auto aspect-[11/10] w-full max-w-[34rem] overflow-hidden rounded-[2rem] border border-white/60 bg-white/75 p-5 shadow-[0_24px_80px_rgba(15,23,42,0.12)] backdrop-blur"
>
	<div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_rgba(255,255,255,0.95),_rgba(255,255,255,0.76)_45%,_rgba(255,255,255,0.58))]"></div>
	<div class="relative flex h-full flex-col gap-4">
		<div class="rounded-[1.75rem] border border-slate-200/80 bg-slate-950 px-5 py-4 text-white shadow-[0_20px_45px_rgba(15,23,42,0.22)]">
			<div class="flex items-center justify-between gap-3">
				<div>
					<p class="text-[0.7rem] uppercase tracking-[0.28em] text-white/60">Orgo</p>
					<div class="mt-3 space-y-2">
						<div class="h-2.5 w-40 rounded-full bg-white/70"></div>
						<div class="h-2.5 w-28 rounded-full bg-white/25"></div>
					</div>
				</div>
				<div class="flex items-center gap-2 text-white/70">
					<span class="h-2.5 w-2.5 rounded-full bg-emerald-400"></span>
					<span class="h-2.5 w-2.5 rounded-full bg-amber-300"></span>
					<span class="h-2.5 w-2.5 rounded-full bg-rose-300"></span>
				</div>
			</div>
			<div class="mt-4 grid gap-3 sm:grid-cols-[1.5fr_1fr]">
				<div class="rounded-3xl bg-white/[0.08] p-4">
					<div class="h-2 w-14 rounded-full bg-white/25"></div>
					<div class="mt-3 space-y-2">
						<div class="flex items-center gap-2 rounded-full bg-white/[0.12] px-3 py-2">
							<span class="h-2.5 w-2.5 rounded-full bg-amber-300"></span>
							<div class="h-2 w-28 rounded-full bg-white/70"></div>
						</div>
						<div class="flex items-center gap-2 rounded-full bg-white/[0.12] px-3 py-2">
							<span class="h-2.5 w-2.5 rounded-full bg-sky-300"></span>
							<div class="h-2 w-24 rounded-full bg-white/55"></div>
						</div>
						<div class="flex items-center gap-2 rounded-full bg-white/[0.12] px-3 py-2">
							<span class="h-2.5 w-2.5 rounded-full bg-rose-300"></span>
							<div class="h-2 w-20 rounded-full bg-white/45"></div>
						</div>
					</div>
				</div>
				<div class="rounded-3xl bg-white/10 p-4">
					<div class="h-2 w-16 rounded-full bg-white/25"></div>
					<div class="mt-4 rounded-2xl border border-white/10 bg-white/[0.08] p-3">
						<div class="space-y-2">
							<div class="h-2 w-full rounded-full bg-white/60"></div>
							<div class="h-2 w-4/5 rounded-full bg-white/40"></div>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="grid flex-1 gap-3 sm:grid-cols-3">
			{cards.map((card, index) => (
					<div
						class:list={[
							"floating-card relative rounded-[1.6rem] border border-slate-200 bg-white/[0.88] p-4 shadow-[0_16px_40px_rgba(15,23,42,0.08)] backdrop-blur",
							card.tone === "sun" && "bg-amber-50",
							card.tone === "rose" && "bg-rose-50",
							card.tone === "sky" && "bg-sky-50",
							card.tone === "mint" && "bg-emerald-50",
						]}
						style={`animation-delay:${index * 120}ms;`}
					>
					<div
						class:list={[
							"inline-flex rounded-2xl p-2 text-slate-900",
							card.tone === "sun" && "bg-amber-100",
							card.tone === "rose" && "bg-rose-100",
							card.tone === "sky" && "bg-sky-100",
							card.tone === "mint" && "bg-emerald-100",
						]}
					>
						<MarketingIcon className="h-5 w-5" name={card.icon} />
					</div>
					<h3 class="mt-4 text-base font-semibold text-slate-950">{card.title}</h3>
					<p class="mt-2 text-sm leading-6 text-slate-600">{card.body}</p>
				</div>
			))}
		</div>
	</div>
</div>

<style>
	@media (prefers-reduced-motion: no-preference) {
		.hero-scene::before {
			animation: hero-glow 14s ease-in-out infinite alternate;
			background:
				radial-gradient(circle at 22% 20%, rgb(253 230 138 / 0.45), transparent 34%),
				radial-gradient(circle at 82% 22%, rgb(186 230 253 / 0.45), transparent 30%),
				radial-gradient(circle at 50% 92%, rgb(254 205 211 / 0.38), transparent 28%);
			content: "";
			inset: -15%;
			position: absolute;
		}

		.floating-card {
			animation: float-card 6.5s ease-in-out infinite;
		}
	}

	@keyframes float-card {
		0%,
		100% {
			transform: translateY(0);
		}

		50% {
			transform: translateY(-8px);
		}
	}

	@keyframes hero-glow {
		from {
			transform: rotate(0deg) scale(1);
		}

		to {
			transform: rotate(6deg) scale(1.04);
		}
	}
</style>
