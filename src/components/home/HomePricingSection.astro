---
import type { HomePageContent } from '../../types/home';
import type { Language } from '../../types/translations';
import HomePricingCard from './HomePricingCard.astro';
import SectionHeader from '../ui/SectionHeader.astro';

interface Props {
  content: HomePageContent['pricing'];
  lang: Language;
}

const { content, lang } = Astro.props as Props;
---

<section
  class="home-pricing-section"
  aria-labelledby="home-pricing-heading"
  data-home-reveal-section
  id="pricing">
  <div class="home-pricing-section__inner">
    <SectionHeader
      align="center"
      description={content.description}
      headline={content.title}
      headlineId="home-pricing-heading"
      headlineTag="h2"
      revealStagger
      sectionName={content.eyebrow}
    />
    <div class="home-pricing-section__grid">
      {
				content.plans.map((plan, index) => (
					<div
						class="home-pricing-section__cell home-reveal"
						style={`--reveal-index: ${index + 3}`}>
						<HomePricingCard
							featuresHeading={content.featuresHeading}
							lang={lang}
							perMonth={content.perMonth}
							plan={plan}
						/>
					</div>
				))
      }
    </div>
  </div>
</section>

<style>
  .home-pricing-section {
    background: var(--page-bg);
    isolation: isolate;
    margin-inline: calc(50% - 50vw);
    overflow: hidden;
    width: 100vw;
  }

  .home-pricing-section__inner {
    margin-inline: auto;
    max-width: var(--layout-width-navbar);
    padding-inline: var(--layout-gutter);
  }

  .home-pricing-section__inner :global(.section-header) {
    max-width: 36rem;
  }

  .home-pricing-section__grid {
    display: grid;
    gap: 24px;
    grid-template-columns: 1fr;
    margin-top: clamp(2rem, 5vw, 2.5rem);
  }

  .home-pricing-section__cell {
    min-width: 0;
  }

  @media (width >= 768px) {
    .home-pricing-section__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
