---
interface Props {
	class?: string;
}

const { class: className } = Astro.props as Props;
---

<article class:list={["rhythm-card", className]}>
	<slot />
</article>

<style>
	.rhythm-card {
		background:
			linear-gradient(180deg, oklch(100% 0 0deg / 6%), oklch(100% 0 0deg / 2%)),
			oklch(20.8% 0.042 265.755deg / 55%);
		border: 1px solid oklch(100% 0 0deg / 8%);
		border-radius: 1.5rem;
		padding: 1.25rem;
	}
</style>
