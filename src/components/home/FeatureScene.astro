---
import MarketingIcon from "./MarketingIcon.astro";

interface Props {
	variant: "capture" | "journal" | "rhythm";
}

const { variant } = Astro.props as Props;
---

<div
	aria-hidden="true"
	class="relative overflow-hidden rounded-[2rem] border border-slate-200 bg-white p-5 shadow-[0_24px_70px_rgba(15,23,42,0.08)]"
>
	<div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_rgba(224,242,254,0.5),_transparent_32%),radial-gradient(circle_at_bottom_left,_rgba(255,237,213,0.42),_transparent_36%)]"></div>
		{
			variant === "capture" && (
				<div class="scene-grid relative space-y-4">
					<div class="rounded-[1.6rem] border border-slate-200 bg-slate-950 p-5 text-white">
						<div class="flex items-center justify-between text-xs uppercase tracking-[0.24em] text-white/55">
							<div class="h-2 w-16 rounded-full bg-white/25"></div>
							<MarketingIcon className="h-4 w-4" name="spark" />
						</div>
						<div class="mt-4 grid gap-3 sm:grid-cols-2">
							<div class="rounded-3xl bg-white/10 p-4">
								<div class="space-y-2">
									<div class="h-2 w-4/5 rounded-full bg-white/75"></div>
									<div class="h-2 w-3/5 rounded-full bg-white/40"></div>
								</div>
							</div>
							<div class="rounded-3xl bg-white/10 p-4">
								<div class="space-y-2">
									<div class="h-2 w-3/4 rounded-full bg-white/75"></div>
									<div class="h-2 w-2/3 rounded-full bg-white/40"></div>
								</div>
							</div>
						</div>
					</div>
					<div class="grid gap-3 sm:grid-cols-[1.15fr_0.85fr]">
						<div class="rounded-[1.6rem] border border-slate-200 bg-white p-4">
							<div class="flex items-center gap-2 text-sm font-medium text-slate-700">
								<MarketingIcon className="h-4 w-4" name="layers" />
								<div class="h-2 w-40 rounded-full bg-slate-300"></div>
							</div>
							<div class="mt-4 flex flex-wrap gap-2">
								<span class="h-8 w-[4.5rem] rounded-full bg-amber-100"></span>
								<span class="h-8 w-20 rounded-full bg-sky-100"></span>
								<span class="h-8 w-16 rounded-full bg-rose-100"></span>
							</div>
						</div>
						<div class="rounded-[1.6rem] border border-slate-200 bg-white p-4">
							<div class="flex items-center gap-2 text-sm font-medium text-slate-700">
								<MarketingIcon className="h-4 w-4" name="globe" />
								<div class="h-2 w-28 rounded-full bg-slate-300"></div>
							</div>
							<div class="mt-4 space-y-2">
								<div class="h-2 w-full rounded-full bg-slate-200"></div>
								<div class="h-2 w-4/5 rounded-full bg-slate-200"></div>
							</div>
						</div>
					</div>
				</div>
			)
	}
	{
			variant === "rhythm" && (
				<div class="relative space-y-5">
					<div class="rounded-[1.6rem] border border-slate-200 bg-white p-5">
						<div class="flex items-center justify-between">
							<div>
								<div class="h-2 w-20 rounded-full bg-slate-200"></div>
								<div class="mt-4 h-3 w-48 rounded-full bg-slate-900"></div>
								<div class="mt-2 h-2 w-32 rounded-full bg-slate-200"></div>
							</div>
							<MarketingIcon className="h-6 w-6 text-slate-900" name="calendar" />
						</div>
						<div class="mt-6 grid gap-3 sm:grid-cols-4">
							{
								["01", "02", "03", "04"].map((day, index) => (
									<div class="rounded-3xl border border-slate-200 bg-slate-50 p-3">
										<p class="text-xs uppercase tracking-[0.2em] text-slate-500">{day}</p>
										<div class="mt-3 h-2 rounded-full bg-slate-200">
										<div
											class="h-2 rounded-full bg-slate-900"
											style={`width:${[75, 58, 82, 66][index]}%`}
										></div>
									</div>
								</div>
							))
						}
					</div>
					</div>
					<div class="rounded-[1.6rem] border border-slate-200 bg-linear-to-r from-amber-50 to-sky-50 p-5">
						<div class="flex items-start gap-3">
							<div class="rounded-2xl bg-white p-2 text-slate-950 shadow-sm">
								<MarketingIcon className="h-5 w-5" name="wave" />
							</div>
							<div>
								<div class="h-3 w-48 rounded-full bg-slate-900"></div>
								<div class="mt-3 space-y-2">
									<div class="h-2 w-full rounded-full bg-slate-200"></div>
									<div class="h-2 w-4/5 rounded-full bg-slate-200"></div>
								</div>
							</div>
						</div>
					</div>
				</div>
		)
	}
	{
			variant === "journal" && (
				<div class="relative space-y-4">
					<div class="grid gap-4 sm:grid-cols-[1fr_0.9fr]">
						<div class="rounded-[1.6rem] border border-slate-200 bg-white p-5">
							<div class="flex items-center gap-2 text-sm font-medium text-slate-700">
								<MarketingIcon className="h-5 w-5" name="journal" />
								<div class="h-2 w-24 rounded-full bg-slate-300"></div>
							</div>
							<div class="mt-4 space-y-3">
								<div class="h-2 w-full rounded-full bg-slate-300"></div>
								<div class="h-2 w-5/6 rounded-full bg-slate-300"></div>
								<div class="h-2 w-3/4 rounded-full bg-slate-300"></div>
							</div>
						</div>
						<div class="rounded-[1.6rem] border border-slate-200 bg-slate-950 p-5 text-white">
							<div class="flex items-center gap-2 text-sm font-medium text-white/80">
								<MarketingIcon className="h-5 w-5" name="compass" />
								<div class="h-2 w-24 rounded-full bg-white/35"></div>
							</div>
							<div class="mt-4 space-y-3">
								<div class="h-2 w-full rounded-full bg-white/70"></div>
								<div class="h-2 w-4/5 rounded-full bg-white/45"></div>
								<div class="h-2 w-2/3 rounded-full bg-white/35"></div>
							</div>
						</div>
					</div>
					<div class="rounded-[1.6rem] border border-slate-200 bg-linear-to-r from-rose-50 to-amber-50 p-5">
						<div class="flex items-start gap-3">
							<div class="rounded-2xl bg-white p-2 text-slate-950 shadow-sm">
								<MarketingIcon className="h-5 w-5" name="sunrise" />
							</div>
							<div>
								<div class="h-3 w-40 rounded-full bg-slate-900"></div>
								<div class="mt-3 space-y-2">
									<div class="h-2 w-full rounded-full bg-slate-200"></div>
									<div class="h-2 w-3/4 rounded-full bg-slate-200"></div>
								</div>
							</div>
						</div>
					</div>
			</div>
		)
	}
</div>
