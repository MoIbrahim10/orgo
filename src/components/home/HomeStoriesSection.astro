---
import type { HomePageContent } from "../../types/home";
import ActionLink from "../ui/ActionLink.astro";
import PageSection from "../ui/PageSection.astro";
import SectionIntro from "../ui/SectionIntro.astro";
import HomeLiftedCard from "./HomeLiftedCard.astro";
import MarketingIcon from "./MarketingIcon.astro";

interface Props {
	content: HomePageContent["stories"];
}

const { content } = Astro.props as Props;
---

<PageSection id="stories" tone="soft">
	<SectionIntro
		description={content.description}
		eyebrow={content.eyebrow}
		title={content.title}
	/>
	<div class="mt-10 grid gap-6 xl:grid-cols-3">
		{
			content.cards.map((card) => (
				<HomeLiftedCard>
					<div class="flex items-center justify-between gap-4">
						<div class="rounded-2xl bg-slate-950 p-2 text-white">
							<MarketingIcon className="h-5 w-5" name={card.icon} />
						</div>
						<p class="text-xs font-medium uppercase tracking-[0.2em] text-slate-500">
							{card.label}
						</p>
					</div>
					<h3 class="font-display mt-6 text-2xl font-semibold tracking-tight text-slate-950">
						{card.title}
					</h3>
					<p class="mt-4 text-base leading-7 text-slate-600">{card.body}</p>
					<div class="mt-6 rounded-[1.4rem] bg-slate-50 p-4">
						<p class="text-xs font-medium uppercase tracking-[0.2em] text-slate-500">
							{content.outcomeLabel}
						</p>
						<p class="mt-3 text-sm leading-6 text-slate-700">{card.outcome}</p>
					</div>
					{card.href && card.cta && (
						<ActionLink class="mt-6" href={card.href} size="sm" variant="secondary">
							{card.cta}
						</ActionLink>
					)}
				</HomeLiftedCard>
			))
		}
	</div>
</PageSection>
