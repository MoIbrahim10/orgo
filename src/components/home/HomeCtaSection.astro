---
import type { HomePageContent } from "../../types/home";
import ActionLink from "../ui/ActionLink.astro";
import MarketingEyebrow from "../ui/MarketingEyebrow.astro";
import PageSection from "../ui/PageSection.astro";

interface Props {
	content: HomePageContent["cta"];
	eyebrow: string;
	primaryHref: string;
	secondaryHref: string;
}

const { content, eyebrow, primaryHref, secondaryHref } = Astro.props as Props;
---

<PageSection class="pt-0">
	<div
		class="marketing-panel mx-auto max-w-6xl rounded-4xl border border-slate-200 bg-linear-to-br from-amber-50 via-white to-sky-50 px-6 py-8 shadow-[0_24px_70px_rgba(15,23,42,0.08)] sm:px-8 sm:py-10 lg:px-12">
		<div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
			<div class="max-w-3xl">
				<MarketingEyebrow>{eyebrow}</MarketingEyebrow>
				<h2
					class="mt-5 text-4xl font-semibold tracking-tight text-slate-950 sm:text-[2.7rem] sm:leading-[1.08]">
					{content.title}
				</h2>
				<p class="mt-5 text-lg leading-8 text-slate-600">{content.description}</p>
			</div>
			<div class="flex flex-wrap gap-4">
				<ActionLink href={primaryHref} variant="primary">
					{content.primaryCta}
				</ActionLink>
				<ActionLink href={secondaryHref} variant="secondary">
					{content.secondaryCta}
				</ActionLink>
			</div>
		</div>
	</div>
</PageSection>
