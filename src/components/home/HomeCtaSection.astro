---
import type { HomePageContent } from "../../types/home";
import ActionLink from "../ui/ActionLink.astro";
import SectionHeader from "../ui/SectionHeader.astro";

interface Props {
	content: HomePageContent["cta"];
	primaryHref: string;
	secondaryHref: string;
}

const { content, primaryHref, secondaryHref } = Astro.props as Props;
---

<section class="home-cta" aria-labelledby="home-cta-heading" data-home-reveal-section>
	<div class="home-cta__inner">
		<SectionHeader
			align="center"
			class="home-cta__header"
			description={content.description}
			headline={content.headline}
			headlineId="home-cta-heading"
			headlineTag="h2"
			revealStagger
			sectionName={content.sectionName}
		/>
		<div class="home-cta__panel home-reveal" style="--reveal-index: 3">
			<div class="home-cta__actions">
				<ActionLink href={primaryHref} variant="primary">
					{content.primaryCta}
				</ActionLink>
				<ActionLink href={secondaryHref} variant="secondary">
					{content.secondaryCta}
				</ActionLink>
			</div>
		</div>
	</div>
</section>

<style>
	.home-cta {
		background: transparent;
		isolation: isolate;
		margin-inline: calc(50% - 50vw);
		overflow: hidden;
		width: 100vw;
	}

	.home-cta__inner {
		margin-inline: auto;
		max-width: var(--layout-width-navbar);
		padding-inline: var(--layout-gutter);
	}

	.home-cta__header :global(.section-header) {
		max-width: 40rem;
	}

	.home-cta__panel {
		margin-inline: auto;
		margin-top: clamp(1.75rem, 4vw, 2.25rem);
		max-width: 40rem;
		padding: 24px;
		width: 100%;
	}

	.home-cta__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		justify-content: center;
	}
</style>
