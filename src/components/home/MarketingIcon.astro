---
import type { HomeIconName } from "../../types/home";

interface Props {
	className?: string;
	name: HomeIconName;
}

const { className = "", name } = Astro.props as Props;
---

<svg
	aria-hidden="true"
	class={className}
	fill="none"
	stroke="currentColor"
	stroke-linecap="round"
	stroke-linejoin="round"
	stroke-width="1.75"
	viewBox="0 0 24 24"
>
	{
		name === "calendar" && (
			<>
				<rect height="14" rx="3" width="18" x="3" y="6"></rect>
				<path d="M8 3v6"></path>
				<path d="M16 3v6"></path>
				<path d="M3 10h18"></path>
			</>
		)
	}
	{
		name === "check-circle" && (
			<>
				<circle cx="12" cy="12" r="9"></circle>
				<path d="m8.5 12 2.5 2.5 4.5-5"></path>
			</>
		)
	}
	{
		name === "compass" && (
			<>
				<circle cx="12" cy="12" r="9"></circle>
				<path d="m15.5 8.5-2.6 7.1-4.4-4.3 7-2.8Z"></path>
			</>
		)
	}
	{
		name === "focus" && (
			<>
				<path d="M4 9V6a2 2 0 0 1 2-2h3"></path>
				<path d="M15 4h3a2 2 0 0 1 2 2v3"></path>
				<path d="M20 15v3a2 2 0 0 1-2 2h-3"></path>
				<path d="M9 20H6a2 2 0 0 1-2-2v-3"></path>
				<circle cx="12" cy="12" r="2.5"></circle>
			</>
		)
	}
	{
		name === "globe" && (
			<>
				<circle cx="12" cy="12" r="9"></circle>
				<path d="M3.6 9h16.8"></path>
				<path d="M3.6 15h16.8"></path>
				<path d="M12 3c2.4 2.6 3.8 5.8 3.8 9S14.4 18.4 12 21"></path>
				<path d="M12 3C9.6 5.6 8.2 8.8 8.2 12s1.4 6.4 3.8 9"></path>
			</>
		)
	}
	{
		name === "journal" && (
			<>
				<path d="M7 4.5h9a2 2 0 0 1 2 2v13H9a3 3 0 0 0-3 3V6.5a2 2 0 0 1 2-2Z"></path>
				<path d="M9 7.5h6"></path>
				<path d="M9 11h6"></path>
				<path d="M9 14.5h4"></path>
			</>
		)
	}
	{
		name === "layers" && (
			<>
				<path d="m12 4 8 4-8 4-8-4 8-4Z"></path>
				<path d="m4 12 8 4 8-4"></path>
				<path d="m4 16 8 4 8-4"></path>
			</>
		)
	}
	{
		name === "leaf" && (
			<>
				<path d="M18.5 5.5c-5-.6-9.5 1.3-11.8 5.7-1.2 2.3-1.5 5.3-.8 7.3 1.9.4 4.8-.1 7.1-1.5 4-2.3 5.7-6.7 5.5-11.5Z"></path>
				<path d="M8 16c2.7-2.2 5.1-4.9 7.2-8"></path>
			</>
		)
	}
	{
		name === "spark" && (
			<>
				<path d="m12 3 1.8 4.2L18 9l-4.2 1.8L12 15l-1.8-4.2L6 9l4.2-1.8L12 3Z"></path>
				<path d="M5 16.5 6 19l2.5 1-2.5 1-1 2.5-1-2.5L2 20l2.5-1 1-2.5Z"></path>
			</>
		)
	}
	{
		name === "sunrise" && (
			<>
				<path d="M4 18h16"></path>
				<path d="M7 18a5 5 0 0 1 10 0"></path>
				<path d="M12 6v3"></path>
				<path d="m6.7 10.2 2 1.6"></path>
				<path d="m17.3 10.2-2 1.6"></path>
			</>
		)
	}
	{
		name === "team" && (
			<>
				<circle cx="9" cy="9" r="3"></circle>
				<circle cx="17" cy="10" r="2.5"></circle>
				<path d="M4.5 19a4.5 4.5 0 0 1 9 0"></path>
				<path d="M14.5 19a3.5 3.5 0 0 1 5 0"></path>
			</>
		)
	}
	{
		name === "wave" && (
			<>
				<path d="M3 14c2.5 0 2.5-4 5-4s2.5 4 5 4 2.5-4 5-4 2.5 4 5 4"></path>
				<path d="M3 18c2.5 0 2.5-4 5-4s2.5 4 5 4 2.5-4 5-4 2.5 4 5 4"></path>
			</>
		)
	}
</svg>
