---
import type { HomePageContent } from "../../types/home";
import ActionLink from "../ui/ActionLink.astro";
import PageSection from "../ui/PageSection.astro";
import SectionIntro from "../ui/SectionIntro.astro";

interface Props {
	content: HomePageContent["proposal"];
	primaryHref: string;
	secondaryHref: string;
}

const { content, primaryHref, secondaryHref } = Astro.props as Props;
---

<PageSection class="py-8" tone="transparent">
	<div class="proposal-panel">
		<div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,0.42fr)] lg:items-center">
			<SectionIntro
				description={content.description}
				eyebrow={content.eyebrow}
				title={content.title}
				tone="inverse"
			/>
			<div class="rounded-[1.75rem] border border-white/10 bg-white/04 p-5">
				<ul class="grid gap-4">
					{
						content.points.map((point) => (
							<li class="flex items-start gap-3">
								<span class="mt-1 inline-flex h-2.5 w-2.5 rounded-full bg-amber-300"></span>
								<span class="text-sm leading-6 text-slate-200">{point}</span>
							</li>
						))
					}
				</ul>
				<div class="mt-6 flex flex-wrap gap-3">
					<ActionLink href={primaryHref} variant="inverted">
						{content.primaryCta}
					</ActionLink>
					<ActionLink
						class="text-white/80 hover:text-white"
						href={secondaryHref}
						variant="ghost"
					>
						{content.secondaryCta}
					</ActionLink>
				</div>
			</div>
		</div>
	</div>
</PageSection>

<style is:global>
	:root {
		--home-proposal-panel-bg:
			radial-gradient(circle at top left, oklch(83% 0.12 82deg / 14%), transparent 28%),
			radial-gradient(circle at bottom right, oklch(82% 0.08 230deg / 16%), transparent 28%),
			linear-gradient(
				160deg,
				oklch(12.9% 0.042 264.695deg) 0%,
				oklch(20.8% 0.042 265.755deg) 62%,
				oklch(27.9% 0.041 260.031deg) 100%
			);
	}

	html[data-theme="dark"] {
		--home-proposal-panel-bg:
			radial-gradient(circle at top left, oklch(72% 0.11 82deg / 16%), transparent 28%),
			radial-gradient(circle at bottom right, oklch(68% 0.08 195deg / 12%), transparent 28%),
			linear-gradient(
				160deg,
				oklch(17.9% 0 0deg) 0%,
				oklch(21.5% 0 0deg) 54%,
				oklch(25.5% 0 0deg) 100%
			);
	}
</style>

<style>
	.proposal-panel {
		background: var(--home-proposal-panel-bg);
		border: 1px solid var(--page-border);
		border-radius: 2rem;
		box-shadow: 0 26px 80px oklch(20.8% 0.042 265.755deg / 18%);
		color: oklch(100% 0 0deg);
		overflow: hidden;
		padding: 2rem;
	}
</style>
