---
import ActionLink from '../ui/ActionLink.astro';
import type { HomePageContent } from '../../types/home';
import type { Language } from '../../types/translations';
import { t } from '../../utils/i18n';
import heroCalAr from '../../assets/hero/ar/cal.svg';
import heroCalEn from '../../assets/hero/en/cal.svg';
import HomeHeroBadge from './HomeHeroBadge.astro';

const heroCalSrc: Record<Language, string> = {
  ar: heroCalAr.src,
  en: heroCalEn.src,
};

interface Props {
  content: HomePageContent['hero'];
  lang: Language;
  primaryHref: string;
  secondaryHref: string;
}

const { content, lang, primaryHref, secondaryHref } = Astro.props as Props;
const heroCalImageSrc = heroCalSrc[lang] ?? heroCalEn.src;
const heroCalImageAlt = t(lang, 'home.hero.visual_alt');
---

<section class="home-hero" data-home-reveal-section>
  <div class="home-hero__copy">
    <HomeHeroBadge
      className="home-reveal"
      style="--reveal-index: 0"
      text={content.eyebrow}
    />
    <h1 class="home-hero__title home-reveal" style="--reveal-index: 1">
      {content.title}
    </h1>
    <p class="home-hero__description home-reveal" style="--reveal-index: 2">
      {content.description}
    </p>
    <div class="home-hero__actions home-reveal" style="--reveal-index: 3">
      <ActionLink
        href={primaryHref}
        size="lg"
        variant="primary">
        {content.primaryCta}
      </ActionLink>
      <ActionLink
        href={secondaryHref}
        size="lg"
        variant="secondary">
        {content.secondaryCta}
      </ActionLink>
    </div>
  </div>
  <div class="home-hero__visual home-reveal" style="--reveal-index: 4">
    <img
      class="home-hero__cal"
      src={heroCalImageSrc}
      alt={heroCalImageAlt}
      width={heroCalEn.width}
      height={heroCalEn.height}
      loading="eager"
      decoding="async"
    />
  </div>
</section>

<style>
  .home-hero {
    overflow: hidden;
    padding-inline: 6px;
    padding-top: 12px;
    position: relative;
  }

  .home-hero__copy {
    align-items: center;
    display: flex;
    flex-direction: column;
    text-align: center;
  }

  .home-hero__title {
    color: var(--foreground-primary);
    font-size: 48px;
    font-weight: 600;
    margin-top: 18px;
    margin-bottom: 8px;
    max-width: 46rem;
    text-wrap: balance;
  }

  .home-hero__description {
    color: var(--foreground-secondary);
    font-family: var(--font-ui);
    font-size: 16px;
    font-weight: 400;
    max-width: 41rem;
    text-wrap: pretty;
  }

  .home-hero__actions {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 20px;
  }

  .home-hero__visual {
    margin-top: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .home-hero__cal {
    display: block;
    height: auto;
    margin-left: auto;
    margin-right: auto;
    max-width: 100%;
    min-width: min(100%, 18rem);
  }

  @media (max-width: 640px) {
    .home-hero__title {
      font-size: 40px;
    }
  }

</style>
