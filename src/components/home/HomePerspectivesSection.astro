---
import type { HomePageContent } from "../../types/home";
import MarketingIcon from "./MarketingIcon.astro";
import SectionHeader from "../ui/SectionHeader.astro";

interface Props {
	content: HomePageContent["perspectives"];
}

const { content } = Astro.props as Props;
---

<section
	class="home-perspectives"
	aria-labelledby="home-perspectives-heading"
	data-home-reveal-section>
	<div class="home-perspectives__inner">
		<SectionHeader
			align="center"
			class="home-perspectives__header"
			description={content.description}
			headline={content.headline}
			headlineId="home-perspectives-heading"
			headlineTag="h2"
			revealStagger
			sectionName={content.sectionName}
		/>
		<ul class="home-perspectives__grid">
			{
				content.cards.map((card, index) => (
					<li
						class="home-perspectives__card home-reveal"
						style={`--reveal-index: ${index + 3}`}>
						<div class="home-perspectives__icon-wrap">
							<MarketingIcon className="h-5 w-5" name={card.icon} />
						</div>
						<div class="home-perspectives__text-stack">
							<h3 class="spotlight-surface-card-title">{card.title}</h3>
							<p class="spotlight-surface-card-desc">{card.body}</p>
						</div>
						<div class="home-perspectives__focus">
							<p class="home-perspectives__focus-label">{content.focusLabel}</p>
							<p class="home-perspectives__focus-quote">{card.focus}</p>
						</div>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.home-perspectives {
		background: transparent;
		isolation: isolate;
		margin-inline: calc(50% - 50vw);
		overflow: hidden;
		width: 100vw;
	}

	.home-perspectives__inner {
		margin-inline: auto;
		max-width: var(--layout-width-navbar);
		padding-inline: var(--layout-gutter);
	}

	.home-perspectives__header :global(.section-header) {
		max-width: 40rem;
	}

	.home-perspectives__grid {
		display: grid;
		gap: clamp(1rem, 3vw, 1.25rem);
		grid-template-columns: 1fr;
		list-style: none;
		margin: clamp(2rem, 5vw, 2.5rem) 0 0;
		padding: 0;
	}

	@media (width >= 1024px) {
		.home-perspectives__grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	.home-perspectives__card {
		background: var(--feature-spotlight-card-surface);
		border-radius: var(--feature-spotlight-card-radius);
		display: flex;
		flex-direction: column;
		gap: 21px;
		min-width: 0;
		padding: 24px;
		text-align: start;
	}

	.home-perspectives__text-stack {
		display: flex;
		flex-direction: column;
		gap: 6px;
		width: 100%;
	}

	.home-perspectives__icon-wrap {
		align-items: center;
		align-self: flex-start;
		background: var(--feature-spotlight-plate-fill);
		border-radius: 999px;
		color: var(--foreground-primary);
		display: inline-flex;
		padding: 8px;
	}

	.home-perspectives__focus {
		border-top: 1px solid color-mix(in srgb, var(--foreground-primary) 12%, transparent);
		margin-top: 0;
		padding-top: 16px;
	}

	.home-perspectives__focus-label {
		color: var(--foreground-tertiary);
		font-family: var(--font-ui);
		font-size: 12px;
		font-weight: 500;
		letter-spacing: 0.06em;
		line-height: 15px;
		margin: 0;
		text-transform: uppercase;
	}

	.home-perspectives__focus-quote {
		color: var(--foreground-primary);
		font-family: var(--font-ui);
		font-size: 16px;
		font-weight: 500;
		line-height: 19px;
		margin: 8px 0 0;
	}
</style>
