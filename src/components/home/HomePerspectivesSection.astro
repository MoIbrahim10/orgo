---
import type { HomePageContent } from "../../types/home";
import PageSection from "../ui/PageSection.astro";
import SectionIntro from "../ui/SectionIntro.astro";
import HomeLiftedCard from "./HomeLiftedCard.astro";
import MarketingIcon from "./MarketingIcon.astro";

interface Props {
	content: HomePageContent["perspectives"];
}

const { content } = Astro.props as Props;
---

<PageSection tone="transparent">
	<SectionIntro
		description={content.description}
		eyebrow={content.eyebrow}
		title={content.title}
	/>
	<div class="mt-10 grid gap-6 xl:grid-cols-3">
		{
			content.cards.map((card) => (
				<HomeLiftedCard>
					<div class="inline-flex rounded-2xl bg-amber-100 p-2 text-slate-950">
						<MarketingIcon className="h-5 w-5" name={card.icon} />
					</div>
					<h3 class="font-display mt-5 text-2xl font-semibold tracking-tight text-slate-950">
						{card.title}
					</h3>
					<p class="mt-4 text-base leading-7 text-slate-600">{card.body}</p>
					<div class="mt-6 border-t border-slate-200 pt-5">
						<p class="text-xs font-medium uppercase tracking-[0.2em] text-slate-500">
							{content.focusLabel}
						</p>
						<p class="mt-3 text-base leading-7 text-slate-900">{card.focus}</p>
					</div>
				</HomeLiftedCard>
			))
		}
	</div>
</PageSection>
