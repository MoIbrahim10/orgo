---
import illustration1Ar from "../../assets/home/ar/illustration-1.png";
import illustration2Ar from "../../assets/home/ar/illustration-2.png";
import illustration3Ar from "../../assets/home/ar/illustration-3.png";
import illustration4Ar from "../../assets/home/ar/illustration-4.png";
import illustration1En from "../../assets/home/en/illustration-1.png";
import illustration2En from "../../assets/home/en/illustration-2.png";
import illustration3En from "../../assets/home/en/illustration-3.png";
import illustration4En from "../../assets/home/en/illustration-4.png";
import type { ImageMetadata } from "astro";
import type { HomePageContent } from "../../types/home";
import type { Language } from "../../types/translations";
import SectionHeader from "../ui/SectionHeader.astro";

interface Props {
	content: HomePageContent["benefits"];
	lang: Language;
}

const { content, lang } = Astro.props as Props;

const illustrationsByLang: Record<Language, ImageMetadata[]> = {
	ar: [illustration1Ar, illustration2Ar, illustration3Ar, illustration4Ar],
	en: [illustration1En, illustration2En, illustration3En, illustration4En],
};

const illustrationSources = illustrationsByLang[lang].map((img) => img.src);
---

<section
	class="home-benefits"
	aria-labelledby="home-benefits-heading"
	data-home-reveal-section
>
	<div class="home-benefits__inner">
		<SectionHeader
			align="center"
			description={content.description}
			headline={content.headline}
			headlineId="home-benefits-heading"
			headlineTag="h2"
			revealStagger
			sectionName={content.sectionName}
		/>
		<ul class="home-benefits__grid">
			{
				content.cards.map((card, index) => {
					const figureReveal = index * 2 + 3;
					const copyReveal = index * 2 + 4;
					return (
						<li class="home-benefits__card">
							<div
								class="home-benefits__figure home-reveal"
								style={`--reveal-index: ${figureReveal}`}
							>
								<img
									class="home-benefits__img"
									src={illustrationSources[index]}
									alt={card.imageAlt}
									width="395"
									height="237"
									loading="lazy"
									decoding="async"
								/>
							</div>
							<div
								class="home-benefits__copy home-reveal"
								style={`--reveal-index: ${copyReveal}`}
							>
								<h3 class="spotlight-surface-card-title">{card.title}</h3>
								<p class="spotlight-surface-card-desc">{card.body}</p>
							</div>
						</li>
					);
				})
			}
		</ul>
	</div>
</section>

<style>
	.home-benefits {
		background: transparent;
		margin: 0;
		padding: 0;
	}

	.home-benefits__inner {
		display: flex;
		flex-direction: column;
		gap: clamp(1.75rem, 4vw, 2.5rem);
		width: 100%;
	}

	.home-benefits__inner :global(.section-header) {
		max-width: 40rem;
	}

	.home-benefits__grid {
		display: grid;
		gap: clamp(1rem, 3vw, 1.25rem);
		grid-template-columns: 1fr;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	@media (width >= 640px) {
		.home-benefits__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.home-benefits__card {
		background: var(--feature-spotlight-card-surface);
		border-radius: var(--feature-spotlight-card-radius);
		display: flex;
		flex-direction: column;
		gap: 21px;
		justify-content: center;
		min-width: 0;
		padding: 24px;
	}

	.home-benefits__figure {
		border-radius: var(--feature-spotlight-card-radius);
		overflow: hidden;
		width: 100%;
	}

	.home-benefits__img {
		display: block;
		height: auto;
		transform-origin: center center;
		width: 100%;
	}

	/* Extra motion on illustrations; stagger matches .home-reveal on the figure */
	.home-benefits:global(.is-visible) .home-benefits__figure.home-reveal .home-benefits__img {
		animation: home-benefits-img 1s ease-out calc(var(--reveal-index, 0) * 0.3s) both;
	}

	@keyframes home-benefits-img {
		from {
			opacity: 0.88;
			transform: scale(1.045);
		}

		to {
			opacity: 1;
			transform: scale(1);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.home-benefits:global(.is-visible) .home-benefits__figure.home-reveal .home-benefits__img {
			animation: none;
			opacity: 1;
			transform: none;
		}
	}

	.home-benefits__copy {
		align-items: stretch;
		display: flex;
		flex-direction: column;
		gap: 6px;
		justify-content: flex-start;
		padding: 0;
		text-align: start;
		width: 100%;
	}
</style>
