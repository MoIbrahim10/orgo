---
import type { HomePageContent } from "../../types/home";

interface Props {
	signals: HomePageContent["processSignals"];
}

const { signals } = Astro.props as Props;

const toneClasses = {
	mint: "border-emerald-200 bg-emerald-50/90",
	rose: "border-rose-200 bg-rose-50/90",
	sky: "border-sky-200 bg-sky-50/90",
	sun: "border-amber-200 bg-amber-50/90",
} as const;
---

<section class="px-6 pb-2 pt-4">
	<div class="mx-auto grid max-w-6xl gap-4 md:grid-cols-2 xl:grid-cols-4">
		{
			signals.map((signal) => (
				<article class:list={["home-proof-chip", toneClasses[signal.tone]]}>
					<p class="text-xs font-medium uppercase tracking-[0.2em] text-slate-500">
						{signal.label}
					</p>
					<p class="mt-3 text-sm leading-6 text-slate-700">{signal.value}</p>
				</article>
			))
		}
	</div>
</section>
