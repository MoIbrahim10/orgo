---
import type { HomeFeatureStory as HomeFeatureStoryData } from "../../types/home";
import SectionIntro from "../ui/SectionIntro.astro";
import MarketingIcon from "./MarketingIcon.astro";
import FeatureScene from "./FeatureScene.astro";

interface Props {
	story: HomeFeatureStoryData;
}

const { story } = Astro.props as Props;
---

<section class="scroll-mt-28 px-6 py-8" id={story.id}>
	<div
		class:list={[
			"mx-auto grid max-w-6xl gap-10 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:items-center",
			story.reverse && "lg:[&>div:first-child]:order-2 lg:[&>div:last-child]:order-1",
		]}
		>
		<div class="relative">
			<FeatureScene variant={story.scene} />
		</div>
		<div class="max-w-2xl">
			<SectionIntro
				description={story.description}
				eyebrow={story.eyebrow}
				title={story.title}
			/>
			<ul class="mt-8 grid gap-4">
				{
					story.highlights.map((highlight) => (
						<li class="marketing-panel rounded-[1.6rem] border border-slate-200 bg-white/[0.88] p-5">
							<div class="flex items-start gap-4">
								<div class="rounded-2xl bg-slate-950 p-2 text-white">
									<MarketingIcon className="h-5 w-5" name={highlight.icon} />
								</div>
								<div>
									<h3 class="text-base font-semibold text-slate-950">{highlight.title}</h3>
									<p class="mt-2 text-sm leading-6 text-slate-600">{highlight.body}</p>
								</div>
							</div>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>
