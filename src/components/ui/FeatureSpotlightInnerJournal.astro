---
import {
	FEATURE_SPOTLIGHT_BIG_D,
	FEATURE_SPOTLIGHT_GLYPH_PATHS,
	FEATURE_SPOTLIGHT_INNER_G_TRANSFORM,
} from './featureSpotlightIconData';

interface Props {
	instanceId: string;
}

const { instanceId } = Astro.props as Props;
const g = (suffix: string) => `url(#spotlight-${instanceId}-${suffix})`;
const BIG = FEATURE_SPOTLIGHT_BIG_D;
const TF = FEATURE_SPOTLIGHT_INNER_G_TRANSFORM;
const [lockD] = FEATURE_SPOTLIGHT_GLYPH_PATHS.journal;
---

<path d={BIG} fill={g('p2')} fill-opacity="0.81"></path>
<path d={BIG} fill={g('p3')} fill-opacity="0.02"></path>
<g transform={TF} opacity="0.78">
	<rect width="24" height="24" fill={g('p4')} fill-opacity="0.81"></rect>
	<rect width="24" height="24" fill={g('p5')} fill-opacity="0.02"></rect>
	<path d={lockD} fill={g('p6')}></path>
	<path d={lockD} fill={g('p7')}></path>
</g>
