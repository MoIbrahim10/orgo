---
interface Props {
	align?: "center" | "start";
	class?: string;
	description?: string;
	eyebrow?: string;
	title: string;
	titleTag?: "h1" | "h2" | "h3";
}

const {
	align = "start",
	class: className,
	description,
	eyebrow,
	title,
	titleTag = "h2",
} = Astro.props as Props;

const Tag = titleTag;
---

<div
	class:list={[
		"flex flex-col gap-4",
		align === "center" ? "mx-auto max-w-3xl items-center text-center" : "max-w-3xl items-start",
		className,
	]}
>
	{eyebrow && <p class="marketing-eyebrow">{eyebrow}</p>}
	<Tag class="font-display text-4xl font-semibold tracking-tight text-slate-950 sm:text-[2.7rem] sm:leading-[1.08]">
		{title}
	</Tag>
	{description && <p class="text-lg leading-8 text-slate-600">{description}</p>}
</div>
