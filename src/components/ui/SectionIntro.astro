---
import MarketingEyebrow from "./MarketingEyebrow.astro";

interface Props {
	align?: "center" | "start";
	class?: string;
	description?: string;
	eyebrow?: string;
	size?: "default" | "display";
	title: string;
	titleTag?: "h1" | "h2" | "h3";
	tone?: "default" | "inverse";
}

const {
	align = "start",
	class: className,
	description,
	eyebrow,
	size = "default",
	title,
	titleTag = "h2",
	tone = "default",
} = Astro.props as Props;

const Tag = titleTag;
const isInverse = tone === "inverse";
---

<div
	class:list={[
		"flex flex-col gap-4",
		align === "center" ? "mx-auto max-w-3xl items-center text-center" : "max-w-3xl items-start",
		className,
	]}
>
	{eyebrow && <MarketingEyebrow inverse={isInverse}>{eyebrow}</MarketingEyebrow>}
	<Tag
		class:list={[
			"font-display font-semibold tracking-tight sm:leading-[1.08]",
			size === "display" ? "text-5xl sm:text-6xl" : "text-4xl sm:text-[2.7rem]",
			isInverse ? "text-white" : "text-slate-950",
		]}
	>
		{title}
	</Tag>
	{description && (
		<p class:list={["text-lg leading-8", isInverse ? "text-slate-300" : "text-slate-600"]}>
			{description}
		</p>
	)}
</div>
