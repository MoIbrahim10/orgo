---
interface Props {
	class?: string;
	size?: "article" | "narrow" | "page" | "wide";
}

const { class: className, size = "wide" } = Astro.props as Props;

const sizes = {
	article: "max-w-3xl",
	narrow: "max-w-4xl",
	page: "max-w-5xl",
	wide: "max-w-6xl",
} as const;
---

<div class:list={["mx-auto w-full px-6", sizes[size], className]}>
	<slot />
</div>
