---
interface Props {
	block?: boolean;
	class?: string;
	href: string;
	size?: "lg" | "md" | "sm";
	variant?: "ghost" | "inverted" | "primary" | "secondary" | "subtle";
	[x: string]: unknown;
}

const {
	block = false,
	class: className,
	href,
	size = "md",
	variant = "primary",
	...rest
} = Astro.props as Props;

const sizeClasses = {
	lg: "action-link--lg",
	md: "action-link--md",
	sm: "action-link--sm",
} as const;

const variantClasses = {
	ghost: "action-link--ghost",
	inverted: "action-link--inverted",
	primary: "action-link--primary",
	secondary: "action-link--secondary",
	subtle: "action-link--subtle",
} as const;
---

<a
	{...rest}
	class:list={[
		"action-link",
		block && "action-link--block",
		sizeClasses[size],
		variantClasses[variant],
		className,
	]}
	href={href}
>
	<slot />
</a>

<style>
	.action-link {
		align-items: center;
		border-radius: var(--control-radius);
		display: inline-flex;
		flex-direction: row;
		font-family: var(--font-ui);
		font-size: var(--control-font-size);
		font-style: normal;
		gap: 0.5rem;
		justify-content: center;
		line-height: 1.25;
		min-height: 2.625rem;
		outline: none;
		text-decoration: none;
		transition:
			background-color var(--control-transition),
			border-color var(--control-transition),
			box-shadow var(--control-transition),
			color var(--control-transition),
			opacity var(--control-transition),
			transform var(--control-transition);
	}

	.action-link--block {
		width: 100%;
	}

	.action-link--sm {
		padding: 0.625rem 1rem;
	}

	.action-link--md {
		padding: 0.6875rem 1.125rem;
	}

	.action-link--lg {
		padding: 0.875rem 1.5rem;
	}

	.action-link--primary {
		background: var(--action-link-primary-bg);
		box-shadow: var(--action-link-primary-shadow);
		color: var(--action-link-primary-text);
		font-weight: 600;
	}

	.action-link--secondary {
		background: var(--action-link-secondary-bg);
		box-shadow: var(--action-link-secondary-shadow);
		color: var(--action-link-secondary-text);
		font-weight: var(--control-font-weight);
	}

	.action-link--ghost {
		background: transparent;
		color: var(--page-text-soft);
		font-weight: var(--control-font-weight);
	}

	.action-link--inverted {
		background: var(--action-link-inverted-bg);
		color: var(--action-link-inverted-text);
		font-weight: var(--control-font-weight);
	}

	.action-link--subtle {
		background: var(--action-link-subtle-bg);
		color: var(--action-link-subtle-text);
		font-weight: var(--control-font-weight);
	}

	.action-link--primary:hover {
		box-shadow: var(--action-link-primary-shadow-hover);
		transform: translateY(-1px);
	}

	.action-link--secondary:hover {
		box-shadow: var(--action-link-secondary-shadow-hover);
		transform: translateY(-1px);
	}

	.action-link--ghost:hover {
		color: var(--page-text-strong);
	}

	.action-link--inverted:hover {
		background: var(--action-link-inverted-bg-hover);
	}

	.action-link--subtle:hover {
		background: var(--action-link-subtle-bg-hover);
		color: var(--page-text-strong);
	}

	.action-link:active {
		transform: translateY(0) scale(0.99);
	}

	.action-link:focus-visible {
		box-shadow:
			0 0 0 2px var(--page-bg),
			0 0 0 4px var(--focus-ring-color);
	}

	@media (prefers-reduced-motion: reduce) {
		.action-link {
			transition: none;
		}
	}
</style>
