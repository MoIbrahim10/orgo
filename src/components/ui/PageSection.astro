---
import type { HTMLTag } from "astro/types";
import Container from "./Container.astro";

interface Props {
	as?: HTMLTag;
	id?: string;
	size?: "article" | "narrow" | "navbar" | "page" | "site" | "wide";
	tone?: "default" | "soft" | "contrast" | "transparent" | "warm";
	layout?: "default" | "split";
	surface?: "none" | "panel";
	backdrop?: "none" | "grid" | "glow";
	asideSticky?: boolean;
	class?: string;
	containerClass?: string;
}

const {
	as = "section",
	asideSticky = true,
	backdrop = "none",
	class: className = "",
	containerClass = "",
	id,
	layout = "default",
	size = "page",
	surface = "none",
	tone = "default",
} = Astro.props as Props;

const SectionTag = as;
const hasIntroSlot = Astro.slots.has("intro");
const hasAsideSlot = Astro.slots.has("aside");
const toneClasses = {
	default: "bg-transparent",
	soft: "bg-linear-to-b from-[var(--page-surface-muted)] to-[var(--page-bg)]",
	contrast: "bg-[var(--page-surface-strong)] text-white",
	transparent: "bg-transparent",
	warm:
		"bg-linear-to-br from-[color-mix(in_srgb,var(--page-surface-muted)_88%,var(--page-bg))] via-[var(--page-bg)] to-[color-mix(in_srgb,var(--page-surface-muted)_75%,var(--page-bg))]",
} satisfies Record<NonNullable<Props["tone"]>, string>;
const surfaceClasses = {
	none: "",
	panel:
		"relative overflow-hidden rounded-[var(--feature-spotlight-card-radius)] border border-[var(--page-border)] bg-[color-mix(in_srgb,var(--page-surface-solid)_92%,transparent)] p-6 shadow-[var(--theme-shadow-panel)] sm:p-8",
} satisfies Record<NonNullable<Props["surface"]>, string>;
const backdropClasses = {
	none: "",
	grid: "before:absolute before:inset-0 before:bg-[radial-gradient(circle_at_top_left,color-mix(in_srgb,var(--page-border)_65%,transparent),transparent_32%),linear-gradient(color-mix(in_srgb,var(--page-border)_55%,transparent)_1px,transparent_1px),linear-gradient(90deg,color-mix(in_srgb,var(--page-border)_55%,transparent)_1px,transparent_1px)] before:bg-[size:auto,2rem_2rem,2rem_2rem] before:opacity-60 before:content-['']",
	glow: "before:absolute before:inset-x-8 before:top-0 before:h-40 before:rounded-full before:bg-linear-to-r before:from-[color-mix(in_srgb,var(--action-link-primary-gradient-start)_28%,transparent)] before:via-[color-mix(in_srgb,var(--action-link-primary-gradient-middle)_22%,transparent)] before:to-[color-mix(in_srgb,var(--action-link-primary-gradient-end)_24%,transparent)] before:blur-3xl before:content-['']",
} satisfies Record<NonNullable<Props["backdrop"]>, string>;
const layoutClasses = {
	default: "",
	split: "grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,0.36fr)] lg:items-start",
} satisfies Record<NonNullable<Props["layout"]>, string>;
---

<SectionTag class:list={["scroll-mt-28", toneClasses[tone], className]} {...(id ? { id } : {})}>
	<Container class={containerClass} size={size}>
		<div class:list={["relative", surfaceClasses[surface], backdropClasses[backdrop]]}>
			<div class="relative">
				{hasIntroSlot && <div class="mb-10"><slot name="intro" /></div>}
				{
					layout === "split" && hasAsideSlot ? (
						<div class={layoutClasses.split}>
							<div>
								<slot />
							</div>
							<aside class:list={[asideSticky && "lg:sticky lg:top-28"]}>
								<slot name="aside" />
							</aside>
						</div>
					) : (
						<slot />
					)
				}
			</div>
		</div>
	</Container>
</SectionTag>
