---
/**
 * Orgo team avatars — unified “monoline family”: same frame, face, and badge grid;
 * only hair + role glyph differ. One brand accent bar per portrait (organized, not noisy).
 */
interface Props {
	personId: string;
	class?: string;
}

const { personId, class: className = "" } = Astro.props as Props;
---

<div class:list={["person-doodle", className]} aria-hidden="true">
	{
		personId === "jane-doe" && (
			<svg class="person-doodle__svg" viewBox="0 0 128 128" fill="none" xmlns="http://www.w3.org/2000/svg">
				<defs>
					<linearGradient id="orgo-badge-jane" x1="32" y1="120" x2="96" y2="120" gradientUnits="userSpaceOnUse">
						<stop stop-color="#e98426" />
						<stop offset="0.5" stop-color="#d64988" />
						<stop offset="1" stop-color="#5b0ac1" />
					</linearGradient>
				</defs>
				<!-- Artboard: same on all portraits -->
				<circle cx="64" cy="64" r="58" stroke="currentColor" stroke-opacity="0.14" stroke-width="1.25" />
				<circle cx="64" cy="64" r="52" stroke="currentColor" stroke-opacity="0.06" stroke-width="1" />
				<!-- Hair: editorial wave -->
				<path
					d="M40 40c6-12 18-18 34-16 12 1 20 8 24 18"
					stroke="currentColor"
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
				/>
				<!-- Face: shared proportions -->
				<ellipse cx="64" cy="56" rx="21" ry="25" stroke="currentColor" stroke-width="2" />
				<circle cx="54.5" cy="54" r="2.5" fill="currentColor" />
				<circle cx="73.5" cy="54" r="2.5" fill="currentColor" />
				<path
					d="M54 66c6 8 16 8 22 0"
					stroke="currentColor"
					stroke-linecap="round"
					stroke-width="1.75"
				/>
				<!-- Shoulders -->
				<path
					d="M38 78c8-4 16-6 26-6s18 2 26 6"
					stroke="currentColor"
					stroke-linecap="round"
					stroke-opacity="0.45"
					stroke-width="1.5"
				/>
				<!-- Badge plate (identical frame) -->
				<rect
					height="34"
					rx="10"
					stroke="currentColor"
					stroke-opacity="0.35"
					stroke-width="1.5"
					width="72"
					x="28"
					y="84"
				/>
				<!-- Role: story / list lines -->
				<path
					d="M40 96h40M40 102h32M40 108h36"
					stroke="currentColor"
					stroke-linecap="round"
					stroke-opacity="0.55"
					stroke-width="1.5"
				/>
				<!-- Brand accent: one bar only (matches other portraits) -->
				<path d="M36 118h56" stroke="url(#orgo-badge-jane)" stroke-linecap="round" stroke-width="3" />
			</svg>
		)
	}
	{
		personId === "john-doe" && (
			<svg class="person-doodle__svg" viewBox="0 0 128 128" fill="none" xmlns="http://www.w3.org/2000/svg">
				<defs>
					<linearGradient id="orgo-badge-john" x1="32" y1="120" x2="96" y2="120" gradientUnits="userSpaceOnUse">
						<stop stop-color="#e98426" />
						<stop offset="0.5" stop-color="#d64988" />
						<stop offset="1" stop-color="#5b0ac1" />
					</linearGradient>
				</defs>
				<circle cx="64" cy="64" r="58" stroke="currentColor" stroke-opacity="0.14" stroke-width="1.25" />
				<circle cx="64" cy="64" r="52" stroke="currentColor" stroke-opacity="0.06" stroke-width="1" />
				<path
					d="M42 38h44M44 34c8-4 18-4 28 0"
					stroke="currentColor"
					stroke-linecap="round"
					stroke-width="2"
				/>
				<ellipse cx="64" cy="56" rx="21" ry="25" stroke="currentColor" stroke-width="2" />
				<!-- Glasses: systems / precision -->
				<circle cx="54.5" cy="54" r="8" stroke="currentColor" stroke-width="1.65" />
				<circle cx="73.5" cy="54" r="8" stroke="currentColor" stroke-width="1.65" />
				<path d="M62.5 54h3" stroke="currentColor" stroke-linecap="round" stroke-width="1.5" />
				<circle cx="54.5" cy="54" r="2" fill="currentColor" />
				<circle cx="73.5" cy="54" r="2" fill="currentColor" />
				<path
					d="M54 66c6 8 16 8 22 0"
					stroke="currentColor"
					stroke-linecap="round"
					stroke-width="1.75"
				/>
				<path
					d="M38 78c8-4 16-6 26-6s18 2 26 6"
					stroke="currentColor"
					stroke-linecap="round"
					stroke-opacity="0.45"
					stroke-width="1.5"
				/>
				<rect
					height="34"
					rx="10"
					stroke="currentColor"
					stroke-opacity="0.35"
					stroke-width="1.5"
					width="72"
					x="28"
					y="84"
				/>
				<!-- Role: 2×2 module grid, aligned to 4px grid -->
				<rect height="11" rx="2" stroke="currentColor" stroke-opacity="0.5" stroke-width="1.4" width="11" x="46" y="93" />
				<rect height="11" rx="2" stroke="currentColor" stroke-opacity="0.5" stroke-width="1.4" width="11" x="60" y="93" />
				<rect height="11" rx="2" stroke="url(#orgo-badge-john)" stroke-width="1.75" width="11" x="46" y="105" />
				<rect height="11" rx="2" stroke="currentColor" stroke-opacity="0.5" stroke-width="1.4" width="11" x="60" y="105" />
				<path d="M36 118h56" stroke="url(#orgo-badge-john)" stroke-linecap="round" stroke-width="3" />
			</svg>
		)
	}
	{
		personId === "ahmed-ali" && (
			<svg class="person-doodle__svg" viewBox="0 0 128 128" fill="none" xmlns="http://www.w3.org/2000/svg">
				<defs>
					<linearGradient id="orgo-badge-ahmed" x1="32" y1="120" x2="96" y2="120" gradientUnits="userSpaceOnUse">
						<stop stop-color="#e98426" />
						<stop offset="0.5" stop-color="#d64988" />
						<stop offset="1" stop-color="#5b0ac1" />
					</linearGradient>
				</defs>
				<circle cx="64" cy="64" r="58" stroke="currentColor" stroke-opacity="0.14" stroke-width="1.25" />
				<circle cx="64" cy="64" r="52" stroke="currentColor" stroke-opacity="0.06" stroke-width="1" />
				<path
					d="M42 40c10-10 26-12 40-6 10 4 16 12 18 22"
					stroke="currentColor"
					stroke-linecap="round"
					stroke-width="2"
				/>
				<ellipse cx="64" cy="56" rx="21" ry="25" stroke="currentColor" stroke-width="2" />
				<circle cx="54.5" cy="54" r="2.5" fill="currentColor" />
				<circle cx="73.5" cy="54" r="2.5" fill="currentColor" />
				<path
					d="M54 66c6 8 16 8 22 0"
					stroke="currentColor"
					stroke-linecap="round"
					stroke-width="1.75"
				/>
				<path
					d="M50 72c4 6 12 10 20 10s16-4 20-10"
					stroke="currentColor"
					stroke-linecap="round"
					stroke-opacity="0.35"
					stroke-width="1.25"
				/>
				<path
					d="M38 78c8-4 16-6 26-6s18 2 26 6"
					stroke="currentColor"
					stroke-linecap="round"
					stroke-opacity="0.45"
					stroke-width="1.5"
				/>
				<rect
					height="34"
					rx="10"
					stroke="currentColor"
					stroke-opacity="0.35"
					stroke-width="1.5"
					width="72"
					x="28"
					y="84"
				/>
				<!-- Role: link / two locales -->
				<circle cx="52" cy="101" r="5" stroke="currentColor" stroke-opacity="0.5" stroke-width="1.4" />
				<circle cx="76" cy="101" r="5" stroke="currentColor" stroke-opacity="0.5" stroke-width="1.4" />
				<path d="M57 101h14" stroke="url(#orgo-badge-ahmed)" stroke-linecap="round" stroke-width="2" />
				<path d="M36 118h56" stroke="url(#orgo-badge-ahmed)" stroke-linecap="round" stroke-width="3" />
			</svg>
		)
	}
	{
		personId !== "jane-doe" && personId !== "john-doe" && personId !== "ahmed-ali" && (
			<svg class="person-doodle__svg" viewBox="0 0 128 128" fill="none" xmlns="http://www.w3.org/2000/svg">
				<circle cx="64" cy="64" r="58" stroke="currentColor" stroke-opacity="0.14" stroke-width="1.25" />
				<ellipse cx="64" cy="56" rx="21" ry="25" stroke="currentColor" stroke-width="2" />
				<circle cx="54.5" cy="54" r="2.5" fill="currentColor" />
				<circle cx="73.5" cy="54" r="2.5" fill="currentColor" />
				<path d="M54 66c6 8 16 8 22 0" stroke="currentColor" stroke-linecap="round" stroke-width="1.75" />
			</svg>
		)
	}
</div>

<style>
	.person-doodle {
		color: color-mix(in srgb, var(--foreground-primary) 88%, var(--foreground-tertiary));
		display: grid;
		height: 100%;
		place-items: center;
		width: 100%;
	}

	.person-doodle__svg {
		display: block;
		height: auto;
		max-height: 8rem;
		width: 8rem;
	}
</style>
