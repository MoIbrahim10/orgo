{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc", "react"],
	"categories": {
		"correctness": "error"
	},
	"rules": {},
	"env": {
		"builtin": true,
		"browser": true
	},
	"ignorePatterns": [".astro"],
	"overrides": [
		{
			"files": ["**/checkTranslations.ts"],
			"rules": {
				"eslint/no-console": "off"
			}
		}
	]
}
